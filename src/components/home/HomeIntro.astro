---
import type { Lang } from '../../data/i18n';
import AmbientBackground from '../AmbientBackground.astro';

interface Props {
  lang: Lang;
}

// Bloque de texto con el <h1> de la home, justo debajo del hero. El título animado
// del hero ("Arango Dental Clinic") es la marca y no es un <h1>: así la página tiene
// un único H1 con la palabra que la gente busca, sin tocar el diseño del hero.
const { lang } = Astro.props;

const t = {
  es: {
    kicker: 'Arango Dental Clinic',
    h1: 'Dentista en Benidorm',
    p1: 'Arango Dental Clinic es una clínica dental privada en Benidorm, en la Avinguda Alfonso Puchades. Ofrecemos <a href="/implantes/">implantes dentales</a>, <a href="/ortodoncia/">ortodoncia</a>, <a href="/estetica-dental/">estética dental</a>, <a href="/endodoncia/">endodoncia</a>, <a href="/periodoncia/">periodoncia</a>, <a href="/rehabilitacion-oral/">rehabilitación oral</a> y <a href="/odontologia-digital/">odontología digital</a>, con una valoración inicial gratuita para explicarte qué necesitas y qué opciones tienes.',
    p2: 'Atendemos a pacientes de Benidorm y de toda la Marina Baixa, tanto residentes como visitantes, y trabajamos con tecnología digital, como el escáner intraoral 3D y la radiografía digital, para planificar cada tratamiento con detalle.',
    p3: 'La clínica está dirigida por el Dr. Sebastián Arango, especialista en implantología y rehabilitación oral. Puedes <a href="/nosotros/">conocer al equipo</a> o ver <a href="/servicios/">todos nuestros tratamientos</a>.',
    ctaPrimary: 'Pedir valoración gratuita',
    ctaPrimaryHref: '/contacto/#contact-form',
    ctaSecondary: 'Escríbenos por WhatsApp',
    whatsappHref: 'https://wa.me/34665886439',
  },
  en: {
    kicker: 'Arango Dental Clinic',
    h1: 'Dentist in Benidorm',
    p1: 'Arango Dental Clinic is a private dental clinic in Benidorm, on Avinguda Alfonso Puchades. We offer <a href="/en/dental-implants/">dental implants</a>, <a href="/en/orthodontics/">orthodontics</a>, <a href="/en/cosmetic-dentistry/">cosmetic dentistry</a>, <a href="/en/root-canal-treatment/">root canal treatment</a>, <a href="/en/gum-treatment/">gum disease treatment</a>, <a href="/en/oral-rehabilitation/">oral rehabilitation</a> and <a href="/en/digital-dentistry/">digital dentistry</a>, with a free initial assessment to explain what you need and what your options are.',
    p2: 'We see patients from Benidorm and the whole Marina Baixa area, both residents and visitors, and we work with digital technology, such as 3D intraoral scanning and digital X-rays, to plan every treatment in detail.',
    p3: 'The clinic is led by Dr. Sebastián Arango, a specialist in implantology and oral rehabilitation. You can <a href="/en/about-us/">meet the team</a> or see <a href="/en/services/">all of our treatments</a>.',
    ctaPrimary: 'Book a free assessment',
    ctaPrimaryHref: '/en/contact/#contact-form',
    ctaSecondary: 'Message us on WhatsApp',
    whatsappHref: 'https://wa.me/34665886439?text=' + encodeURIComponent("Hello, I'd like to book a free assessment at Arango Dental Clinic"),
  },
}[lang];
---

<section class="hm-intro amb-host" aria-labelledby="hm-intro-title">
  <AmbientBackground intensity="strong" tone="forest" variant="a" />
  <div class="hm-intro-inner" data-reveal-group>
    <p class="hm-kicker" data-reveal-item>{t.kicker}</p>
    <h1 class="hm-intro-title" id="hm-intro-title" data-reveal-item>{t.h1}</h1>
    <p class="hm-lead" set:html={t.p1} data-reveal-item />
    <p set:html={t.p2} data-reveal-item />
    <p set:html={t.p3} data-reveal-item />
    <div class="hm-intro-actions" data-reveal-item>
      <a href={t.ctaPrimaryHref} class="hm-btn hm-btn-solid">{t.ctaPrimary}</a>
      <a href={t.whatsappHref} target="_blank" rel="noopener noreferrer" class="hm-btn hm-btn-outline">{t.ctaSecondary}</a>
    </div>
  </div>
</section>

<style>
  .hm-intro {
    background-color: var(--bg-primary);
    padding: 5rem 1.25rem 4.5rem;
  }

  @media (min-width: 1024px) {
    .hm-intro {
      padding: 7rem 5rem 6rem;
    }
  }

  .hm-intro-inner {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }

  .hm-kicker {
    font-family: "Inter", sans-serif;
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold-600);
    margin: 0 0 1rem;
  }

  .hm-intro-title {
    font-family: "Cormorant Garamond", serif;
    font-size: clamp(2.4rem, 5.5vw, 4rem);
    font-weight: 300;
    line-height: 1.1;
    color: var(--text-primary);
    margin: 0 0 2rem;
    text-wrap: balance;
  }

  .hm-intro-inner p {
    font-family: "Inter", sans-serif;
    font-size: 1rem;
    line-height: 1.85;
    color: var(--text-secondary);
    margin: 0 0 1.25rem;
  }

  .hm-intro-inner p.hm-lead {
    font-size: 1.1rem;
    color: var(--text-primary);
  }

  /* Solo los enlaces dentro de los párrafos: los botones (.hm-btn) no son parte del texto. */
  .hm-intro-inner p :global(a) {
    color: var(--teal-600);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Hover del enlace: verde más oscuro en tema claro, dorado en oscuro. */
  .hm-intro-inner p :global(a:hover) {
    color: var(--teal-700);
  }

  :global(html.dark) .hm-intro-inner p :global(a:hover) {
    color: var(--gold-600);
  }

  .hm-intro-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hm-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: "Inter", sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.95rem 1.75rem;
    transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }

  .hm-btn-solid {
    background-color: #1c1b1b;
    color: #ffffff;
    border: 1px solid #1c1b1b;
  }

  .hm-btn-solid:hover {
    background-color: transparent;
    color: #1c1b1b;
  }

  .hm-btn-outline {
    background-color: transparent;
    color: #1c1b1b;
    border: 1px solid rgba(28, 27, 27, 0.65);
  }

  .hm-btn-outline:hover {
    background-color: #1c1b1b;
    color: #ffffff;
  }

  :global(html.dark) .hm-btn-solid {
    background-color: #D4AF55;
    color: #141210;
    border-color: #D4AF55;
  }

  :global(html.dark) .hm-btn-solid:hover {
    background-color: transparent;
    color: rgba(244, 240, 235, 0.85);
    border-color: rgba(244, 240, 235, 0.3);
  }

  :global(html.dark) .hm-btn-outline {
    color: rgba(244, 240, 235, 0.85);
    border-color: rgba(244, 240, 235, 0.3);
  }

  :global(html.dark) .hm-btn-outline:hover {
    background-color: #D4AF55;
    color: #141210;
    border-color: #D4AF55;
  }

  @media (max-width: 640px) {
    .hm-btn {
      width: 100%;
    }
  }
</style>
