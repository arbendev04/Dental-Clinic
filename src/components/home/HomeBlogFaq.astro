---
import { Image } from 'astro:assets';
import type { Lang } from '../../data/i18n';
import AmbientBackground from '../AmbientBackground.astro';
import { getPosts, postPath, formatDate, readingMinutes, SERVICE_INFO, blogBasePath } from '../../data/blog';

interface Props {
  lang: Lang;
}

// Últimos artículos del blog (enlazado interno desde la página más fuerte del sitio)
// y preguntas frecuentes con su schema FAQPage. Solo datos confirmados por la clínica.
const { lang } = Astro.props;
const posts = (await getPosts(lang)).slice(0, 3);

const t = {
  es: {
    blogLabel: 'Blog',
    blogTitle: 'Salud dental, explicada con claridad',
    blogAll: 'Ver todos los artículos',
    minutes: 'min de lectura',
    faqLabel: 'Preguntas frecuentes',
    faqTitle: 'Antes de pedir tu cita',
    faqs: [
      {
        q: '¿Cuánto cuesta la primera visita?',
        text: 'La valoración inicial es gratuita y sin compromiso. En ella revisamos tu caso y te explicamos las opciones que tienes.',
        html: 'La valoración inicial es gratuita y sin compromiso. En ella revisamos tu caso y te explicamos las opciones que tienes.',
      },
      {
        q: '¿Cuánto cuesta un tratamiento?',
        text: 'Depende de cada caso. Después de la valoración inicial gratuita te explicamos qué necesitas y te damos un presupuesto, para que sepas qué vas a pagar antes de decidir nada.',
        html: 'Depende de cada caso. Después de la valoración inicial gratuita te explicamos qué necesitas y te damos un presupuesto, para que sepas qué vas a pagar antes de decidir nada.',
      },
      {
        q: '¿Qué tecnología usáis para el diagnóstico?',
        text: 'Trabajamos con odontología digital: escáner intraoral 3D y radiografía digital, que nos ayudan a diagnosticar y a planificar cada tratamiento con detalle.',
        html: 'Trabajamos con <a href="/odontologia-digital/">odontología digital</a>: escáner intraoral 3D y radiografía digital, que nos ayudan a diagnosticar y a planificar cada tratamiento con detalle.',
      },
      {
        q: '¿Trabajáis con seguros dentales?',
        text: 'No. La atención es privada. En la valoración inicial gratuita te damos un presupuesto de lo que necesitas.',
        html: 'No. La atención es privada. En la valoración inicial gratuita te damos un presupuesto de lo que necesitas.',
      },
      {
        q: '¿Qué tratamientos ofrecéis?',
        text: 'Implantes dentales, ortodoncia, estética dental, endodoncia, periodoncia, rehabilitación oral y odontología digital.',
        html: '<a href="/implantes/">Implantes dentales</a>, <a href="/ortodoncia/">ortodoncia</a>, <a href="/estetica-dental/">estética dental</a>, <a href="/endodoncia/">endodoncia</a>, <a href="/periodoncia/">periodoncia</a>, <a href="/rehabilitacion-oral/">rehabilitación oral</a> y <a href="/odontologia-digital/">odontología digital</a>.',
      },
      {
        q: '¿Dónde está la clínica y cuál es el horario?',
        text: 'Estamos en la Avinguda Alfonso Puchades, 22, bajo, en Benidorm (Alicante). Abrimos de lunes a jueves de 10:00 a 14:00 y de 15:00 a 19:00, y los viernes de 10:00 a 14:00.',
        html: 'Estamos en la Avinguda Alfonso Puchades, 22, bajo, en Benidorm (Alicante). Abrimos de lunes a jueves de 10:00 a 14:00 y de 15:00 a 19:00, y los viernes de 10:00 a 14:00. Puedes <a href="/contacto/">escribirnos o llamarnos</a> para pedir cita.',
      },
    ],
  },
  en: {
    blogLabel: 'Blog',
    blogTitle: 'Dental health, clearly explained',
    blogAll: 'See all articles',
    minutes: 'min read',
    faqLabel: 'Frequently asked questions',
    faqTitle: 'Before you book',
    faqs: [
      {
        q: 'How much is the first visit?',
        text: 'The initial assessment is free of charge and without obligation. We review your case and explain your options.',
        html: 'The initial assessment is free of charge and without obligation. We review your case and explain your options.',
      },
      {
        q: 'How much does a treatment cost?',
        text: 'It depends on each case. After the free initial assessment we explain what you need and give you a quote, so you know what you will pay before you decide anything.',
        html: 'It depends on each case. After the free initial assessment we explain what you need and give you a quote, so you know what you will pay before you decide anything.',
      },
      {
        q: 'What technology do you use for diagnosis?',
        text: 'We work with digital dentistry: 3D intraoral scanning and digital X-rays, which help us diagnose and plan every treatment in detail.',
        html: 'We work with <a href="/en/digital-dentistry/">digital dentistry</a>: 3D intraoral scanning and digital X-rays, which help us diagnose and plan every treatment in detail.',
      },
      {
        q: 'Do you work with dental insurance?',
        text: 'No. Care is private. At the free initial assessment we give you a quote for what you need.',
        html: 'No. Care is private. At the free initial assessment we give you a quote for what you need.',
      },
      {
        q: 'Which treatments do you offer?',
        text: 'Dental implants, orthodontics, cosmetic dentistry, root canal treatment, gum disease treatment, oral rehabilitation and digital dentistry.',
        html: '<a href="/en/dental-implants/">Dental implants</a>, <a href="/en/orthodontics/">orthodontics</a>, <a href="/en/cosmetic-dentistry/">cosmetic dentistry</a>, <a href="/en/root-canal-treatment/">root canal treatment</a>, <a href="/en/gum-treatment/">gum disease treatment</a>, <a href="/en/oral-rehabilitation/">oral rehabilitation</a> and <a href="/en/digital-dentistry/">digital dentistry</a>.',
      },
      {
        q: 'Where is the clinic and what are the opening hours?',
        text: 'We are at Avinguda Alfonso Puchades, 22, bajo, in Benidorm (Alicante). We are open Monday to Thursday from 10:00 to 14:00 and from 15:00 to 19:00, and on Fridays from 10:00 to 14:00.',
        html: 'We are at Avinguda Alfonso Puchades, 22, bajo, in Benidorm (Alicante). We are open Monday to Thursday from 10:00 to 14:00 and from 15:00 to 19:00, and on Fridays from 10:00 to 14:00. You can <a href="/en/contact/">message or call us</a> to book.',
      },
    ],
  },
}[lang];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: lang,
  mainEntity: t.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.text },
  })),
};
---

{posts.length > 0 && (
  <section class="hb-blog" aria-labelledby="hb-blog-title">
    <div class="hb-container">
      <div class="hb-head" data-reveal-group>
        <p class="hb-label" data-reveal-item>{t.blogLabel}</p>
        <h2 class="hb-title" id="hb-blog-title" data-reveal-item>{t.blogTitle}</h2>
      </div>
      <ul class="hb-posts" data-reveal-group>
        {posts.map((post) => (
          <li class="hb-post" data-reveal-item>
            <article>
              {post.data.image && (
                <a class="hb-post-media" href={postPath(post)} tabindex="-1" aria-hidden="true" data-reveal-mask>
                  <Image
                    src={post.data.image}
                    alt=""
                    width={640}
                    height={336}
                    widths={[400, 640]}
                    sizes="(min-width: 900px) 340px, 100vw"
                    fit="cover"
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              )}
              <div class="hb-post-body">
                <p class="hb-post-meta">
                  {`${SERVICE_INFO[post.data.service][lang].label} · ${readingMinutes(post.body)} ${t.minutes}`}
                </p>
                <h3 class="hb-post-title"><a href={postPath(post)}>{post.data.title}</a></h3>
                <time class="hb-post-date" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time>
              </div>
            </article>
          </li>
        ))}
      </ul>
      <p class="hb-all" data-reveal><a href={blogBasePath(lang)}>{t.blogAll} →</a></p>
    </div>
  </section>
)}

<section class="hb-faq amb-host" aria-labelledby="hb-faq-title">
  <AmbientBackground intensity="soft" tone="neutral" variant="c" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="hb-container hb-faq-container">
    <div class="hb-head" data-reveal-group>
      <p class="hb-label" data-reveal-item>{t.faqLabel}</p>
      <h2 class="hb-title" id="hb-faq-title" data-reveal-item>{t.faqTitle}</h2>
    </div>
    <div class="hb-faq-list" data-reveal-group>
      {t.faqs.map((f) => (
        <details class="hb-faq-item" data-reveal-item>
          <summary class="hb-faq-q">{f.q}</summary>
          <p class="hb-faq-a" set:html={f.html} />
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .hb-container {
    max-width: 1100px;
    margin: 0 auto;
  }

  /* Acento de bordes y detalles: verde en tema claro, dorado en oscuro
     (las etiquetas pequeñas se quedan doradas, como en el resto de la home). */
  .hb-blog,
  .hb-faq {
    --hb-accent: var(--teal-500);
  }

  :global(html.dark) .hb-blog,
  :global(html.dark) .hb-faq {
    --hb-accent: var(--gold-500);
  }

  .hb-blog {
    background-color: var(--bg-primary);
    padding: 4.5rem 1.25rem;
  }

  .hb-faq {
    background-color: var(--bg-secondary);
    padding: 4.5rem 1.25rem;
  }

  @media (min-width: 1024px) {
    .hb-blog,
    .hb-faq {
      padding: 6rem 5rem;
    }
  }

  .hb-head {
    text-align: center;
    margin-bottom: 2.75rem;
  }

  .hb-label {
    font-family: "Inter", sans-serif;
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold-600);
    margin: 0 0 1rem;
  }

  .hb-title {
    font-family: "Cormorant Garamond", serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 400;
    line-height: 1.15;
    color: var(--text-primary);
    margin: 0;
    text-wrap: balance;
  }

  /* ── Artículos ── */
  .hb-posts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 900px) {
    .hb-posts {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .hb-post {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-primary);
    transition:
      border-color 0.3s ease,
      background-color 0.3s ease,
      transform 450ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .hb-post:hover,
  .hb-post:focus-within {
    border-color: var(--hb-accent);
    background-color: var(--bg-tertiary);
  }

  /* Hover sutil: la tarjeta se eleva apenas y la imagen se acerca muy despacio. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .hb-post:hover {
      transform: translateY(-3px);
    }

    .hb-post-media :global(img) {
      transition: transform 900ms cubic-bezier(0.22, 0.61, 0.36, 1);
    }

    .hb-post:hover .hb-post-media :global(img) {
      transform: scale(1.03);
    }
  }

  .hb-post article {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .hb-post-media {
    display: block;
    aspect-ratio: 640 / 336;
    overflow: hidden;
    background-color: var(--bg-tertiary);
  }

  .hb-post-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hb-post-body {
    padding: 1.4rem 1.4rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }

  .hb-post-meta {
    font-family: "Inter", sans-serif;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-600);
    margin: 0;
  }

  .hb-post-title {
    font-family: "Cormorant Garamond", serif;
    font-size: 1.4rem;
    font-weight: 500;
    line-height: 1.3;
    margin: 0;
    text-wrap: balance;
  }

  .hb-post-title a {
    color: var(--text-primary);
    text-decoration: none;
  }

  .hb-post-title a:hover {
    color: var(--teal-600);
  }

  .hb-post-date {
    font-family: "Inter", sans-serif;
    font-size: 0.75rem;
    color: var(--text-tertiary);
    margin-top: auto;
  }

  .hb-all {
    text-align: center;
    margin: 2rem 0 0;
    font-family: "Inter", sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hb-all a {
    color: var(--teal-600);
    text-decoration: none;
  }

  .hb-all a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* ── Preguntas frecuentes ── */
  .hb-faq-container {
    max-width: 800px;
  }

  .hb-faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .hb-faq-item {
    background-color: var(--bg-primary);
    border: 1px solid var(--border-primary);
    border-left: 3px solid var(--border-primary);
    transition: border-color 0.3s ease;
  }

  .hb-faq-item[open] {
    border-left-color: var(--hb-accent);
  }

  .hb-faq-q {
    list-style: none;
    cursor: pointer;
    padding: 1.15rem 3rem 1.15rem 1.4rem;
    position: relative;
    font-family: "Cormorant Garamond", serif;
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--text-primary);
  }

  .hb-faq-q::-webkit-details-marker {
    display: none;
  }

  .hb-faq-q::after {
    content: "+";
    position: absolute;
    right: 1.25rem;
    top: 50%;
    transform: translateY(-50%);
    font-family: "Inter", sans-serif;
    font-size: 1.4rem;
    font-weight: 300;
    color: var(--hb-accent);
    transition: transform 0.3s ease;
  }

  .hb-faq-item[open] .hb-faq-q::after {
    transform: translateY(-50%) rotate(45deg);
  }

  .hb-faq-q:focus-visible {
    outline: 2px solid var(--hb-accent);
    outline-offset: -2px;
  }

  .hb-faq-a {
    font-family: "Inter", sans-serif;
    font-size: 0.95rem;
    line-height: 1.75;
    color: var(--text-secondary);
    margin: 0;
    padding: 0 1.4rem 1.3rem;
  }

  .hb-faq-a :global(a) {
    color: var(--teal-600);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
