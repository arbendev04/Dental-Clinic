---
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import LeadModal from './LeadModal.astro';
import { SITE_URL, CLINIC_ID, type Lang } from '../../data/i18n';
import {
  getPosts,
  postPath,
  postSlug,
  relatedPosts,
  formatDate,
  readingMinutes,
  wordCount,
  SERVICE_INFO,
  SERVICE_CRM_NAME,
  blogBasePath,
  type BlogPost,
} from '../../data/blog';

interface Props {
  lang: Lang;
  post: BlogPost;
}

const { lang, post } = Astro.props;
const { Content, headings } = await render(post);

const DEFAULT_IMAGE = '/img/servicios/servicios.webp';
const cover = post.data.image;
// Imagen para compartir (og:image / schema): JPEG 1200×630, el formato más compatible
// con WhatsApp y redes. Sin portada propia se usa la genérica del sitio.
const image = cover
  ? (await getImage({ src: cover, width: 1200, height: 630, format: 'jpeg', fit: 'cover' })).src
  : DEFAULT_IMAGE;
const service = SERVICE_INFO[post.data.service][lang];
const minutes = readingMinutes(post.body);
const related = relatedPosts(post, await getPosts(lang));
const toc = headings.filter((h) => h.depth === 2);
const published = post.data.pubDate.toISOString();
const modified = (post.data.updatedDate ?? post.data.pubDate).toISOString();
const canonical = SITE_URL + postPath(post);
const blogHref = blogBasePath(lang);
const homeHref = lang === 'en' ? '/en/' : '/';
const contactHref = lang === 'en' ? '/en/contact/' : '/contacto/';

const t = {
  es: {
    home: 'Inicio',
    blog: 'Blog',
    minutes: 'min de lectura',
    updated: 'Actualizado el',
    tocTitle: 'En este artículo',
    crumbAria: 'Ruta de navegación',
    disclaimer: 'Este artículo es informativo y de carácter general: no sustituye una valoración profesional ni un diagnóstico individual. Cada caso es distinto, así que sigue siempre las indicaciones de tu dentista.',
    ctaLabel: 'Valoración inicial gratuita',
    ctaTitle: '¿Quieres que valoremos tu caso?',
    ctaText: `Si te interesa ${service.label.toLowerCase()} o tienes dudas sobre tu salud dental, en Arango Dental Clinic (Benidorm) revisamos tu caso en una valoración inicial gratuita.`,
    ctaService: `Ver ${service.label.toLowerCase()}`,
    ctaContact: 'Pedir cita',
    whatsapp: 'Escríbenos por WhatsApp',
    whatsappText: `Hola, he leído «${post.data.title}» en vuestro blog y quiero pedir una valoración gratuita`,
    sideText: 'Valoración inicial gratuita en Benidorm, sin compromiso.',
    barRequest: 'Pedir valoración',
    barWhatsapp: 'WhatsApp',
    barAria: 'Contacto rápido',
    relatedTitle: 'Sigue leyendo',
    back: 'Volver al blog',
  },
  en: {
    home: 'Home',
    blog: 'Blog',
    minutes: 'min read',
    updated: 'Updated',
    tocTitle: 'In this article',
    crumbAria: 'Breadcrumb',
    disclaimer: 'This article is for general information only and does not replace a professional assessment or an individual diagnosis. Every case is different, so always follow your dentist\'s instructions.',
    ctaLabel: 'Free initial assessment',
    ctaTitle: 'Would you like us to look at your case?',
    ctaText: `If you are interested in ${service.label.toLowerCase()} or have questions about your dental health, Arango Dental Clinic (Benidorm) offers a free initial assessment to review your case.`,
    ctaService: `Learn about ${service.label.toLowerCase()}`,
    ctaContact: 'Book an appointment',
    whatsapp: 'Message us on WhatsApp',
    whatsappText: `Hello, I've read "${post.data.title}" on your blog and I'd like to book a free assessment`,
    sideText: 'Free initial assessment in Benidorm, no obligation.',
    barRequest: 'Book assessment',
    barWhatsapp: 'WhatsApp',
    barAria: 'Quick contact',
    relatedTitle: 'Keep reading',
    back: 'Back to the blog',
  },
}[lang];

const whatsappHref = `https://api.whatsapp.com/send?phone=34665886439&text=${encodeURIComponent(t.whatsappText)}`;

const postSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  image: [SITE_URL + image],
  datePublished: published,
  dateModified: modified,
  inLanguage: lang,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  author: { '@type': 'Organization', '@id': CLINIC_ID, name: 'Arango Dental Clinic', url: SITE_URL },
  publisher: {
    '@type': 'Organization',
    '@id': CLINIC_ID,
    name: 'Arango Dental Clinic',
    url: SITE_URL,
    logo: { '@type': 'ImageObject', url: `${SITE_URL}/img/logo/logo-oscuro.webp` },
  },
  articleSection: service.label,
  keywords: post.data.tags.join(', '),
  wordCount: wordCount(post.body),
};
---

<Layout
  title={post.data.title}
  description={post.data.description}
  image={image}
  ogType="article"
  publishedTime={published}
  modifiedTime={modified}
  breadcrumbTrail={[{ name: t.blog, path: blogHref }]}
>
  <script type="application/ld+json" set:html={JSON.stringify(postSchema)} />

  <section class="bp-hero">
    <div class="bp-container">
      <nav class="bp-crumbs" aria-label={t.crumbAria}>
        <ol>
          <li><a href={homeHref}>{t.home}</a></li>
          <li><a href={blogHref}>{t.blog}</a></li>
        </ol>
      </nav>
      <p class="bp-label"><a href={service.href}>{service.label}</a></p>
      <h1 class="bp-title">{post.data.title}</h1>
      <p class="bp-meta">
        <time datetime={published}>{formatDate(post.data.pubDate, lang)}</time>
        {post.data.updatedDate && (
          <>
            <span aria-hidden="true">·</span>
            <span>{t.updated} <time datetime={modified}>{formatDate(post.data.updatedDate, lang)}</time></span>
          </>
        )}
        <span aria-hidden="true">·</span>
        <span>{minutes} {t.minutes}</span>
      </p>
    </div>
  </section>

  <section class="bp-content-section">
    <div class="bp-container bp-layout">
      <div class="bp-main">
        {cover && (
          <figure class="bp-cover">
            <Image
              src={cover}
              alt={post.data.imageAlt ?? ''}
              width={1200}
              height={630}
              widths={[640, 960, 1200]}
              sizes="(min-width: 1100px) 740px, 100vw"
              fit="cover"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </figure>
        )}
        <article class="bp-article">
          {toc.length >= 3 && (
            <nav class="bp-toc" aria-label={t.tocTitle}>
              <p class="bp-toc-title">{t.tocTitle}</p>
              <ol>
                {toc.map((h) => (
                  <li><a href={`#${h.slug}`}>{h.text}</a></li>
                ))}
              </ol>
            </nav>
          )}

          <div class="bp-prose">
            <Content />
          </div>

          <p class="bp-disclaimer">{t.disclaimer}</p>

          <aside class="bp-cta" id="bp-cta" aria-labelledby="bp-cta-title">
            <p class="bp-cta-label">{t.ctaLabel}</p>
            <h2 class="bp-cta-title" id="bp-cta-title">{t.ctaTitle}</h2>
            <p class="bp-cta-text">{t.ctaText}</p>
            <div class="bp-cta-actions">
              <a href={service.href} class="bp-btn bp-btn-outline">{t.ctaService}</a>
              <a href={contactHref} class="bp-btn bp-btn-outline" data-lead-open>{t.ctaContact}</a>
              <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="bp-btn bp-btn-solid">{t.whatsapp}</a>
            </div>
          </aside>

          {related.length > 0 && (
            <section class="bp-related" aria-labelledby="bp-related-title">
              <h2 class="bp-related-title" id="bp-related-title">{t.relatedTitle}</h2>
              <ul class="bp-related-list">
                {related.map((p) => (
                  <li>
                    <a href={postPath(p)}>
                      <span class="bp-related-tag">{SERVICE_INFO[p.data.service][lang].label}</span>
                      <span class="bp-related-name">{p.data.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}

          <p class="bp-back"><a href={blogHref}>← {t.back}</a></p>
        </article>
      </div>

      <!-- Tarjeta lateral (solo escritorio ancho): acompaña la lectura. -->
      <aside class="bp-side" aria-label={t.ctaLabel}>
        <div class="bp-side-card">
          <p class="bp-cta-label">{t.ctaLabel}</p>
          <h2 class="bp-side-title">{t.ctaTitle}</h2>
          <p class="bp-side-text">{t.sideText}</p>
          <a href={contactHref} class="bp-btn bp-btn-solid" data-lead-open>{t.ctaContact}</a>
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="bp-btn bp-btn-outline">{t.whatsapp}</a>
        </div>
      </aside>
    </div>
  </section>

  <!-- Barra fija (móvil y tablet): aparece al avanzar la lectura, nunca encima del banner
       de cookies, y se oculta cuando ya se ve el bloque final. -->
  <div class="bp-bar" id="bp-bar" role="region" aria-label={t.barAria} hidden>
    <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="bp-bar-btn bp-bar-whatsapp">{t.barWhatsapp}</a>
    <a href={contactHref} class="bp-bar-btn bp-bar-request" data-lead-open>{t.barRequest}</a>
  </div>

  <LeadModal
    lang={lang}
    treatment={SERVICE_CRM_NAME[post.data.service]}
    treatmentLabel={service.label}
    article={postSlug(post)}
  />
</Layout>

<script>
  // Barra fija: visible si (1) se avanzó en la lectura, (2) el visitante ya respondió al
  // banner de cookies (para no apilarse con él) y (3) el bloque final aún no está en pantalla.
  const bar = document.getElementById('bp-bar');
  const endCta = document.getElementById('bp-cta');

  if (bar) {
    let scrolled = false;
    let endVisible = false;

    const bannerOpen = () => {
      const banner = document.getElementById('cookie-consent-banner');
      return Boolean(banner && !banner.hidden);
    };

    const update = () => {
      const show = scrolled && !endVisible && !bannerOpen();
      bar.hidden = !show;
      document.body.classList.toggle('bp-bar-on', show);
    };

    window.addEventListener(
      'scroll',
      () => {
        scrolled = window.scrollY > 500;
        update();
      },
      { passive: true },
    );

    if (endCta && 'IntersectionObserver' in window) {
      new IntersectionObserver(
        ([entry]) => {
          endVisible = entry.isIntersecting;
          update();
        },
        { threshold: 0.1 },
      ).observe(endCta);
    }

    // El banner se muestra/oculta cambiando su atributo `hidden` (también al reabrirlo desde el footer).
    const banner = document.getElementById('cookie-consent-banner');
    if (banner) new MutationObserver(update).observe(banner, { attributes: true, attributeFilter: ['hidden', 'class'] });
  }
</script>

<style>
  .bp-container {
    max-width: 1100px;
    margin: 0 auto;
    padding-left: 2rem;
    padding-right: 2rem;
  }

  /* ── Hero ── */
  .bp-hero {
    background-color: #0d2219;
    padding: 8.5rem 0 3.5rem;
  }

  .bp-hero .bp-container {
    max-width: 820px;
  }

  .bp-crumbs ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1.75rem;
    padding: 0;
    font-family: "Inter", sans-serif;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: rgba(244, 240, 235, 0.5);
  }

  .bp-crumbs li + li::before {
    content: "/";
    margin-right: 0.5rem;
    color: rgba(244, 240, 235, 0.3);
  }

  .bp-crumbs a {
    color: rgba(244, 240, 235, 0.7);
    text-decoration: none;
  }

  .bp-crumbs a:hover {
    color: rgba(244, 240, 235, 1);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .bp-label {
    font-family: "Inter", sans-serif;
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin: 0 0 1rem;
  }

  .bp-label a {
    color: #C49B38;
    text-decoration: none;
  }

  :global(html.dark) .bp-label a {
    color: #D4AF55;
  }

  .bp-title {
    font-family: "Cormorant Garamond", serif;
    font-size: clamp(2.1rem, 4.6vw, 3.3rem);
    font-weight: 300;
    font-style: italic;
    line-height: 1.15;
    color: rgba(244, 240, 235, 0.95);
    margin: 0 0 1.5rem;
    text-wrap: balance;
  }

  .bp-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-family: "Inter", sans-serif;
    font-size: 0.78rem;
    color: rgba(244, 240, 235, 0.55);
    margin: 0;
  }

  /* ── Maquetación: columna de lectura + tarjeta lateral (solo ≥1100px) ── */
  .bp-content-section {
    background-color: var(--bg-primary);
    padding: 3.5rem 0 6rem;
  }

  .bp-main {
    max-width: 740px;
    margin: 0 auto;
    min-width: 0;
  }

  .bp-side {
    display: none;
  }

  @media (min-width: 1100px) {
    /* El hero se alinea con el borde izquierdo de la columna de lectura (740 + 48 + 300 = 1088 + márgenes). */
    .bp-hero .bp-container {
      max-width: 1152px;
    }

    .bp-hero .bp-container > * {
      max-width: 740px;
    }

    .bp-container.bp-layout {
      max-width: 1152px;
      display: grid;
      grid-template-columns: minmax(0, 740px) 300px;
      justify-content: center;
      gap: 3rem;
      align-items: start;
    }

    .bp-main {
      margin: 0;
    }

    .bp-side {
      display: block;
      position: sticky;
      top: 6.5rem;
    }
  }

  .bp-side-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.75rem 1.5rem;
    background-color: #0d2219;
  }

  :global(html.dark) .bp-side-card {
    background-color: #141210;
    border: 1px solid rgba(244, 240, 235, 0.12);
  }

  .bp-side-title {
    font-family: "Cormorant Garamond", serif;
    font-size: 1.6rem;
    font-weight: 300;
    font-style: italic;
    line-height: 1.2;
    color: rgba(244, 240, 235, 0.95);
    margin: 0;
  }

  .bp-side-text {
    font-family: "Inter", sans-serif;
    font-size: 0.85rem;
    line-height: 1.65;
    color: rgba(244, 240, 235, 0.65);
    margin: 0 0 0.5rem;
  }

  /* Portada: proporción fija 1200:630 (sin saltos al cargar). */
  .bp-cover {
    margin: 0 0 2.5rem;
    aspect-ratio: 1200 / 630;
    overflow: hidden;
    background-color: var(--bg-tertiary);
  }

  .bp-cover :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bp-toc {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-primary);
    border-left: 3px solid var(--gold-500);
    padding: 1.25rem 1.5rem;
    margin-bottom: 2.5rem;
  }

  .bp-toc-title {
    font-family: "Inter", sans-serif;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin: 0 0 0.75rem;
  }

  .bp-toc ol {
    margin: 0;
    padding-left: 1.2rem;
    font-family: "Inter", sans-serif;
    font-size: 0.88rem;
    line-height: 1.8;
    color: var(--text-secondary);
  }

  .bp-toc a {
    color: var(--teal-600);
    text-decoration: none;
  }

  .bp-toc a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* El HTML del markdown se renderiza sin el atributo de scope de Astro: :global(). */
  .bp-prose :global(h2) {
    font-family: "Cormorant Garamond", serif;
    font-size: clamp(1.6rem, 3vw, 2rem);
    font-weight: 500;
    line-height: 1.25;
    color: var(--text-primary);
    margin: 2.75rem 0 1rem;
    scroll-margin-top: 6rem;
  }

  .bp-prose :global(h3) {
    font-family: "Cormorant Garamond", serif;
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 2rem 0 0.75rem;
    scroll-margin-top: 6rem;
  }

  .bp-prose :global(p),
  .bp-prose :global(ul),
  .bp-prose :global(ol) {
    font-family: "Inter", sans-serif;
    font-size: 1rem;
    line-height: 1.85;
    color: var(--text-secondary);
    margin: 0 0 1.25rem;
  }

  .bp-prose :global(ul),
  .bp-prose :global(ol) {
    padding-left: 1.4rem;
  }

  .bp-prose :global(li) {
    margin-bottom: 0.5rem;
  }

  .bp-prose :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }

  .bp-prose :global(a) {
    color: var(--teal-600);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .bp-prose :global(a:hover) {
    color: var(--gold-600);
  }

  .bp-prose :global(blockquote) {
    border-left: 3px solid var(--gold-500);
    margin: 1.75rem 0;
    padding: 0.25rem 0 0.25rem 1.25rem;
    font-family: "Cormorant Garamond", serif;
    font-size: 1.3rem;
    font-style: italic;
    color: var(--text-primary);
  }

  /* Imágenes dentro del texto (Markdown: ![alt](ruta)); si llevan título entre comillas
     Astro/markdown las envuelve en <figure>/<figcaption>. */
  .bp-prose :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 2rem auto;
  }

  .bp-prose :global(figure) {
    margin: 2rem 0;
  }

  /* Imagen con versión para tema claro y oscuro (HTML dentro del Markdown):
     <picture class="theme-light"> y <picture class="theme-dark"> dentro de una
     <figure class="theme-figure">. Se muestra solo la del tema activo (clase
     .dark en <html>, también al cambiarlo en vivo) y, al estar oculta con
     display:none y loading="lazy", el navegador no descarga la otra. */
  .bp-prose :global(picture) {
    display: block;
  }

  .bp-prose :global(.theme-dark) {
    display: none;
  }

  :global(html.dark) .bp-prose :global(.theme-light) {
    display: none;
  }

  :global(html.dark) .bp-prose :global(.theme-dark) {
    display: block;
  }

  .bp-prose :global(figure img) {
    margin: 0 auto;
  }

  .bp-prose :global(figcaption) {
    font-family: "Inter", sans-serif;
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--text-tertiary);
    text-align: center;
    margin-top: 0.6rem;
  }

  .bp-disclaimer {
    font-family: "Inter", sans-serif;
    font-size: 0.8rem;
    line-height: 1.7;
    color: var(--text-tertiary);
    margin: 2.5rem 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-primary);
  }

  /* ── CTA final ── */
  .bp-cta {
    background-color: #0d2219;
    padding: 2.25rem 2rem;
    margin: 0 0 3rem;
    text-align: center;
  }

  :global(html.dark) .bp-cta {
    background-color: #141210;
    border: 1px solid rgba(244, 240, 235, 0.12);
  }

  .bp-cta-label {
    font-family: "Inter", sans-serif;
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #C49B38;
    margin: 0 0 0.75rem;
  }

  :global(html.dark) .bp-cta-label {
    color: #D4AF55;
  }

  .bp-cta-title {
    font-family: "Cormorant Garamond", serif;
    font-size: 1.9rem;
    font-weight: 300;
    font-style: italic;
    color: rgba(244, 240, 235, 0.95);
    margin: 0 0 0.75rem;
  }

  .bp-cta-text {
    font-family: "Inter", sans-serif;
    font-size: 0.92rem;
    line-height: 1.7;
    color: rgba(244, 240, 235, 0.65);
    max-width: 52ch;
    margin: 0 auto 1.5rem;
  }

  .bp-cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .bp-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: "Inter", sans-serif;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    text-align: center;
    padding: 0.85rem 1.5rem;
    cursor: pointer;
    transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }

  .bp-btn-outline {
    background-color: transparent;
    color: rgba(244, 240, 235, 0.85);
    border: 1px solid rgba(244, 240, 235, 0.35);
  }

  .bp-btn-outline:hover {
    background-color: rgba(244, 240, 235, 0.1);
    border-color: rgba(244, 240, 235, 0.6);
  }

  .bp-btn-solid {
    background-color: #C49B38;
    color: #0d2219;
    border: 1px solid #C49B38;
  }

  .bp-btn-solid:hover {
    background-color: transparent;
    color: rgba(244, 240, 235, 0.85);
    border-color: rgba(244, 240, 235, 0.35);
  }

  :global(html.dark) .bp-btn-solid {
    background-color: #D4AF55;
    color: #141210;
    border-color: #D4AF55;
  }

  :global(html.dark) .bp-btn-solid:hover {
    background-color: transparent;
    color: rgba(244, 240, 235, 0.85);
    border-color: rgba(244, 240, 235, 0.35);
  }

  /* ── Barra fija (móvil/tablet) ── */
  .bp-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 90;
    display: flex;
    gap: 0.6rem;
    padding: 0.7rem 1rem calc(0.7rem + env(safe-area-inset-bottom));
