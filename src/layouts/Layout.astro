---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { getLang, getAlternates, normalizePath, SITE_URL, CLINIC_ID, WEBSITE_ID, CLINIC_MAP_URL, AREA_SERVED_SCHEMA } from '../data/i18n';
import { servicios as serviciosEs } from '../data/servicios';
import { servicios as serviciosEn } from '../data/servicios-en';

interface Props {
  title: string;
  description?: string;
  image?: string;
  preloadHero?: boolean;
  noindex?: boolean;
  /** Open Graph type: "article" para las entradas del blog. */
  ogType?: 'website' | 'article';
  /** ISO 8601 — solo para ogType "article". */
  publishedTime?: string;
  modifiedTime?: string;
  /** Migas intermedias entre Inicio y la página actual (ej. Blog). */
  breadcrumbTrail?: Array<{ name: string; path: string }>;
}

const {
  title,
  description: descriptionProp,
  image = '/img/hero/instrumentos-odontologicos-esterilizados.webp',
  preloadHero = false,
  noindex = false,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  breadcrumbTrail = [],
} = Astro.props;

const siteUrl = SITE_URL;
const lang = getLang(Astro.url.pathname);
const isEn = lang === 'en';
const alternates = noindex ? null : getAlternates(Astro.url.pathname);
const description = descriptionProp ?? (isEn
  ? 'Arango Dental Clinic - Dental clinic at Avinguda Alfonso Puchades, 22, bajo, Benidorm, Alicante. Implants, orthodontics, cosmetic dentistry and digital dentistry.'
  : 'Arango Dental Clinic - Clínica dental en Avinguda Alfonso Puchades, 22, bajo, Benidorm, Alicante. Implantes, ortodoncia, estética dental y odontología digital.');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;

// Los 7 servicios con su landing real, de la misma fuente que el navbar, el footer y /servicios/.
const offerServices = isEn ? serviciosEn : serviciosEs;
const fullTitle = `${title} | Arango Dental Clinic`;

// Schema.org structured data for Dentist
const schemaData = {
  "@context": "https://schema.org",
  "@type": "Dentist",
  "@id": CLINIC_ID,
  "name": "Arango Dental Clinic",
  "description": isEn
    ? "Dental clinic at Avinguda Alfonso Puchades, 22, bajo, Benidorm, Alicante. Implants, orthodontics, cosmetic dentistry and digital dentistry."
    : "Clínica dental en Avinguda Alfonso Puchades, 22, bajo, Benidorm, Alicante. Implantes, ortodoncia, estética dental y odontología digital.",
  "knowsLanguage": ["es"],
  "url": siteUrl,
  "hasMap": CLINIC_MAP_URL,
  "areaServed": AREA_SERVED_SCHEMA,
  "logo": `${siteUrl}/img/logo/logo-oscuro.webp`,
  "image": `${siteUrl}/img/hero/instrumentos-odontologicos-esterilizados.webp`,
  "telephone": "+34 965 08 82 82",
  "email": "Arangodentalclinic@gmail.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Avinguda Alfonso Puchades, 22, bajo",
    "addressLocality": "Benidorm",
    "addressRegion": "Alicante",
    "postalCode": "03501",
    "addressCountry": "ES"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 38.5419187,
    "longitude": -0.1254604
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday"],
      "opens": "10:00",
      "closes": "14:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday"],
      "opens": "15:00",
      "closes": "19:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": "Friday",
      "opens": "10:00",
      "closes": "14:00"
    }
  ],
  "priceRange": "€€€",
  "paymentAccepted": ["Cash", "Credit Card", "Debit Card"],
  "currenciesAccepted": "EUR",
  "sameAs": [
    "https://www.facebook.com/p/Arango-Dental-Clinic-61574405870200/",
    "https://www.instagram.com/arangodentalclinic/"
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": isEn ? "Dental Services" : "Servicios Dentales",
    "itemListElement": offerServices.map((s) => ({
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": s.nombre,
        "url": s.landingHref ? siteUrl + s.landingHref : undefined,
      },
    })),
  }
};

// WebSite schema — una sola vez, ayuda a los motores a entender el sitio como entidad
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": WEBSITE_ID,
  "name": "Arango Dental Clinic",
  "url": siteUrl,
  "inLanguage": lang,
  "publisher": { "@id": CLINIC_ID },
};

// BreadcrumbList — Inicio/Home > página actual (se omite en el home, no aporta ahí)
const homePath = isEn ? '/en/' : '/';
const breadcrumbSchema = normalizePath(Astro.url.pathname) === homePath ? null : {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": isEn ? "Home" : "Inicio",
      "item": siteUrl + homePath,
    },
    ...breadcrumbTrail.map((crumb, i) => ({
      "@type": "ListItem",
      "position": i + 2,
      "name": crumb.name,
      "item": siteUrl + crumb.path,
    })),
    {
      "@type": "ListItem",
      "position": breadcrumbTrail.length + 2,
      "name": title,
      "item": canonicalUrl,
    },
  ],
};
const rssHref = isEn ? '/en/blog/rss.xml' : '/blog/rss.xml';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Google Consent Mode v2 — denegado por defecto (debe cargar antes de GTM) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        'ad_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'analytics_storage': 'denied',
        'wait_for_update': 500
      });
    </script>

    <!-- Restaurar decisión previa (si el usuario ya eligió en una visita anterior) -->
    <script is:inline>
      (function () {
        try {
          var raw = localStorage.getItem('cookie_consent');
          if (!raw) return;
          var consent = JSON.parse(raw);
          if (typeof consent.analytics !== 'boolean' || typeof consent.marketing !== 'boolean') return;
          gtag('consent', 'update', {
            'ad_storage': consent.marketing ? 'granted' : 'denied',
            'ad_user_data': consent.marketing ? 'granted' : 'denied',
            'ad_personalization': consent.marketing ? 'granted' : 'denied',
            'analytics_storage': consent.analytics ? 'granted' : 'denied'
          });
        } catch (e) {
          /* localStorage no disponible — se mantiene todo denegado por defecto */
        }
      })();
    </script>

    <!-- Google Tag Manager -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-5C8KVVJL');
    </script>
    <!-- End Google Tag Manager -->

    <!-- SEO básico -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {alternates && (
      <>
        <link rel="alternate" hreflang="es" href={siteUrl + alternates.es} />
        <link rel="alternate" hreflang="en" href={siteUrl + alternates.en} />
        <link rel="alternate" hreflang="x-default" href={siteUrl + alternates.es} />
      </>
    )}
    <link rel="alternate" type="application/rss+xml" title="Arango Dental Clinic — Blog" href={rssHref} />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && (modifiedTime ?? publishedTime) && <meta property="article:modified_time" content={modifiedTime ?? publishedTime} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${image}`} />
    <meta property="og:locale" content={isEn ? 'en_GB' : 'es_ES'} />
    {alternates && <meta property="og:locale:alternate" content={isEn ? 'es_ES' : 'en_GB'} />}
    <meta property="og:site_name" content="Arango Dental Clinic" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${image}`} />

    <!-- Otros meta tags útiles -->
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="author" content="Arango Dental Clinic" />
    <meta name="theme-color" content="#153328" />

    <!-- Preload hero image (LCP) -->
    {preloadHero && (
      <>
        <link rel="preload" as="image" type="image/webp" href="/img/hero/1-mobile.webp" media="(max-width: 640px)" fetchpriority="high" />
        <link rel="preload" as="image" type="image/webp" href="/img/hero/instrumentos-odontologicos-esterilizados.webp" media="(min-width: 641px)" fetchpriority="high" />
      </>
    )}

    <!-- Fuentes (non-blocking) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=DM+Sans:wght@300;400&family=Inter:wght@300;400;500;600;700&display=swap">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=DM+Sans:wght@300;400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <noscript><link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=DM+Sans:wght@300;400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"></noscript>

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}

    <!-- Dark mode detection -->
    <script is:inline>
      const theme = localStorage.getItem('theme');
      if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col transition-colors" style="background-color: var(--bg-primary); color: var(--text-primary);">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5C8KVVJL"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <!-- Skip to main content (Accesibilidad) -->
    <a
      href="#main-content"
      class="skip-link sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:outline-none"
    >
      Saltar al contenido principal
    </a>

    <Navbar />
    <main id="main-content" class="grow">
      <slot />
    </main>
    <Footer />
    <CookieConsent />

    <script>
      import { captureAttribution } from '../scripts/attribution';
      captureAttribution();
    </script>
  </body>
</html>

<style>
  /* Par fijo bg/texto (no usa --teal-600: esa variable se invierte a un verde
     claro en dark mode y el link quedaba con 1.88:1 de contraste). Mismo
     patrón que .hero-btn-primary: siempre alto contraste en los dos temas. */
  .skip-link {
    background-color: #1c1b1b;
    color: #ffffff;
  }

  :global(html.dark) .skip-link {
    background-color: #D4AF55;
    color: #141210;
  }
</style>
