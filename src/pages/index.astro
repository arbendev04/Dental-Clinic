      transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
    }
    /* Hover: mismo color que el botón principal de la sección — verde en
       claro, dorado en oscuro (igual que .quick-contact-btn-outline). */
    .services-arrow:hover {
      background-color: #153328;
      color: #ffffff;
      border-color: #153328;
    }
    :global(html.dark) .services-arrow:hover {
      background-color: #D4AF55;
      color: #141210;
      border-color: #D4AF55;
    }
  </style>

  <script>
    (function () {
      const els = document.querySelectorAll('.stat-number');
      if (!els.length) return;

      function animateCounter(el) {
        const target = el.getAttribute('data-target') || '';
        // Núcleo numérico (admite coma de miles y un punto decimal, ej.
        // "5,000+" o "4.9 ★"); todo lo de afuera es prefijo/sufijo literal.
        const match = target.match(/-?\d[\d,]*\.?\d*/);
        if (!match) return;
        const core   = match[0];
        const prefix = target.slice(0, match.index);
        const suffix = target.slice((match.index || 0) + core.length);
        const numStr = core.replace(/,/g, '');
        const end = parseFloat(numStr);
        if (isNaN(end)) return;
        const decimals = (numStr.split('.')[1] || '').length;

        const duration = 1600;
        const start = performance.now();
        const format = (n: number) =>
          n.toLocaleString('es-ES', { minimumFractionDigits: decimals, maximumFractionDigits: decimals });
        el.textContent = prefix + format(0) + suffix;

        function tick(now: number) {
          const elapsed = now - start;
          const progress = Math.min(elapsed / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          const current = end * eased;
          el.textContent = prefix + format(current) + suffix;
          if (progress < 1) requestAnimationFrame(tick);
        }

        requestAnimationFrame(tick);
      }

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              animateCounter(e.target);
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.3 }
      );

      els.forEach((el) => io.observe(el));
    })();
  </script>

  <!-- Carrusel de servicios: flechas prev/next sobre scroll-snap nativo -->
  <script>
    (function () {
      const track = document.getElementById('services-track');
      const prevBtn = document.getElementById('services-prev');
      const nextBtn = document.getElementById('services-next');
      if (!track || !prevBtn || !nextBtn) return;

      function scrollByCard(direction: number) {
        const card = track.querySelector('.services-slide') as HTMLElement | null;
        if (!card) return;
        const gap = parseFloat(getComputedStyle(track).columnGap || '0');
        const amount = card.getBoundingClientRect().width + gap;
        track.scrollBy({ left: direction * amount, behavior: 'smooth' });
      }

      prevBtn.addEventListener('click', () => scrollByCard(-1));
      nextBtn.addEventListener('click', () => scrollByCard(1));
    })();
  </script>
</Layout>
