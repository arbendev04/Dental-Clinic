          <div class="w-8 h-px" style="background-color: var(--gold-500);"></div>
        </div>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-normal" style="font-family: 'Cormorant Garamond', serif; color: var(--text-primary); text-wrap: balance;">
          Cuidado Profesional a Tu Medida
