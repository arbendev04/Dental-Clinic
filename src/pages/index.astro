---
import Layout from '../layouts/Layout.astro';
import HeroScroll from '../components/HeroScroll.astro';

const services = [
  {
    icon: 'sparkles',
    title: 'Odontología Digital',
    description: 'Escáner intraoral 3D, radiografía digital y diseño de sonrisa asistido por ordenador para diagnósticos precisos y tratamientos predecibles.',
    href: '/servicios',
    anchor: 'Saber Más',
  },
  {
    icon: 'shield-check',
    title: 'Implantología',
    description: 'Implantes de titanio de alta calidad para recuperar piezas perdidas con un resultado estético y funcional completamente natural.',
    href: '/implantes-dentales-benidorm/',
    anchor: 'Implantes dentales en Benidorm',
  },
  {
    icon: 'smile',
    title: 'Estética Dental',
    description: 'Carillas de porcelana, blanqueamiento profesional y diseño de sonrisa personalizado para transformar tu imagen con armonía y precisión.',
    href: '/servicios',
    anchor: 'Saber Más',
  },
  {
    icon: 'cube',
    title: 'Rehabilitación Oral',
    description: 'Coronas, puentes y prótesis dentales para restaurar dientes dañados o perdidos, recuperando función y estética con un plan personalizado.',
    href: '/servicios',
    anchor: 'Saber Más',
  },
  {
    icon: 'heart',
    title: 'Periodoncia',
    description: 'Cuidamos la salud de tus encías, tratando el sangrado, la inflamación y otras enfermedades periodontales con un enfoque preventivo.',
    href: '/servicios',
    anchor: 'Saber Más',
  },
  {
    icon: 'adjustments',
    title: 'Ortodoncia',
    description: 'Alineamos tus dientes y corregimos problemas de mordida con brackets tradicionales o alineadores transparentes, según tu caso.',
    href: '/servicios',
    anchor: 'Saber Más',
  },
  {
    icon: 'magnifier',
    title: 'Endodoncia',
    description: 'Tratamos infecciones y daños internos del diente mediante endodoncia (tratamiento de conducto), para conservar la pieza dental original.',
    href: '/servicios',
    anchor: 'Saber Más',
  },
];

const stats = [
  { number: '10+', label: 'Años de Experiencia' },
  // Calificación real verificada en Google Maps (place_id ChIJrZfws2MFYg0RHzre1V7ThzY)
  // el 2026-09-06. Google no expone el número de reseñas sin sesión iniciada
  // ni sin la API de Places, así que no se muestra un conteo — ver CLAUDE.md.
  { number: '4.9 ★', label: 'Calificación en Google' },
];

---

<Layout title="Dentista en Benidorm" description="Arango Dental Clinic, tu dentista de confianza en Benidorm. Implantes, estética dental, ortodoncia y odontología digital con tecnología avanzada." preloadHero={true}>
  <!-- Hero Section -->
  <HeroScroll />

  <!-- Services Section -->
  <section class="px-5 lg:px-20 py-16 md:py-24 lg:py-28 transition-colors" style="background-color: var(--bg-secondary);">
    <div class="container mx-auto">
      <!-- Section Header -->
      <div class="text-center mb-10 md:mb-16">
        <div class="flex items-center justify-center gap-3 mb-4">
