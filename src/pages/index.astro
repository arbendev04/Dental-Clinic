    /* Carrusel de servicios — scroll-snap nativo (sin librerías), navegable
       con flechas, arrastre táctil o teclado (el track es focuseable). */
    .services-carousel {
      position: relative;
    }

    .services-track {
      display: flex;
      gap: 1rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding-bottom: 0.25rem;
    }
    .services-track::-webkit-scrollbar {
      display: none;
    }
    .services-track:focus-visible {
      outline: 2px solid var(--gold-500);
      outline-offset: 4px;
    }

    /* Ancho de cada tarjeta: siempre deja asomar la siguiente, para que se
       note que hay más para scrollear (no queda todo visible de una). */
    .services-slide {
      position: relative;
      flex: 0 0 86%;
      scroll-snap-align: start;
    }

    /* Borde con resplandor móvil — adaptación en CSS puro (sin React ni
       Framer Motion) del efecto "HoverBorderGradient" de Aceternity.
       IMPORTANTE: animar la propiedad "background" completa vía @keyframes
       (cambiando la posición de un radial-gradient) NO se interpola en los
       navegadores reales — el valor queda congelado en el primer frame para
       siempre (probado forzando la animación con !important: sin cambios en
       3+ segundos). La técnica que sí anima de forma confiable es registrar
       un ángulo con @property (queda "tipado" como <angle>, así el motor
       sabe interpolarlo) y usarlo en un conic-gradient — el mismo mecanismo
       ya verificado en la primera versión de este efecto. */
    @property --services-border-angle {
      syntax: '<angle>';
      initial-value: 0deg;
      inherits: false;
    }

    .services-slide::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
      padding: 1.5px;
      border-radius: inherit;
      filter: blur(2px);
      background: conic-gradient(
        from var(--services-border-angle),
        transparent 0deg,
        transparent 240deg,
        var(--teal-500) 300deg,
        transparent 360deg
      );
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      pointer-events: none;
      animation: services-border-rotate 5s linear infinite;
    }

    /* Verde en claro, dorado en oscuro (el resto del borde no cambia). */
    :global(html.dark) .services-slide::before {
      background: conic-gradient(
        from var(--services-border-angle),
        transparent 0deg,
        transparent 240deg,
        var(--gold-500) 300deg,
        transparent 360deg
      );
    }

    .services-slide:hover::before {
      background: radial-gradient(75% 180% at 50% 50%, var(--gold-500) 0%, var(--teal-500) 55%, transparent 100%);
      animation-play-state: paused;
    }

    @keyframes services-border-rotate {
      to { --services-border-angle: 360deg; }
    }

    /* Ligero desfase por tarjeta para que no giren todas al mismo tiempo. */
    .services-slide:nth-child(2)::before { animation-delay: -0.7s; }
    .services-slide:nth-child(3)::before { animation-delay: -1.4s; }
    .services-slide:nth-child(4)::before { animation-delay: -2.1s; }
    .services-slide:nth-child(5)::before { animation-delay: -2.8s; }
    .services-slide:nth-child(6)::before { animation-delay: -3.5s; }
    .services-slide:nth-child(7)::before { animation-delay: -4.2s; }

    @media (prefers-reduced-motion: reduce) {
      .services-slide::before {
        animation: none;
      }
    }

    @media (min-width: 640px) {
      .services-slide {
        flex: 0 0 60%;
      }
    }

    @media (min-width: 768px) {
      .services-track {
        gap: 1.5rem;
      }
      .services-slide {
        flex: 0 0 calc((100% - 3rem) / 2.3);
      }
    }

    /* Link "Saber Más" de cada tarjeta — mismo esquema de color por tema
       que el botón de WhatsApp: verde en claro, dorado en oscuro. */
    .services-card-link {
      color: #153328;
