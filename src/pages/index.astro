---
import Layout from '../layouts/Layout.astro';
import HeroScroll from '../components/HeroScroll.astro';

const services = [
  {
    icon: 'sparkles',
    title: 'Odontología Digital',
    description: 'Escáner intraoral 3D, radiografía digital y diseño de sonrisa asistido por ordenador para diagnósticos precisos y tratamientos predecibles.',
    href: '/servicios',
    anchor: 'Saber Más',
  },
  {
    icon: 'shield-check',
    title: 'Implantología',
    description: 'Implantes de titanio de alta calidad para recuperar piezas perdidas con un resultado estético y funcional completamente natural.',
    href: '/implantes-dentales-benidorm/',
    anchor: 'Implantes dentales en Benidorm',
  },
  {
    icon: 'smile',
    title: 'Estética Dental',
    description: 'Carillas de porcelana, blanqueamiento profesional y diseño de sonrisa personalizado para transformar tu imagen con armonía y precisión.',
    href: '/servicios',
    anchor: 'Saber Más',
  },
];

const stats = [
  { number: '15+', label: 'Años de Experiencia' },
  // Calificación real verificada en Google Maps (place_id ChIJrZfws2MFYg0RHzre1V7ThzY)
  // el 2026-09-06. Google no expone el número de reseñas sin sesión iniciada
  // ni sin la API de Places, así que no se muestra un conteo — ver CLAUDE.md.
  { number: '4.9 ★', label: 'Calificación en Google' },
];

---

<Layout title="Dentista en Benidorm" description="Arango Dental Clinic, tu dentista de confianza en Benidorm. Implantes, estética dental, ortodoncia y odontología digital con tecnología avanzada." preloadHero={true}>
  <!-- Hero Section -->
  <HeroScroll />

  <!-- Services Section -->
  <section class="px-5 lg:px-20 py-16 md:py-24 lg:py-28 transition-colors" style="background-color: var(--bg-secondary);">
    <div class="container mx-auto">
      <!-- Section Header -->
      <div class="text-center mb-10 md:mb-16">
        <div class="flex items-center justify-center gap-3 mb-4">
          <div class="w-8 h-px" style="background-color: var(--gold-500);"></div>
          <span class="text-[0.65rem] tracking-[0.2em] uppercase font-medium" style="color: var(--gold-600);">
            Nuestros Servicios
          </span>
          <div class="w-8 h-px" style="background-color: var(--gold-500);"></div>
        </div>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-normal" style="font-family: 'Cormorant Garamond', serif; color: var(--text-primary); text-wrap: balance;">
          Cuidado Profesional a Tu Medida
        </h2>
      </div>

      <!-- Services Grid -->
      <div class="grid md:grid-cols-3 gap-4 md:gap-6">
        {services.map((service) => (
          <div class="p-6 md:p-10 transition-all duration-300 hover:translate-y-[-4px]" style="background-color: var(--bg-primary); border: 1px solid var(--border-primary);">
            <div class="w-12 h-12 md:w-14 md:h-14 flex items-center justify-center mb-5" style="background-color: var(--teal-100);">
              <svg class="w-6 h-6 md:w-7 md:h-7" style="color: var(--teal-600);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                {service.icon === 'sparkles' && (
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                )}
                {service.icon === 'shield-check' && (
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                )}
                {service.icon === 'smile' && (
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                )}
              </svg>
            </div>
            <h3 class="text-xl md:text-2xl font-semibold mb-3 md:mb-5" style="font-family: 'Cormorant Garamond', serif; color: var(--text-primary);">{service.title}</h3>
            <p class="text-sm md:text-[15px] mb-5 md:mb-6" style="color: var(--text-secondary); line-height: 1.7;">{service.description}</p>
            <a href={service.href} class="inline-flex items-center gap-2 text-sm font-medium transition-opacity hover:opacity-60" style="color: var(--gold-600);">
              <span>{service.anchor}</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        ))}
      </div>

      <!-- Franja de contacto rápido -->
      <div class="quick-contact-strip">
        <a href="/contacto#contact-form" class="quick-contact-btn quick-contact-btn-solid">Agenda tu Cita</a>
        <a href="https://wa.me/34665886439" target="_blank" rel="noopener" class="quick-contact-btn quick-contact-btn-outline">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
          WhatsApp
        </a>
        <a href="tel:+34965088282" class="quick-contact-btn quick-contact-btn-outline">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 3H6.22a1 1 0 01.948.684L8.665 8.18a1 1 0 01-.25 1.033l-1.204 1.204a11.05 11.05 0 005.373 5.373l1.204-1.204a1 1 0 011.033-.25l4.492 1.498a1 1 0 01.684.949V19.5a2.5 2.5 0 01-2.5 2.5h-1C7.888 22 2 16.112 2 8.5v-1z" /></svg>
          965 08 82 82
        </a>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="px-5 lg:px-20 py-16 md:py-24 transition-colors" style="background-color: var(--bg-primary);">
    <div class="container mx-auto">
      <!-- Section Header -->
      <div class="text-center mb-10 md:mb-16">
        <div class="flex items-center justify-center gap-3 mb-4">
          <div class="w-8 h-px" style="background-color: var(--gold-500);"></div>
          <span class="text-[0.65rem] tracking-[0.2em] uppercase font-medium" style="color: var(--gold-600);">
            Excelencia en Números
          </span>
          <div class="w-8 h-px" style="background-color: var(--gold-500);"></div>
        </div>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-normal" style="font-family: 'Cormorant Garamond', serif; color: var(--text-primary);">
          Un Legado de Excelencia
        </h2>
      </div>

      <!-- Stats Grid -->
      <div class="flex flex-wrap justify-center gap-12 md:gap-24">
        {stats.map((stat) => (
          <div class="flex flex-col items-center gap-3">
            <div class="text-6xl md:text-8xl font-light stat-number" style="font-family: 'Cormorant Garamond', serif; color: var(--teal-600);" data-target={stat.number}>
              {stat.number}
            </div>
            <div class="text-xs md:text-sm font-medium uppercase text-center" style="color: var(--text-secondary); letter-spacing: 0.15em;">
              {stat.label}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="px-5 lg:px-20 py-16 md:py-24 transition-colors" style="background-color: var(--bg-secondary);">
    <div class="container mx-auto">
      <!-- Section Header -->
      <div class="text-center mb-10 md:mb-16">
        <div class="flex items-center justify-center gap-3 mb-4">
          <div class="w-8 h-px" style="background-color: var(--gold-500);"></div>
          <span class="text-[0.65rem] tracking-[0.2em] uppercase font-medium" style="color: var(--gold-600);">
            Testimonios
          </span>
          <div class="w-8 h-px" style="background-color: var(--gold-500);"></div>
        </div>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-normal" style="font-family: 'Cormorant Garamond', serif; color: var(--text-primary);">
          Lo Que Dicen Nuestros Pacientes
        </h2>
      </div>

      <!-- Reseñas de Google (EmbedSocial) — lazy load: recién se inyecta el
           widget del tema activo cuando la sección entra al viewport. Antes
           se montaban los dos (claro y oscuro) siempre, aunque uno quedara
           en display:none — eso duplicaba cada script/iframe de EmbedSocial
           desde la carga inicial de la página. -->
      <div id="reviews-container" class="reviews-widget">
        <div id="reviews-skeleton" class="reviews-skeleton" aria-hidden="true">
          <div class="reviews-skeleton-card"></div>
          <div class="reviews-skeleton-card"></div>
          <div class="reviews-skeleton-card"></div>
        </div>
      </div>

      <script>
        (function () {
          const LIGHT_REF = 'ce0db3de6c56bf3c7a637ce470f75bef38fa2ee0';
          const DARK_REF = '23f82d3fea76f664349985cb3ed7d64ef9e26cab';
          const SCRIPT_ID = 'EmbedSocialHashtagScript';

          const container = document.getElementById('reviews-container');
          if (!container) return;

          let loaded = false;
          let loadedRef: string | null = null;

          function isDark() {
            return document.documentElement.classList.contains('dark');
          }

          function activeRef() {
            return isDark() ? DARK_REF : LIGHT_REF;
          }

          function isProperlySized(iframe: HTMLIFrameElement) {
            return /^[1-9]\d*px$/.test(iframe.style.height);
          }

          function loadEmbedSocialScript() {
            const old = document.getElementById(SCRIPT_ID);
            if (old) old.remove();
            const js = document.createElement('script');
            js.id = SCRIPT_ID;
            js.src = 'https://embedsocial.com/cdn/ht.js';
            document.head.appendChild(js);
          }

          function renderWidget(ref: string) {
            container.innerHTML = `
              <div class="embedsocial-hashtag" data-ref="${ref}">
                <a class="feed-powered-by-es feed-powered-by-es-feed-img es-widget-branding" href="https://embedsocial.com/" target="_blank" title="Widget by EmbedSocial">
                  <img src="https://embedsocial.com/cdn/icon/embedsocial-logo.webp" alt="EmbedSocial" width="16" height="16" />
                  <div class="es-widget-branding-text">Widget by EmbedSocial</div>
                </a>
              </div>
            `;
            loadEmbedSocialScript();
            loaded = true;
            loadedRef = ref;

            // Red de seguridad: si el iframe no llega a medirse solo, forzamos un reload.
            setTimeout(() => {
              const iframe = container.querySelector('iframe');
              if (iframe && !isProperlySized(iframe)) iframe.src = iframe.src;
            }, 1500);
          }

          const io = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting && !loaded) {
                renderWidget(activeRef());
                io.unobserve(entry.target);
              }
            });
          }, { rootMargin: '200px' });

          io.observe(container);

          // Si el usuario cambia de tema en vivo después de que el widget ya
          // cargó, quitamos el script/widget anterior antes de inyectar el
          // nuevo — nunca los dos a la vez.
          const themeObserver = new MutationObserver(() => {
            if (!loaded) return;
            const ref = activeRef();
            if (ref !== loadedRef) renderWidget(ref);
          });
          themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
        })();
      </script>
    </div>
  </section>

  <!-- CTA Banner Section -->
  <section class="cta-banner px-5 lg:px-20 py-14 md:py-20 flex items-center justify-center transition-colors">
    <div class="container mx-auto text-center max-w-3xl">
      <h2 class="cta-banner-title text-3xl md:text-4xl lg:text-5xl font-normal mb-5 md:mb-6" style="font-family: 'Cormorant Garamond', serif;">
        ¿Listo para Experimentar la Diferencia?
      </h2>
      <p class="cta-banner-sub text-sm md:text-base mb-7 md:mb-10" style="line-height: 1.75; max-width: 480px; margin-left: auto; margin-right: auto;">
        Reserva tu consulta hoy y descubre por qué los pacientes más exigentes eligen Arango Dental Clinic.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="/contacto#contact-form"
          class="cta-banner-btn inline-block px-8 md:px-10 py-3.5 md:py-4 text-sm md:text-[15px] font-medium tracking-wider transition-all duration-300"
          style="letter-spacing: 0.1em;"
        >
          Quiero Mi Valoración Gratuita
        </a>
        <a
          href="https://wa.me/34665886439"
          target="_blank"
          rel="noopener"
          class="cta-banner-btn-solid inline-block px-8 md:px-10 py-3.5 md:py-4 text-sm md:text-[15px] font-medium tracking-wider transition-all duration-300"
          style="letter-spacing: 0.1em;"
        >
          Escríbenos por WhatsApp
        </a>
      </div>
    </div>
  </section>

  <style>
    /* Widget de reseñas — uno por tema, solo uno visible a la vez.
       min-height reserva espacio para el skeleton y para el iframe de
       EmbedSocial hasta que termine de medirse, evitando CLS. */
    .reviews-widget {
      min-height: 420px;
    }

    .reviews-skeleton {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      height: 420px;
    }

    @media (min-width: 768px) {
      .reviews-skeleton {
        flex-direction: row;
      }
    }

    .reviews-skeleton-card {
      flex: 1;
      border-radius: 4px;
      background: linear-gradient(90deg, var(--bg-tertiary) 25%, var(--bg-secondary) 50%, var(--bg-tertiary) 75%);
      background-size: 200% 100%;
      animation: reviews-skeleton-pulse 1.6s ease-in-out infinite;
    }

    @keyframes reviews-skeleton-pulse {
      0% { background-position: 200% 0; }
      100% { background-position: -200% 0; }
    }

    @media (prefers-reduced-motion: reduce) {
      .reviews-skeleton-card {
        animation: none;
        background: var(--bg-tertiary);
      }
    }

    /* CTA Banner — modo claro */
    .cta-banner {
      background-color: var(--bg-tertiary);
    }
    .cta-banner-title {
      color: var(--text-primary);
    }
    .cta-banner-sub {
      color: var(--text-secondary);
    }
    .cta-banner-btn {
      background-color: transparent;
      color: #153328;
      border: 1px solid rgba(21, 51, 40, 0.65);
    }
    .cta-banner-btn:hover {
      background-color: #153328;
      color: #ffffff;
      border-color: #153328;
    }

    /* Modo oscuro: fondo dark de la landing */
    :global(html.dark) .cta-banner {
      background-color: #141210;
    }
    :global(html.dark) .cta-banner-title {
      color: rgba(244, 240, 235, 0.95);
    }
    :global(html.dark) .cta-banner-sub {
      color: rgba(244, 240, 235, 0.55);
    }
    :global(html.dark) .cta-banner-btn {
      background-color: transparent;
      color: rgba(244, 240, 235, 0.85);
      border: 1px solid rgba(244, 240, 235, 0.30);
    }
    :global(html.dark) .cta-banner-btn:hover {
      background-color: #D4AF55;
      color: #141210;
      border-color: #D4AF55;
    }

    /* Segundo botón del CTA final (WhatsApp) — sólido, mismo patrón que
       .hero-btn-primary/.srv-btn-solid en el resto del sitio. */
    .cta-banner-btn-solid {
      background-color: #153328;
      color: #ffffff;
      border: 1px solid #153328;
    }
    .cta-banner-btn-solid:hover {
      background-color: transparent;
      color: #153328;
      border-color: rgba(21, 51, 40, 0.65);
    }
    :global(html.dark) .cta-banner-btn-solid {
      background-color: #D4AF55;
      color: #141210;
      border-color: #D4AF55;
    }
    :global(html.dark) .cta-banner-btn-solid:hover {
      background-color: transparent;
      color: rgba(244, 240, 235, 0.85);
      border-color: rgba(244, 240, 235, 0.30);
    }

    /* Franja de contacto rápido — después del grid de servicios */
    .quick-contact-strip {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1rem;
      margin-top: 2.5rem;
    }

    .quick-contact-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.7rem 1.5rem;
      font-family: "Inter", sans-serif;
      font-size: 0.8rem;
      font-weight: 500;
      letter-spacing: 0.04em;
      text-decoration: none;
      transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
      white-space: nowrap;
    }

    .quick-contact-btn-solid {
      background-color: #153328;
      color: #ffffff;
      border: 1px solid #153328;
    }
    .quick-contact-btn-solid:hover {
      background-color: transparent;
      color: #153328;
      border-color: rgba(21, 51, 40, 0.65);
    }
    :global(html.dark) .quick-contact-btn-solid {
      background-color: #D4AF55;
      color: #141210;
      border-color: #D4AF55;
    }
    :global(html.dark) .quick-contact-btn-solid:hover {
      background-color: transparent;
      color: rgba(244, 240, 235, 0.85);
      border-color: rgba(244, 240, 235, 0.30);
    }

    .quick-contact-btn-outline {
      background-color: transparent;
      color: var(--text-primary);
      border: 1px solid var(--border-secondary);
    }
    .quick-contact-btn-outline:hover {
      background-color: var(--text-primary);
      color: var(--bg-primary);
      border-color: var(--text-primary);
    }
  </style>

  <script>
    (function () {
      const els = document.querySelectorAll('.stat-number');
      if (!els.length) return;

      function animateCounter(el) {
        const target = el.getAttribute('data-target') || '';
        // Núcleo numérico (admite coma de miles y un punto decimal, ej.
        // "5,000+" o "4.9 ★"); todo lo de afuera es prefijo/sufijo literal.
        const match = target.match(/-?\d[\d,]*\.?\d*/);
        if (!match) return;
        const core   = match[0];
        const prefix = target.slice(0, match.index);
        const suffix = target.slice((match.index || 0) + core.length);
        const numStr = core.replace(/,/g, '');
        const end = parseFloat(numStr);
        if (isNaN(end)) return;
        const decimals = (numStr.split('.')[1] || '').length;

        const duration = 1600;
        const start = performance.now();
        const format = (n: number) =>
          n.toLocaleString('es-ES', { minimumFractionDigits: decimals, maximumFractionDigits: decimals });
        el.textContent = prefix + format(0) + suffix;

        function tick(now: number) {
          const elapsed = now - start;
          const progress = Math.min(elapsed / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          const current = end * eased;
          el.textContent = prefix + format(current) + suffix;
          if (progress < 1) requestAnimationFrame(tick);
        }

        requestAnimationFrame(tick);
      }

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              animateCounter(e.target);
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.3 }
      );

      els.forEach((el) => io.observe(el));
    })();
  </script>
</Layout>
