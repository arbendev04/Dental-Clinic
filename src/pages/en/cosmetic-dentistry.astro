---
import Layout from '../../layouts/Layout.astro';
import RelatedArticles from '../../components/blog/RelatedArticles.astro';

const WHATSAPP_PHONE = '34665886439';
const whatsappHref = (text: string) =>
  `https://api.whatsapp.com/send?phone=${WHATSAPP_PHONE}&text=${encodeURIComponent(text)}`;

const steps = [
  {
    title: "Initial assessment and digital smile design",
    description: "We assess your smile with photographs and a 3D scan, and show you a digital simulation of how the result could look before we start.",
  },
  {
    title: "Choosing the treatment",
    description: "Depending on your case and goals, we decide whether whitening, composite veneers, porcelain veneers or a combination is the best fit.",
  },
  {
    title: "Preparing the teeth",
    description: "For veneers, the tooth is prepared with minimal wear and the records needed to make them to measure are taken.",
  },
  {
    title: "Fitting veneers or applying the whitening",
    description: "We fit the final veneers, adjusted to your mouth, or apply the whitening treatment following the indicated protocol.",
  },
  {
    title: "Final adjustments and check-up",
    description: "We review the result, adjust any detail of shape or shine, and give you aftercare guidance to keep it looking good over time.",
  },
];

const faqs = [
  {
    question: "Do veneers damage the tooth?",
    answer: "Porcelain veneers require a minimal, controlled removal of enamel so that they fit well and look natural; composite veneers may need even less preparation, depending on the case. In both cases the aim is to preserve as much healthy tooth as possible.",
  },
  {
    question: "How long do dental veneers last?",
    answer: "With good hygiene and regular check-ups, porcelain veneers usually last more years than composite ones, which in turn are easier to repair or touch up if damaged. The real lifespan varies with each patient's daily care and habits.",
  },
  {
    question: "What is the difference between porcelain and composite veneers?",
    answer: "Porcelain gives a very natural finish and resists staining better over time, but usually takes more than one appointment. Composite is applied and shaped directly on the tooth in a single session, at a lower cost, although it may need touching up sooner than porcelain. We help you choose according to your case and priorities.",
  },
  {
    question: "Is teeth whitening safe?",
    answer: "Carried out at the clinic and supervised by a professional, teeth whitening is a safe procedure. It is normal to notice some temporary sensitivity in the first few days, which usually goes away on its own.",
  },
  {
    question: "Can I combine veneers and whitening?",
    answer: "Yes, and it is quite common: the natural teeth are whitened first and, once the shade has settled, the veneers are made to match that colour. Doing it in this order avoids visible differences in shade between teeth.",
  },
  {
    question: "How much does cosmetic dentistry cost?",
    answer: "The price depends on the chosen treatment (whitening, composite or porcelain veneers) and on the number of teeth to be treated. We give you a specific figure after the initial assessment, which is free.",
  },
  {
    question: "Are veneer results permanent?",
    answer: "Veneers are a long-lasting solution, though not everlasting: over time they may need replacing or maintenance, like any dental restoration. Whitening does need periodic touch-ups to maintain the shade achieved.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "inLanguage": "en",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer,
    },
  })),
};

// No `@id` to the Dentist yet (pending Task 9 of the SEO plan) — the clinic is
// declared inline, same as the ItemList schema on /en/services/.
const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "inLanguage": "en",
  "name": "Cosmetic dentistry",
  "url": "https://arangodentalclinic.es/en/cosmetic-dentistry/",
  "procedureType": "https://schema.org/NoninvasiveProcedure",
  "bodyLocation": "Front teeth (smile)",
  "howPerformed": "Digital smile design from photographs and a 3D scan, followed by teeth whitening, composite veneers or porcelain veneers depending on the case.",
  "provider": {
    "@type": "Dentist",
    "name": "Arango Dental Clinic",
    "url": "https://arangodentalclinic.es",
  },
};
---

<Layout title={"Cosmetic Dentistry in Benidorm | Veneers and Whitening"} description={"Cosmetic dentistry in Benidorm: veneers and teeth whitening with digital smile design. Free initial assessment and personalised quote. Book today."} image="/img/servicios/servicios.webp">
  <script type="application/ld+json" set:html={JSON.stringify(procedureSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- ── Hero ── -->
  <section class="trt-hero" data-scroll-hero>
    <img
      src="/img/servicios/servicios.webp"
      alt="Professional dental instruments at Arango Dental Clinic"
      class="trt-hero-img"
      width="1536"
      height="1024"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="trt-hero-overlay" aria-hidden="true"></div>
    <div class="trt-hero-inner">
      <div class="trt-hero-text">
        <p class="trt-label">Arango Dental Clinic</p>
        <h1 class="trt-hero-title">Cosmetic dentistry in Benidorm</h1>
        <p class="trt-hero-sub">
          If you want to improve the colour, shape or overall look of your smile, cosmetic dentistry combines teeth whitening and veneers to give a natural result tailored to you. At Arango Dental Clinic we design your smile with 3D digital technology and offer a free initial assessment in Benidorm, with an English-speaking team.
        </p>
        <div class="trt-hero-actions">
          <a href={whatsappHref("Hello, I'd like to book a free assessment for cosmetic dentistry")} target="_blank" rel="noopener noreferrer" class="trt-btn trt-btn-solid-hero">Book your free assessment</a>
        </div>
      </div>

      <!-- Same form and same endpoint as the home hero
      (HeroScroll.astro → /api/lead) — own classes with the trt- prefix so
      it does not depend on that component's styles. -->
      <div class="trt-hero-form-panel" id="trt-hero-form-panel">
        <p class="trt-hero-form-eyebrow">Free assessment</p>
        <h2 class="trt-hero-form-title">Take the first step</h2>
        <form id="trt-lead-form" class="trt-hero-form" novalidate>
          <input type="text" id="trt-gotcha" name="_gotcha" class="trt-hero-form-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <input type="text" id="trt-nombre" name="nombre" class="trt-hero-form-input" placeholder="Full name" required />
          <input type="tel" id="trt-telefono" name="telefono" class="trt-hero-form-input" placeholder="Phone" required />
          <input type="email" id="trt-email" name="email" class="trt-hero-form-input" placeholder="Email (optional)" />
          <label class="trt-hero-form-consent">
            <input type="checkbox" id="trt-consentimiento" name="consentimiento" required />
            <span>I accept the <a href="/en/privacy-policy/" target="_blank" rel="noopener">Privacy Policy</a>.</span>
          </label>
          <button type="submit" id="trt-form-submit" class="trt-hero-form-submit">Send</button>
        </form>
        <p id="trt-form-status" class="trt-hero-form-status" role="status" aria-live="polite" hidden></p>
      </div>
    </div>
  </section>

  <!-- ── Content ── -->
  <section class="trt-content-section">
    <div class="trt-container trt-prose">

      <h2>What is cosmetic dentistry and when is it needed?</h2>
      <p>
        Cosmetic dentistry covers the treatments that improve the look of your smile without needing to solve a serious functional problem: the colour of your teeth, small irregularities in shape or wear, or gaps between teeth you would like to close.
      </p>
      <p>
        The two most common treatments are teeth whitening, which lightens the natural shade of the tooth, and veneers, thin shells placed on the visible surface of the tooth to change its shape, colour or apparent alignment without the need for orthodontics.
      </p>
      <p>
        It is recommended when your teeth have darkened over the years because of coffee, tobacco or certain foods; when small chips, wear or irregular shapes bother you when you smile; or simply when you want a specific, visible cosmetic change without going through a long treatment.
      </p>
      <p>
        It does not replace orthodontic treatment if the main problem is the position of your teeth, nor oral rehabilitation if teeth are damaged or missing. We assess it together to make sure the chosen treatment solves what really bothers you about your smile.
      </p>

      <div class="trt-inline-actions">
        <a href="#trt-hero-form-panel" class="trt-btn trt-btn-outline">Go to the form</a>
        <a href={whatsappHref("Hello, I'd like to book a free assessment for cosmetic dentistry")} target="_blank" rel="noopener noreferrer" class="trt-btn trt-btn-solid">Message us on WhatsApp</a>
      </div>

      <h2>How we do it at Arango Dental Clinic</h2>
      <p>
        We start with a digital smile design: using photographs and your 3D intraoral scan, we show you a simulation of how the result could look before you make any decision, here in Benidorm and without silicone impressions.
      </p>
      <p>
        We work with professional whitening as well as composite or porcelain veneers, depending on the goal and the condition of your teeth.
        <!-- CLINIC TO CONFIRM: exact brands and materials of veneers/whitening used by the clinic -->
        We explain the differences between each option clearly before you decide which best fits what you are looking for.
      </p>
      <p>
        When a tooth needs preparing for a veneer, we do it with the minimum wear necessary, keeping as much natural enamel as possible. The aim is always a result that looks natural, not artificial.
      </p>

      <h2>The process, step by step</h2>
      <div class="trt-steps" id="trt-steps">
        {steps.map((step, i) => (
          <details class="trt-step-card" data-step={i} open={i === 0}>
            <summary class="trt-step-card-summary">
              <span class="trt-step-card-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="trt-step-card-title">{step.title}</span>
            </summary>
            <p class="trt-step-card-desc">{step.description}</p>
            <span class="trt-step-card-progress" aria-hidden="true">
              <span class="trt-step-card-progress-bar"></span>
            </span>
          </details>
        ))}
      </div>

      <h2>Price</h2>
      <p>
        The price of a cosmetic dentistry treatment depends on whether you choose whitening, composite veneers, porcelain veneers or a combination, and on the number of teeth involved. That is why we do not give a fixed figure without first assessing your case in person.
      </p>
      <!-- CLINIC TO CONFIRM: guideline fees for cosmetic dentistry; link to /en/prices/ once that page exists -->
      <p>
        We prefer to be clear about this: any figure you see before an in-person assessment is only a guide. At your initial assessment, which is free and without obligation, we look at your 3D scan and give you the real quote, so you know exactly what you need, what you will pay and why.
      </p>

      <h2>Frequently asked questions</h2>
      <div class="trt-faq-list">
        {faqs.map((faq) => (
          <details class="trt-faq-item">
            <summary class="trt-faq-question">{faq.question}</summary>
            <p class="trt-faq-answer">{faq.answer}</p>
          </details>
        ))}
      </div>

      <h2>Book your free assessment</h2>
      <p>
        The first consultation is free and without obligation. We assess your smile with our digital design and explain the cosmetic dentistry options available before you decide anything. We see patients in Benidorm and the surrounding area — La Nucía, Alfaz del Pi, Finestrat, Villajoyosa, Altea and Polop — and also welcome patients from elsewhere in the province of Alicante.
      </p>
      <p>
        You can message us on WhatsApp, call us or simply drop in at the clinic on Avinguda Alfonso Puchades. We speak English, Spanish and French, and reply to WhatsApp messages within 24 hours.
      </p>
      <p>
        See also our <a href="/en/services/">other dental services</a> if, besides cosmetic dentistry, you want to take care of other needs for your smile.
      </p>

    </div>
  </section>

  <RelatedArticles lang="en" service="estetica-dental" />

  <!-- ── Final CTA ── -->
  <section class="trt-cta-section">
    <div class="trt-container trt-cta-inner">
      <h2 class="trt-cta-title">Arango Dental Clinic, your cosmetic dentistry clinic in Benidorm</h2>
      <p class="trt-cta-sub">Avinguda Alfonso Puchades, 22, bajo, Benidorm, Alicante 03501</p>
      <div class="trt-cta-actions">
        <a href="tel:+34965088282" class="trt-btn trt-btn-outline">Call: 965 08 82 82</a>
        <a href={whatsappHref("Hello, I'd like to book a free assessment for cosmetic dentistry")} target="_blank" rel="noopener noreferrer" class="trt-btn trt-btn-solid">Message us on WhatsApp</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── Layout ── */
  .trt-container {
    max-width: 1200px;
    margin: 0 auto;
    padding-left: 2rem;
    padding-right: 2rem;
  }

  /* ── Hero ── */
  .trt-hero {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: #0d2219;
    text-align: center;
  }

  :global(html.dark) .trt-hero {
    background-color: #0d2219;
  }

  .trt-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    display: block;
  }

  .trt-hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(6, 18, 10, 0.72) 0%,
        rgba(6, 18, 10, 0.48) 50%,
        rgba(6, 18, 10, 0.72) 100%
      );
  }

  :global(html.dark) .trt-hero-overlay {
    background:
      linear-gradient(
        180deg,
        rgba(4, 12, 7, 0.82) 0%,
        rgba(4, 12, 7, 0.55) 50%,
        rgba(4, 12, 7, 0.82) 100%
      );
  }

  /* The hero no longer uses .trt-container: it is full-bleed (like the home hero)
     with its own side padding — so the form's 35% is calculated on the real
     screen width, as in HeroScroll.astro, instead of on the max-width:1200px
     that does apply to the rest of the page content. */
  .trt-hero-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
    padding: 7rem 2rem 4rem;
    box-sizing: border-box;
  }

  .trt-hero-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  /* Desktop: text on the left, form on the right — no longer centred
     in a single column. */
  @media (min-width: 900px) {
    .trt-hero-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 3rem;
      text-align: left;
      padding-left: 6%;
      padding-right: 4%;
    }

    .trt-hero-text {
      align-items: flex-start;
      text-align: left;
      flex: 1 1 auto;
      max-width: 560px;
    }
  }

  .trt-label {
    font-family: "Inter", sans-serif;
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #C49B38;
  }

  :global(html.dark) .trt-label {
    color: #D4AF55;
  }

  .trt-hero-title {
    font-family: "Cormorant Garamond", serif;
    font-size: clamp(2.4rem, 5.5vw, 4rem);
    font-weight: 300;
    font-style: italic;
    line-height: 1.15;
    color: rgba(244, 240, 235, 0.95);
    margin: 0;
  }

  .trt-hero-sub {
    font-family: "Inter", sans-serif;
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(244, 240, 235, 0.65);
    max-width: 62ch;
    margin: 0;
  }

  .trt-hero-actions {
    margin-top: 0.5rem;
  }

  /* ── Hero form — same fields and same endpoint as the home hero
     (HeroScroll.astro), with the same visual treatment (semi-transparent
     panel + light blur, fields with their own opaque background). Tones
     adjusted to this page's green (#0d2219) instead of the home's. */
  .trt-hero-form-panel {
    width: 100%;
    max-width: 380px;
    padding: 1.5rem 1.5rem 1.75rem;
    background-color: rgba(13, 34, 25, 0.45);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid rgba(244, 240, 235, 0.14);
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.3);
    text-align: left;
  }

  /* Same relative width as the home hero panel: 35% of the hero,
     not a fixed width — hence the max-width is also removed. */
  @media (min-width: 900px) {
    .trt-hero-form-panel {
      /* 39% here gives the same pixel width as the home hero's 35%
         (~500px at a 1440px viewport) — the difference is because this
         panel subtracts its own padding/gap from the calculation (border-box)
         and the home one does not, being position:absolute. Tuned by eye so
         it matches in real pixels, not just in the percentage number. */
      flex: 0 0 39%;
      max-width: none;
      padding: 2.75rem 2.5rem;
    }
  }

  .trt-hero-form-eyebrow {
    font-family: "Inter", sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #C49B38;
    margin: 0 0 0.5rem;
  }

  :global(html.dark) .trt-hero-form-eyebrow {
    color: #D4AF55;
  }

  .trt-hero-form-title {
    font-family: "Cormorant Garamond", serif;
    font-size: 1.5rem;
    font-weight: 400;
    color: rgba(244, 240, 235, 0.95);
    margin: 0 0 1rem;
  }

  .trt-hero-form {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .trt-hero-form-honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .trt-hero-form-input {
    width: 100%;
    padding: 0.75rem 0.9rem;
    font-family: "Inter", sans-serif;
    font-size: 0.88rem;
    color: rgba(244, 240, 235, 0.95);
    background-color: #142720;
    border: 1px solid rgba(244, 240, 235, 0.2);
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .trt-hero-form-input::placeholder {
    color: rgba(244, 240, 235, 0.45);
  }

  .trt-hero-form-input:focus {
    outline: none;
    border-color: #D4AF55;
    background-color: #1b3229;
  }

  .trt-hero-form-consent {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    font-family: "Inter", sans-serif;
    font-size: 0.7rem;
    line-height: 1.4;
    color: rgba(244, 240, 235, 0.6);
    cursor: pointer;
  }

  .trt-hero-form-consent input {
    margin-top: 0.15rem;
    flex-shrink: 0;
  }

  .trt-hero-form-consent a {
    color: rgba(244, 240, 235, 0.85);
    text-decoration: underline;
  }

  .trt-hero-form-submit {
    margin-top: 0.2rem;
    padding: 0.8rem 1rem;
    font-family: "Inter", sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #0d2219;
    background-color: #C49B38;
    border: none;
    cursor: pointer;
    transition: background-color 0.25s ease;
  }

  .trt-hero-form-submit:hover:not(:disabled) {
    background-color: #D4AF55;
  }

  .trt-hero-form-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .trt-hero-form-status {
    font-family: "Inter", sans-serif;
    font-size: 0.8rem;
    margin-top: 0.8rem;
    color: rgba(244, 240, 235, 0.85);
  }

  .trt-hero-form-status-error {
    color: #e5a3a3;
  }

  /* ── Prose ── */
  .trt-content-section {
    background-color: var(--bg-primary);
    padding: 4.5rem 0 5rem;
  }

  .trt-prose {
    max-width: 760px;
  }

  .trt-prose h2 {
    font-family: "Cormorant Garamond", serif;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 500;
    color: var(--text-primary);
    margin: 3rem 0 1.1rem;
  }

  .trt-prose h2:first-of-type {
    margin-top: 0;
  }

  .trt-prose p {
    font-family: "Inter", sans-serif;
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--text-secondary);
    margin: 0 0 1.1rem;
  }

  .trt-prose a {
    color: var(--teal-600);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ── Steps — interactive cards with auto-advance (see the script at the end
     of the file). Each step is a native <details> (the same element the FAQ
     uses, further down) to get focus/keyboard/semantics for free; the script
     decides which one stays open and does not rely on the browser handling
     the accordion by itself, because only one card must be open at a time. ── */
  .trt-steps {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .trt-step-card {
    position: relative;
    overflow: hidden;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-primary);
    border-left: 3px solid var(--border-primary);
    padding: 1.1rem 1.35rem;
    transition: border-color 0.3s ease, background-color 0.3s ease;
  }

  /* Active (open) or hovered: same treatment — a tint of the theme colour
     (green in light, gold in dark) at very low opacity, so it is noticeable
     without dominating the card. */
  .trt-step-card[open],
  .trt-step-card:hover {
    border-left-color: var(--teal-600);
    background-color: color-mix(in srgb, var(--teal-600) 15%, var(--bg-secondary));
  }

  :global(html.dark) .trt-step-card[open],
  :global(html.dark) .trt-step-card:hover {
    border-left-color: #D4AF55;
    background-color: color-mix(in srgb, #D4AF55 15%, var(--bg-secondary));
  }

  .trt-step-card-summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .trt-step-card-summary::-webkit-details-marker {
    display: none;
  }

  .trt-step-card-num {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.35rem;
    height: 2.35rem;
    border-radius: 50%;
    border: 1px solid var(--border-secondary);
    font-family: "Cormorant Garamond", serif;
    font-size: 1rem;
    color: var(--text-tertiary);
    transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease;
  }

  .trt-step-card[open] .trt-step-card-num,
  .trt-step-card:hover .trt-step-card-num {
    background-color: var(--teal-600);
    border-color: var(--teal-600);
    color: var(--bg-primary);
  }

  :global(html.dark) .trt-step-card[open] .trt-step-card-num,
  :global(html.dark) .trt-step-card:hover .trt-step-card-num {
    background-color: #D4AF55;
    border-color: #D4AF55;
    color: #141210;
  }

  .trt-step-card-title {
    font-family: "Inter", sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .trt-step-card-desc {
    font-family: "Inter", sans-serif;
    font-size: 0.875rem;
    line-height: 1.7;
