---
import Layout from '../../layouts/Layout.astro';
import { CLINIC_ID } from '../../data/i18n';
import RelatedArticles from '../../components/blog/RelatedArticles.astro';

const WHATSAPP_PHONE = '34665886439';
const whatsappHref = (text: string) =>
  `https://api.whatsapp.com/send?phone=${WHATSAPP_PHONE}&text=${encodeURIComponent(text)}`;

const steps = [
  {
    title: "Periodontal assessment and gum probing",
    description: "We measure the depth of the gum around each tooth and check for bleeding, inflammation or bone loss.",
  },
  {
    title: "Deep cleaning (scaling and root planing)",
    description: "We remove the plaque and tartar built up below the gum line, smoothing the root so the gum can reattach to the tooth.",
  },
  {
    title: "Controlling inflammation and infection",
    description: "We review how the gum responds after the deep clean and assess whether any additional treatment is needed to control the infection.",
  },
  {
    title: "Periodontal maintenance check-ups",
    description: "We schedule regular check-ups to make sure the gum stays healthy and to catch any relapse in time.",
  },
  {
    title: "Gum surgery, if necessary",
    description: "In more advanced cases, we assess whether surgical treatment is needed to reach deeper areas or regenerate lost tissue.",
  },
];

const faqs = [
  {
    question: "Why do my gums bleed when I brush?",
    answer: "Bleeding when you brush is usually the first sign of gingivitis, an inflammation of the gum caused by a build-up of bacterial plaque. If treated in time, it is reversible with a good clean and daily hygiene.",
  },
  {
    question: "What is periodontitis?",
    answer: "Periodontitis is a more advanced stage of gum disease, in which the infection also affects the bone that supports the tooth. If left untreated, it can cause teeth to loosen or even be lost.",
  },
  {
    question: "Can gum disease be cured?",
    answer: "Gingivitis, in its early stage, can usually be reversed with a professional clean and good daily hygiene. Periodontitis cannot be fully \"cured\" once there is bone loss, but it can be controlled and its progress halted with treatment and regular maintenance.",
  },
  {
    question: "Does periodontal treatment hurt?",
    answer: "The deep clean is carried out under local anaesthetic when necessary, so it should not hurt during the procedure. It is normal to feel some sensitivity in the gum in the following days.",
  },
  {
    question: "How often should I have periodontal maintenance?",
    answer: "It depends on how your case evolves, but in general a check-up every three to six months is recommended once you have had gum disease, compared with the usual yearly check-up for a patient with no history.",
  },
  {
    question: "Does periodontitis affect dental implants?",
    answer: "Yes. If the gums are not healthy before an implant is placed, the risk of the tissue around the implant becoming infected also increases. That is why, if you have a history of periodontitis, we treat the gum first before considering any implant.",
  },
  {
    question: "How much does periodontal treatment cost?",
    answer: "The price depends on the stage of the disease and the number of deep-cleaning sessions you need. We give you a specific figure after the initial assessment, which is free.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "inLanguage": "en",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer,
    },
  })),
};

// The provider is the clinic, referenced by its @id (CLINIC_ID, see src/data/i18n.ts):
// the full Dentist block is emitted by the Layout on every page.
const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "inLanguage": "en",
  "name": "Periodontics (gum treatment)",
  "url": "https://arangodentalclinic.es/en/gum-treatment/",
  "procedureType": "https://schema.org/NoninvasiveProcedure",
  "bodyLocation": "Gums and periodontal tissue",
  "howPerformed": "Assessment with periodontal probing, deep cleaning by scaling and root planing, and regular maintenance check-ups to control gum disease.",
  "provider": { "@id": CLINIC_ID },
};
---

<Layout title={"Gum Disease Treatment in Benidorm | Healthy Gums"} description={"Gum disease treatment in Benidorm for bleeding or inflamed gums. Free initial assessment and personalised quote. Book today."} image="/img/servicios/servicios.webp">
  <script type="application/ld+json" set:html={JSON.stringify(procedureSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- ── Hero ── -->
  <section class="trt-hero" data-scroll-hero>
    <img
      src="/img/servicios/servicios.webp"
      alt="Professional dental instruments at Arango Dental Clinic"
      class="trt-hero-img"
      width="1536"
      height="1024"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="trt-hero-overlay" aria-hidden="true"></div>
    <div class="trt-hero-inner">
      <div class="trt-hero-text">
        <p class="trt-label">Arango Dental Clinic</p>
        <h1 class="trt-hero-title">Gum disease treatment in Benidorm</h1>
        <p class="trt-hero-sub">
          If your gums bleed, are swollen or you notice them receding over time, periodontal treatment can stop the problem before it affects your teeth. At Arango Dental Clinic we assess your gums with a free initial assessment in Benidorm.
        </p>
        <div class="trt-hero-actions">
          <a href={whatsappHref("Hello, I'd like to book a free assessment for gum treatment")} target="_blank" rel="noopener noreferrer" class="trt-btn trt-btn-solid-hero">Book your free assessment</a>
        </div>
      </div>

      <!-- Same form and same endpoint as the home hero
      (HeroScroll.astro → /api/lead) — own classes with the trt- prefix so
      it does not depend on that component's styles. -->
      <div class="trt-hero-form-panel" id="trt-hero-form-panel">
        <p class="trt-hero-form-eyebrow">Free assessment</p>
        <h2 class="trt-hero-form-title">Take the first step</h2>
        <form id="trt-lead-form" class="trt-hero-form" novalidate>
          <input type="text" id="trt-gotcha" name="_gotcha" class="trt-hero-form-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <input type="text" id="trt-nombre" name="nombre" class="trt-hero-form-input" placeholder="Full name" required />
          <input type="tel" id="trt-telefono" name="telefono" class="trt-hero-form-input" placeholder="Phone" required />
          <input type="email" id="trt-email" name="email" class="trt-hero-form-input" placeholder="Email (optional)" />
          <label class="trt-hero-form-consent">
            <input type="checkbox" id="trt-consentimiento" name="consentimiento" required />
            <span>I accept the <a href="/en/privacy-policy/" target="_blank" rel="noopener">Privacy Policy</a>.</span>
          </label>
          <button type="submit" id="trt-form-submit" class="trt-hero-form-submit">Send</button>
        </form>
        <p id="trt-form-status" class="trt-hero-form-status" role="status" aria-live="polite" hidden></p>
      </div>
    </div>
  </section>

  <!-- ── Content ── -->
  <section class="trt-content-section">
    <div class="trt-container trt-prose">

      <h2>What is periodontics and when is it needed?</h2>
      <p>
        Periodontics is the branch of dentistry that deals with the health of the gums and the tissue that supports the teeth: the bone and fibres that hold them firmly in place. When that tissue becomes inflamed or infected, we speak of periodontal (gum) disease.
      </p>
      <p>
        It has two main stages. Gingivitis is the mildest: the gum becomes inflamed and may bleed, but the bone has not yet been affected. If left untreated, it can progress to periodontitis, where the infection also reaches the bone that holds the tooth and can make it loosen over time.
      </p>
      <p>
        It is advisable to have your gums assessed when you notice bleeding when brushing or flossing, swelling or redness, persistent bad breath, gums receding so the tooth looks longer, or a loose tooth. The sooner it is detected, the easier it is to control.
      </p>
      <p>
        Periodontics does not replace daily hygiene: cleaning at home and professional check-ups work together. A good brushing and flossing routine greatly reduces the risk of gum disease appearing or coming back.
      </p>

      <div class="trt-inline-actions">
        <a href="#trt-hero-form-panel" class="trt-btn trt-btn-outline">Go to the form</a>
        <a href={whatsappHref("Hello, I'd like to book a free assessment for gum treatment")} target="_blank" rel="noopener noreferrer" class="trt-btn trt-btn-solid">Message us on WhatsApp</a>
      </div>

      <h2>How we do it at Arango Dental Clinic</h2>
      <p>
        We start with periodontal probing, which measures the depth of the gum around each tooth, here in Benidorm, so we know exactly what stage the disease is at before proposing treatment.
      </p>
      <p>
        The core treatment is a deep clean below the gum line, known as scaling and root planing, which removes the plaque and tartar that daily cleaning cannot reach.
        <!-- CLINIC TO CONFIRM: specific periodontal maintenance protocol or technique used by the clinic -->
        We then assess how the gum responds and decide with you whether additional sessions or more frequent maintenance check-ups are needed.
      </p>
      <p>
        In the most advanced cases, where there is already significant bone loss, we assess whether a more specific periodontal procedure is needed to reach deeper areas.
      </p>

      <h2>The process, step by step</h2>
      <div class="trt-steps" id="trt-steps">
        {steps.map((step, i) => (
          <details class="trt-step-card" data-step={i} open={i === 0}>
            <summary class="trt-step-card-summary">
              <span class="trt-step-card-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="trt-step-card-title">{step.title}</span>
            </summary>
            <p class="trt-step-card-desc">{step.description}</p>
            <span class="trt-step-card-progress" aria-hidden="true">
              <span class="trt-step-card-progress-bar"></span>
            </span>
          </details>
        ))}
      </div>

      <h2>Price</h2>
      <p>
        The price of periodontal treatment depends on the stage of the disease and on the number of deep-cleaning sessions or check-ups you need. That is why we do not give a fixed figure without first assessing your case in person.
      </p>
      <!-- CLINIC TO CONFIRM: guideline fees for gum treatment; link to /en/prices/ once that page exists -->
      <p>
        We prefer to be clear about this: any figure you see before an in-person assessment is only a guide. At your initial assessment, which is free and without obligation, we carry out the periodontal probing and give you the real quote, so you know exactly what you need, what you will pay and why.
      </p>

      <h2>Frequently asked questions</h2>
      <div class="trt-faq-list">
        {faqs.map((faq) => (
          <details class="trt-faq-item">
            <summary class="trt-faq-question">{faq.question}</summary>
            <p class="trt-faq-answer">{faq.answer}</p>
          </details>
        ))}
      </div>

      <h2>Book your free assessment</h2>
      <p>
        The first consultation is free and without obligation. We assess the condition of your gums with periodontal probing and explain the most suitable treatment plan before you decide anything. We see patients in Benidorm and the surrounding area — La Nucía, Alfaz del Pi, Finestrat, Villajoyosa, Altea and Polop — and also welcome patients from elsewhere in the province of Alicante.
      </p>
      <p>
        You can message us on WhatsApp, call us or simply drop in at the clinic on Avinguda Alfonso Puchades. We reply to WhatsApp messages within 24 hours.
      </p>
      <p>
        See also our <a href="/en/services/">other dental services</a> if, besides gum treatment, you want to take care of other needs for your smile.
      </p>

    </div>
  </section>

  <RelatedArticles lang="en" service="periodoncia" />

  <!-- ── Final CTA ── -->
  <section class="trt-cta-section">
    <div class="trt-container trt-cta-inner">
      <h2 class="trt-cta-title">Arango Dental Clinic, your gum treatment clinic in Benidorm</h2>
      <p class="trt-cta-sub">Avinguda Alfonso Puchades, 22, bajo, Benidorm, Alicante 03501</p>
      <div class="trt-cta-actions">
        <a href="tel:+34965088282" class="trt-btn trt-btn-outline">Call: 965 08 82 82</a>
        <a href={whatsappHref("Hello, I'd like to book a free assessment for gum treatment")} target="_blank" rel="noopener noreferrer" class="trt-btn trt-btn-solid">Message us on WhatsApp</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── Layout ── */
  .trt-container {
    max-width: 1200px;
    margin: 0 auto;
    padding-left: 2rem;
    padding-right: 2rem;
  }

  /* ── Hero ── */
  .trt-hero {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: #0d2219;
    text-align: center;
  }

  :global(html.dark) .trt-hero {
    background-color: #0d2219;
  }

  .trt-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    display: block;
  }

  .trt-hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(6, 18, 10, 0.72) 0%,
        rgba(6, 18, 10, 0.48) 50%,
        rgba(6, 18, 10, 0.72) 100%
      );
  }

  :global(html.dark) .trt-hero-overlay {
    background:
      linear-gradient(
        180deg,
        rgba(4, 12, 7, 0.82) 0%,
        rgba(4, 12, 7, 0.55) 50%,
        rgba(4, 12, 7, 0.82) 100%
      );
  }

  /* The hero no longer uses .trt-container: it is full-bleed (like the home hero)
     with its own side padding — so the form's 35% is calculated on the real
     screen width, as in HeroScroll.astro, instead of on the max-width:1200px
     that does apply to the rest of the page content. */
  .trt-hero-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
    padding: 7rem 2rem 4rem;
    box-sizing: border-box;
  }

  .trt-hero-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  /* Desktop: text on the left, form on the right — no longer centred
     in a single column. */
  @media (min-width: 900px) {
    .trt-hero-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 3rem;
      text-align: left;
      padding-left: 6%;
      padding-right: 4%;
    }

    .trt-hero-text {
      align-items: flex-start;
      text-align: left;
      flex: 1 1 auto;
      max-width: 560px;
    }
  }

  .trt-label {
    font-family: "Inter", sans-serif;
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #C49B38;
  }

  :global(html.dark) .trt-label {
    color: #D4AF55;
  }

  .trt-hero-title {
    font-family: "Cormorant Garamond", serif;
    font-size: clamp(2.4rem, 5.5vw, 4rem);
    font-weight: 300;
    font-style: italic;
    line-height: 1.15;
    color: rgba(244, 240, 235, 0.95);
    margin: 0;
  }

  .trt-hero-sub {
    font-family: "Inter", sans-serif;
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(244, 240, 235, 0.65);
    max-width: 62ch;
    margin: 0;
  }

  .trt-hero-actions {
    margin-top: 0.5rem;
  }

  /* ── Hero form — same fields and same endpoint as the home hero
     (HeroScroll.astro), with the same visual treatment (semi-transparent
     panel + light blur, fields with their own opaque background). Tones
     adjusted to this page's green (#0d2219) instead of the home's. */
  .trt-hero-form-panel {
    width: 100%;
    max-width: 380px;
    padding: 1.5rem 1.5rem 1.75rem;
    background-color: rgba(13, 34, 25, 0.45);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid rgba(244, 240, 235, 0.14);
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.3);
    text-align: left;
  }

  /* Same relative width as the home hero panel: 35% of the hero,
     not a fixed width — hence the max-width is also removed. */
  @media (min-width: 900px) {
    .trt-hero-form-panel {
      /* 39% here gives the same pixel width as the home hero's 35%
         (~500px at a 1440px viewport) — the difference is because this
         panel subtracts its own padding/gap from the calculation (border-box)
         and the home one does not, being position:absolute. Tuned by eye so
         it matches in real pixels, not just in the percentage number. */
      flex: 0 0 39%;
      max-width: none;
      padding: 2.75rem 2.5rem;
    }
  }

  .trt-hero-form-eyebrow {
    font-family: "Inter", sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #C49B38;
    margin: 0 0 0.5rem;
  }

  :global(html.dark) .trt-hero-form-eyebrow {
    color: #D4AF55;
  }

  .trt-hero-form-title {
    font-family: "Cormorant Garamond", serif;
    font-size: 1.5rem;
    font-weight: 400;
    color: rgba(244, 240, 235, 0.95);
    margin: 0 0 1rem;
  }

  .trt-hero-form {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .trt-hero-form-honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .trt-hero-form-input {
    width: 100%;
    padding: 0.75rem 0.9rem;
    font-family: "Inter", sans-serif;
    font-size: 0.88rem;
    color: rgba(244, 240, 235, 0.95);
    background-color: #142720;
    border: 1px solid rgba(244, 240, 235, 0.2);
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .trt-hero-form-input::placeholder {
    color: rgba(244, 240, 235, 0.45);
  }

  .trt-hero-form-input:focus {
    outline: none;
    border-color: #D4AF55;
    background-color: #1b3229;
  }

  .trt-hero-form-consent {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    font-family: "Inter", sans-serif;
    font-size: 0.7rem;
    line-height: 1.4;
    color: rgba(244, 240, 235, 0.6);
    cursor: pointer;
  }

  .trt-hero-form-consent input {
    margin-top: 0.15rem;
    flex-shrink: 0;
  }

  .trt-hero-form-consent a {
    color: rgba(244, 240, 235, 0.85);
    text-decoration: underline;
  }

  .trt-hero-form-submit {
    margin-top: 0.2rem;
    padding: 0.8rem 1rem;
    font-family: "Inter", sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #0d2219;
    background-color: #C49B38;
    border: none;
    cursor: pointer;
    transition: background-color 0.25s ease;
  }

  .trt-hero-form-submit:hover:not(:disabled) {
    background-color: #D4AF55;
  }

  .trt-hero-form-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .trt-hero-form-status {
    font-family: "Inter", sans-serif;
    font-size: 0.8rem;
    margin-top: 0.8rem;
    color: rgba(244, 240, 235, 0.85);
  }

  .trt-hero-form-status-error {
    color: #e5a3a3;
  }

  /* ── Prose ── */
  .trt-content-section {
    background-color: var(--bg-primary);
    padding: 4.5rem 0 5rem;
  }

  .trt-prose {
    max-width: 760px;
  }

  .trt-prose h2 {
    font-family: "Cormorant Garamond", serif;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 500;
    color: var(--text-primary);
    margin: 3rem 0 1.1rem;
  }

  .trt-prose h2:first-of-type {
    margin-top: 0;
  }

  .trt-prose p {
    font-family: "Inter", sans-serif;
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--text-secondary);
    margin: 0 0 1.1rem;
  }

  .trt-prose a {
    color: var(--teal-600);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ── Steps — interactive cards with auto-advance (see the script at the end
     of the file). Each step is a native <details> (the same element the FAQ
     uses, further down) to get focus/keyboard/semantics for free; the script
     decides which one stays open and does not rely on the browser handling
     the accordion by itself, because only one card must be open at a time. ── */
  .trt-steps {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .trt-step-card {
    position: relative;
    overflow: hidden;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-primary);
    border-left: 3px solid var(--border-primary);
    padding: 1.1rem 1.35rem;
    transition: border-color 0.3s ease, background-color 0.3s ease;
  }

  /* Active (open) or hovered: same treatment — a tint of the theme colour
     (green in light, gold in dark) at very low opacity, so it is noticeable
     without dominating the card. */
  .trt-step-card[open],
  .trt-step-card:hover {
    border-left-color: var(--teal-600);
    background-color: color-mix(in srgb, var(--teal-600) 15%, var(--bg-secondary));
  }

  :global(html.dark) .trt-step-card[open],
  :global(html.dark) .trt-step-card:hover {
    border-left-color: #D4AF55;
    background-color: color-mix(in srgb, #D4AF55 15%, var(--bg-secondary));
  }

  .trt-step-card-summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .trt-step-card-summary::-webkit-details-marker {
    display: none;
  }

  .trt-step-card-num {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.35rem;
    height: 2.35rem;
    border-radius: 50%;
    border: 1px solid var(--border-secondary);
    font-family: "Cormorant Garamond", serif;
    font-size: 1rem;
    color: var(--text-tertiary);
    transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease;
  }

  .trt-step-card[open] .trt-step-card-num,
  .trt-step-card:hover .trt-step-card-num {
    background-color: var(--teal-600);
    border-color: var(--teal-600);
    color: var(--bg-primary);
  }

  :global(html.dark) .trt-step-card[open] .trt-step-card-num,
  :global(html.dark) .trt-step-card:hover .trt-step-card-num {
    background-color: #D4AF55;
    border-color: #D4AF55;
    color: #141210;
  }

  .trt-step-card-title {
    font-family: "Inter", sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .trt-step-card-desc {
    font-family: "Inter", sans-serif;
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin: 0.9rem 0 0;
    padding-left: calc(2.35rem + 1rem);
  }

  /* Closed: no visible <p> (native display:none of <details>) — the script
     only toggles the `open` attribute, this transition is purely visual
     for when it IS open. */
  .trt-step-card:not([open]) .trt-step-card-summary {
    opacity: 0.75;
  }

