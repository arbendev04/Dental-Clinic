</Layout>

<style>
  .lgl-container {
    max-width: 1200px;
    margin: 0 auto;
    padding-left: 2rem;
    padding-right: 2rem;
  }

  /* ── Header ── */
  .lgl-hero {
    background-color: #0d2219;
    padding: 8rem 0 3.5rem;
    text-align: center;
  }

  :global(html.dark) .lgl-hero {
    background-color: #0d2219;
  }

  .lgl-label {
    font-family: "Inter", sans-serif;
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #C49B38;
    margin: 0 0 1rem;
  }

  :global(html.dark) .lgl-label {
    color: #D4AF55;
  }

  .lgl-hero-title {
    font-family: "Cormorant Garamond", serif;
    font-size: clamp(2.4rem, 4.5vw, 3.5rem);
    font-weight: 300;
    font-style: italic;
    color: rgba(244, 240, 235, 0.95);
    margin: 0;
  }

  /* ── Prose ── */
  .lgl-content-section {
    background-color: var(--bg-primary);
    padding: 4.5rem 0 6rem;
  }

  .lgl-prose {
    max-width: 760px;
  }

  .lgl-prose h2 {
    font-family: "Cormorant Garamond", serif;
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--text-primary);
    margin: 2.5rem 0 1rem;
  }

  .lgl-prose h2:first-of-type {
    margin-top: 0;
  }

  .lgl-prose p {
    font-family: "Inter", sans-serif;
    font-size: 0.9rem;
    line-height: 1.75;
    color: var(--text-secondary);
    margin: 0 0 1.1rem;
  }

  .lgl-prose ul {
    font-family: "Inter", sans-serif;
    font-size: 0.9rem;
    line-height: 1.8;
    color: var(--text-secondary);
    margin: 0 0 1.1rem;
    padding-left: 1.25rem;
  }

  .lgl-prose li {
    margin-bottom: 0.35rem;
  }

  .lgl-prose a {
    color: var(--teal-600);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .lgl-updated {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-primary);
    font-size: 0.8rem;
    color: var(--text-tertiary);
  }

  .lgl-prose .lgl-note {
    padding: 0.9rem 1.1rem;
    margin-bottom: 1.75rem;
    border-left: 2px solid var(--gold-500);
    background-color: var(--bg-secondary);
  }
</style>
