---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Legal Notice" description="Legal notice of Arango Dental Clinic: identification details, conditions of access and use of the website, intellectual property and applicable jurisdiction.">

  <!-- ── Header ── -->
  <section class="lgl-hero">
    <div class="lgl-container">
      <p class="lgl-label">Arango Dental Clinic</p>
      <h1 class="lgl-hero-title">Legal Notice</h1>
    </div>
  </section>

  <!-- ── Content ── -->
  <section class="lgl-content-section">
    <div class="lgl-container lgl-prose">

      <p class="lgl-note">
        <em>This is a courtesy translation of the Spanish version; in case of any discrepancy, the Spanish version prevails.</em>
        <a href="/aviso-legal/" hreflang="es" lang="es">Read the Spanish version</a>.
      </p>

      <p>
        In compliance with the duty to provide information set out in Article 10 of Spanish Law 34/2002 of 11 July
        on Information Society Services and Electronic Commerce (LSSI-CE), the identification details of the owner
        of this website are set out below.
      </p>

      <h2>1. Identification details</h2>
      <ul>
        <li><strong>Trade name:</strong> Arango Dental Clinic</li>
        <li><strong>Company name:</strong> Arango Dental SL</li>
        <li><strong>Tax ID (CIF):</strong> B19375971</li>
        <li><strong>Professional registration number:</strong> 03003716 (Ilustre Colegio Oficial de Odontólogos y Estomatólogos de Alicante — COEA, the Official College of Dentists and Stomatologists of Alicante)</li>
