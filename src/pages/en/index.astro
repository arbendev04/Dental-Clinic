                    <span>{service.anchor}</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                  </a>
                  <a href={waHref} target="_blank" rel="noopener" class="services-whatsapp-btn" aria-label={`Message us on WhatsApp about ${service.title}`}>
                    <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                    <span>Contact us</span>
                  </a>
                </div>
              </div>
            );
          })}
        </div>

        <div class="services-carousel-nav">
          <button type="button" class="services-arrow" id="services-prev" aria-label="Previous service">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
          </button>
          <button type="button" class="services-arrow" id="services-next" aria-label="Next service">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </button>
        </div>
      </div>

      <!-- Quick contact strip -->
      <div class="quick-contact-strip">
        <a href="/en/contact/#contact-form" class="quick-contact-btn quick-contact-btn-solid">Book an Appointment</a>
        <a href="https://wa.me/34665886439?text=Hello%2C%20I'd%20like%20to%20book%20an%20appointment%20at%20Arango%20Dental%20Clinic" target="_blank" rel="noopener" class="quick-contact-btn quick-contact-btn-outline">
          <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Contact us
        </a>
        <a href="tel:+34965088282" class="quick-contact-btn quick-contact-btn-outline">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 3H6.22a1 1 0 01.948.684L8.665 8.18a1 1 0 01-.25 1.033l-1.204 1.204a11.05 11.05 0 005.373 5.373l1.204-1.204a1 1 0 011.033-.25l4.492 1.498a1 1 0 01.684.949V19.5a2.5 2.5 0 01-2.5 2.5h-1C7.888 22 2 16.112 2 8.5v-1z" /></svg>
          965 08 82 82
        </a>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="px-5 lg:px-20 py-16 md:py-24 transition-colors" style="background-color: var(--bg-primary);">
    <div class="container mx-auto">
      <!-- Section Header -->
      <div class="text-center mb-10 md:mb-16">
        <div class="flex items-center justify-center gap-3 mb-4">
          <div class="w-8 h-px" style="background-color: var(--gold-500);"></div>
          <span class="text-[0.65rem] tracking-[0.2em] uppercase font-medium" style="color: var(--gold-600);">
            In Numbers
          </span>
          <div class="w-8 h-px" style="background-color: var(--gold-500);"></div>
        </div>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-normal" style="font-family: 'Cormorant Garamond', serif; color: var(--text-primary);">
          A Legacy of Care
        </h2>
      </div>

      <!-- Stats Grid -->
      <div class="flex flex-wrap justify-center gap-12 md:gap-24">
        {stats.map((stat) => (
          <div class="flex flex-col items-center gap-3">
            <div class="text-6xl md:text-8xl font-light stat-number" style="font-family: 'Cormorant Garamond', serif;" data-target={stat.number}>
              {stat.number}
            </div>
            <div class="text-xs md:text-sm font-medium uppercase text-center" style="color: var(--text-secondary); letter-spacing: 0.15em;">
              {stat.label}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="px-5 lg:px-20 py-16 md:py-24 transition-colors" style="background-color: var(--bg-secondary);">
    <div class="container mx-auto">
      <!-- Section Header -->
      <div class="text-center mb-10 md:mb-16">
        <div class="flex items-center justify-center gap-3 mb-4">
          <div class="w-8 h-px" style="background-color: var(--gold-500);"></div>
          <span class="text-[0.65rem] tracking-[0.2em] uppercase font-medium" style="color: var(--gold-600);">
            Testimonials
          </span>
          <div class="w-8 h-px" style="background-color: var(--gold-500);"></div>
        </div>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-normal" style="font-family: 'Cormorant Garamond', serif; color: var(--text-primary);">
          What Our Patients Say
        </h2>
      </div>

      <!-- Google reviews (EmbedSocial) — lazy load: the widget for the active
           theme is only injected when the section enters the viewport. Before,
           both (light and dark) were always mounted, even if one stayed
           display:none — which duplicated every EmbedSocial script/iframe
           from the initial page load. -->
      <div id="reviews-container" class="reviews-widget">
        <div id="reviews-skeleton" class="reviews-skeleton" aria-hidden="true">
          <div class="reviews-skeleton-card"></div>
          <div class="reviews-skeleton-card"></div>
          <div class="reviews-skeleton-card"></div>
        </div>
      </div>

      <script>
        (function () {
          const LIGHT_REF = 'ce0db3de6c56bf3c7a637ce470f75bef38fa2ee0';
          const DARK_REF = '23f82d3fea76f664349985cb3ed7d64ef9e26cab';
          const SCRIPT_ID = 'EmbedSocialHashtagScript';

          const container = document.getElementById('reviews-container');
          if (!container) return;

          let loaded = false;
          let loadedRef: string | null = null;

          function isDark() {
            return document.documentElement.classList.contains('dark');
          }

          function activeRef() {
            return isDark() ? DARK_REF : LIGHT_REF;
          }

          function isProperlySized(iframe: HTMLIFrameElement) {
            return /^[1-9]\d*px$/.test(iframe.style.height);
          }

          function loadEmbedSocialScript() {
            const old = document.getElementById(SCRIPT_ID);
            if (old) old.remove();
            const js = document.createElement('script');
            js.id = SCRIPT_ID;
            js.src = 'https://embedsocial.com/cdn/ht.js';
            document.head.appendChild(js);
          }

          function renderWidget(ref: string) {
            container.innerHTML = `
              <div class="embedsocial-hashtag" data-ref="${ref}">
                <a class="feed-powered-by-es feed-powered-by-es-feed-img es-widget-branding" href="https://embedsocial.com/" target="_blank" title="Widget by EmbedSocial">
                  <img src="https://embedsocial.com/cdn/icon/embedsocial-logo.webp" alt="EmbedSocial" width="16" height="16" />
                  <div class="es-widget-branding-text">Widget by EmbedSocial</div>
                </a>
              </div>
            `;
            loadEmbedSocialScript();
            loaded = true;
            loadedRef = ref;

            // Safety net: if the iframe does not size itself, force a reload.
            setTimeout(() => {
              const iframe = container.querySelector('iframe');
              if (iframe && !isProperlySized(iframe)) iframe.src = iframe.src;
            }, 1500);
          }

          const io = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting && !loaded) {
                renderWidget(activeRef());
                io.unobserve(entry.target);
              }
            });
          }, { rootMargin: '200px' });

          io.observe(container);

          // If the user switches theme live after the widget has already
          // loaded, we remove the previous script/widget before injecting the
          // new one — never both at once.
          const themeObserver = new MutationObserver(() => {
            if (!loaded) return;
            const ref = activeRef();
            if (ref !== loadedRef) renderWidget(ref);
          });
          themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
        })();
      </script>
    </div>
  </section>

  <!-- CTA Banner Section -->
  <section class="cta-banner px-5 lg:px-20 py-14 md:py-20 flex items-center justify-center transition-colors">
    <div class="container mx-auto text-center max-w-3xl">
      <h2 class="cta-banner-title text-3xl md:text-4xl lg:text-5xl font-normal mb-5 md:mb-6" style="font-family: 'Cormorant Garamond', serif;">
        Ready to Take the First Step?
      </h2>
      <p class="cta-banner-sub text-sm md:text-base mb-7 md:mb-10" style="line-height: 1.75; max-width: 480px; margin-left: auto; margin-right: auto;">
        Book your consultation today and meet the team behind your smile, in English, Spanish or French.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="/en/contact/#contact-form"
          class="cta-banner-btn inline-block px-8 md:px-10 py-3.5 md:py-4 text-sm md:text-[15px] font-medium tracking-wider transition-all duration-300"
          style="letter-spacing: 0.1em;"
        >
          Book My Free Assessment
        </a>
        <a
          href="https://wa.me/34665886439?text=Hello%2C%20I'd%20like%20to%20book%20an%20appointment%20at%20Arango%20Dental%20Clinic"
          target="_blank"
          rel="noopener"
          class="cta-banner-btn-solid inline-block px-8 md:px-10 py-3.5 md:py-4 text-sm md:text-[15px] font-medium tracking-wider transition-all duration-300"
          style="letter-spacing: 0.1em;"
        >
          Message Us on WhatsApp
        </a>
      </div>
    </div>
  </section>

  <style>
    /* Reviews widget — one per theme, only one visible at a time.
       min-height reserves space for the skeleton and for the EmbedSocial
       iframe until it has finished measuring, avoiding CLS. */
    .reviews-widget {
      min-height: 420px;
    }

    .reviews-skeleton {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      height: 420px;
    }

    @media (min-width: 768px) {
      .reviews-skeleton {
        flex-direction: row;
      }
    }

    .reviews-skeleton-card {
      flex: 1;
      border-radius: 4px;
      background: linear-gradient(90deg, var(--bg-tertiary) 25%, var(--bg-secondary) 50%, var(--bg-tertiary) 75%);
      background-size: 200% 100%;
      animation: reviews-skeleton-pulse 1.6s ease-in-out infinite;
    }

    @keyframes reviews-skeleton-pulse {
      0% { background-position: 200% 0; }
      100% { background-position: -200% 0; }
    }

    @media (prefers-reduced-motion: reduce) {
      .reviews-skeleton-card {
        animation: none;
        background: var(--bg-tertiary);
      }
    }

    /* "In Numbers" figures — green in light, gold in dark
       (it used var(--teal-600) before, which in dark gives light green, not gold). */
    .stat-number {
      color: var(--teal-600);
    }
    :global(html.dark) .stat-number {
      color: #D4AF55;
    }

    /* CTA Banner — light mode */
    .cta-banner {
      background-color: var(--bg-tertiary);
    }
    .cta-banner-title {
      color: var(--text-primary);
    }
    .cta-banner-sub {
      color: var(--text-secondary);
    }
    .cta-banner-btn {
      background-color: transparent;
      color: #153328;
      border: 1px solid rgba(21, 51, 40, 0.65);
    }
    .cta-banner-btn:hover {
      background-color: #153328;
      color: #ffffff;
      border-color: #153328;
    }

    /* Dark mode: dark background of the landing */
    :global(html.dark) .cta-banner {
      background-color: #141210;
    }
    :global(html.dark) .cta-banner-title {
      color: rgba(244, 240, 235, 0.95);
    }
    :global(html.dark) .cta-banner-sub {
      color: rgba(244, 240, 235, 0.55);
    }
    :global(html.dark) .cta-banner-btn {
      background-color: transparent;
      color: rgba(244, 240, 235, 0.85);
      border: 1px solid rgba(244, 240, 235, 0.30);
    }
    :global(html.dark) .cta-banner-btn:hover {
      background-color: #D4AF55;
      color: #141210;
      border-color: #D4AF55;
    }

    /* Second button of the final CTA (WhatsApp) — solid, same pattern as
       .hero-btn-primary/.srv-btn-solid in the rest of the site. */
    .cta-banner-btn-solid {
      background-color: #153328;
      color: #ffffff;
      border: 1px solid #153328;
    }
    .cta-banner-btn-solid:hover {
      background-color: transparent;
      color: #153328;
      border-color: rgba(21, 51, 40, 0.65);
    }
    :global(html.dark) .cta-banner-btn-solid {
      background-color: #D4AF55;
      color: #141210;
      border-color: #D4AF55;
    }
    :global(html.dark) .cta-banner-btn-solid:hover {
      background-color: transparent;
      color: rgba(244, 240, 235, 0.85);
      border-color: rgba(244, 240, 235, 0.30);
    }

    /* Quick contact strip — after the services grid */
    .quick-contact-strip {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1rem;
      margin-top: 2.5rem;
    }

    .quick-contact-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.7rem 1.5rem;
      font-family: "Inter", sans-serif;
      font-size: 0.8rem;
      font-weight: 500;
      letter-spacing: 0.04em;
      text-decoration: none;
      transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
      white-space: nowrap;
    }

    .quick-contact-btn-solid {
      background-color: #153328;
      color: #ffffff;
      border: 1px solid #153328;
    }
    .quick-contact-btn-solid:hover {
      background-color: transparent;
      color: #153328;
      border-color: rgba(21, 51, 40, 0.65);
    }
    :global(html.dark) .quick-contact-btn-solid {
      background-color: #D4AF55;
      color: #141210;
      border-color: #D4AF55;
    }
    :global(html.dark) .quick-contact-btn-solid:hover {
      background-color: transparent;
      color: rgba(244, 240, 235, 0.85);
      border-color: rgba(244, 240, 235, 0.30);
    }

    .quick-contact-btn-outline {
      background-color: transparent;
      color: var(--text-primary);
      border: 1px solid var(--border-secondary);
    }
    /* Hover: same colour as the main button ("Book an Appointment") in its
       theme — green in light, gold in dark. */
    .quick-contact-btn-outline:hover {
      background-color: #153328;
      color: #ffffff;
      border-color: #153328;
    }
    :global(html.dark) .quick-contact-btn-outline:hover {
      background-color: #D4AF55;
      color: #141210;
      border-color: #D4AF55;
    }

    /* Services carousel — native scroll-snap (no libraries), navigable
       with arrows, touch drag or keyboard (the track is focusable). */
    .services-carousel {
      position: relative;
    }

    .services-track {
      display: flex;
      gap: 1rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding-bottom: 0.25rem;
    }
    .services-track::-webkit-scrollbar {
      display: none;
    }
    .services-track:focus-visible {
      outline: 2px solid var(--gold-500);
      outline-offset: 4px;
    }

    /* Width of each card: always lets the next one peek out, so it is
       obvious there is more to scroll (not everything visible at once). */
    .services-slide {
      position: relative;
      flex: 0 0 86%;
      scroll-snap-align: start;
    }

    /* Moving glow border — pure CSS adaptation (no React or
       Framer Motion) of Aceternity's "HoverBorderGradient" effect.
       IMPORTANT: animating the whole "background" property via @keyframes
       (changing the position of a radial-gradient) is NOT interpolated in
       real browsers — the value stays frozen on the first frame
       forever (tested by forcing the animation with !important: no change in
       3+ seconds). The technique that does animate reliably is registering
       an angle with @property (it becomes "typed" as <angle>, so the engine
       knows how to interpolate it) and using it in a conic-gradient — the same
       mechanism already verified in the first version of this effect. */
    @property --services-border-angle {
      syntax: '<angle>';
      initial-value: 0deg;
      inherits: false;
    }

    .services-slide::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
      padding: 1.5px;
      border-radius: inherit;
      filter: blur(2px);
      background: conic-gradient(
        from var(--services-border-angle),
        transparent 0deg,
        transparent 240deg,
        var(--teal-500) 300deg,
        transparent 360deg
      );
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      pointer-events: none;
      animation: services-border-rotate 5s linear infinite;
    }

    /* Green in light, gold in dark (the rest of the border does not change). */
    :global(html.dark) .services-slide::before {
      background: conic-gradient(
        from var(--services-border-angle),
        transparent 0deg,
        transparent 240deg,
        var(--gold-500) 300deg,
        transparent 360deg
      );
    }

    .services-slide:hover::before {
      background: radial-gradient(75% 180% at 50% 50%, var(--gold-500) 0%, var(--teal-500) 55%, transparent 100%);
      animation-play-state: paused;
    }

    @keyframes services-border-rotate {
      to { --services-border-angle: 360deg; }
    }

    /* Slight offset per card so they do not all spin at the same time. */
    .services-slide:nth-child(2)::before { animation-delay: -0.7s; }
    .services-slide:nth-child(3)::before { animation-delay: -1.4s; }
    .services-slide:nth-child(4)::before { animation-delay: -2.1s; }
    .services-slide:nth-child(5)::before { animation-delay: -2.8s; }
    .services-slide:nth-child(6)::before { animation-delay: -3.5s; }
    .services-slide:nth-child(7)::before { animation-delay: -4.2s; }

    @media (prefers-reduced-motion: reduce) {
      .services-slide::before {
        animation: none;
      }
    }

    @media (min-width: 640px) {
      .services-slide {
        flex: 0 0 60%;
      }
    }

    @media (min-width: 768px) {
      .services-track {
        gap: 1.5rem;
      }
      .services-slide {
        flex: 0 0 calc((100% - 3rem) / 2.3);
      }
    }

    /* "Learn more" link on each card — same colour scheme per theme
       as the WhatsApp button: green in light, gold in dark. */
    .services-card-link {
      color: #153328;
      text-decoration: none;
      transition: opacity 0.25s ease, color 0.25s ease;
    }
    .services-card-link:hover {
      opacity: 0.6;
    }
    :global(html.dark) .services-card-link {
      color: #D4AF55;
    }

    /* WhatsApp button per card — same icon as the header one, with the
       text "Contact us". Same colour pattern as .quick-contact-btn-solid
       in the rest of the site: solid green in light, gold in dark. */
    .services-whatsapp-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      flex-shrink: 0;
      padding: 0.5rem 0.9rem;
      font-family: "Inter", sans-serif;
      font-size: 0.78rem;
      font-weight: 500;
      text-decoration: none;
      white-space: nowrap;
      background-color: #153328;
      color: #ffffff;
      border: 1px solid #153328;
      transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
    }
    .services-whatsapp-btn:hover {
      background-color: transparent;
      color: #153328;
      border-color: rgba(21, 51, 40, 0.65);
    }
    :global(html.dark) .services-whatsapp-btn {
      background-color: #D4AF55;
      color: #141210;
      border-color: #D4AF55;
    }
    :global(html.dark) .services-whatsapp-btn:hover {
      background-color: transparent;
      color: rgba(244, 240, 235, 0.85);
      border-color: rgba(244, 240, 235, 0.30);
    }

    .services-carousel-nav {
      display: flex;
      justify-content: center;
      gap: 0.75rem;
      margin-top: 1.5rem;
    }

    .services-arrow {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.75rem;
      height: 2.75rem;
      background-color: transparent;
      color: var(--text-primary);
      border: 1px solid var(--border-secondary);
      cursor: pointer;
      transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
    }
    /* Hover: same colour as the section's main button — green in
       light, gold in dark (same as .quick-contact-btn-outline). */
    .services-arrow:hover {
      background-color: #153328;
      color: #ffffff;
      border-color: #153328;
    }
    :global(html.dark) .services-arrow:hover {
      background-color: #D4AF55;
      color: #141210;
      border-color: #D4AF55;
    }
  </style>

  <script>
    (function () {
      const els = document.querySelectorAll('.stat-number');
      if (!els.length) return;

      function animateCounter(el) {
        const target = el.getAttribute('data-target') || '';
        // Numeric core (accepts a thousands comma and one decimal point, e.g.
        // "5,000+" or "4.9 ★"); everything outside is a literal prefix/suffix.
        const match = target.match(/-?\d[\d,]*\.?\d*/);
        if (!match) return;
        const core   = match[0];
        const prefix = target.slice(0, match.index);
        const suffix = target.slice((match.index || 0) + core.length);
        const numStr = core.replace(/,/g, '');
        const end = parseFloat(numStr);
        if (isNaN(end)) return;
        const decimals = (numStr.split('.')[1] || '').length;

        const duration = 1600;
        const start = performance.now();
        const format = (n: number) =>
          n.toLocaleString('en-GB', { minimumFractionDigits: decimals, maximumFractionDigits: decimals });
        el.textContent = prefix + format(0) + suffix;

        function tick(now: number) {
          const elapsed = now - start;
          const progress = Math.min(elapsed / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          const current = end * eased;
          el.textContent = prefix + format(current) + suffix;
          if (progress < 1) requestAnimationFrame(tick);
        }

        requestAnimationFrame(tick);
      }

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              animateCounter(e.target);
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.3 }
      );

      els.forEach((el) => io.observe(el));
    })();
  </script>

  <!-- Services carousel: prev/next arrows over native scroll-snap -->
  <script>
    (function () {
      const track = document.getElementById('services-track');
      const prevBtn = document.getElementById('services-prev');
      const nextBtn = document.getElementById('services-next');
      if (!track || !prevBtn || !nextBtn) return;

      function scrollByCard(direction: number) {
        const card = track.querySelector('.services-slide') as HTMLElement | null;
        if (!card) return;
        const gap = parseFloat(getComputedStyle(track).columnGap || '0');
        const amount = card.getBoundingClientRect().width + gap;
        track.scrollBy({ left: direction * amount, behavior: 'smooth' });
      }

      prevBtn.addEventListener('click', () => scrollByCard(-1));
      nextBtn.addEventListener('click', () => scrollByCard(1));
    })();
  </script>
</Layout>
