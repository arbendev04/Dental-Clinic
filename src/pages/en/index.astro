---
import Layout from '../../layouts/Layout.astro';
import HeroScroll from '../../components/HeroScroll.astro';

const services = [
  {
    icon: "sparkles",
    title: "Digital Dentistry",
    description: "3D intraoral scanning, digital X-rays and computer-assisted smile design for precise diagnoses and predictable treatments.",
    href: "/en/digital-dentistry/",
    anchor: "Digital dentistry in Benidorm",
  },
  {
    icon: "shield-check",
    title: "Dental Implants",
    description: "High-quality titanium implants to replace missing teeth with a natural-looking, fully functional result.",
    href: "/en/dental-implants/",
    anchor: "Dental implants in Benidorm",
  },
  {
    icon: "smile",
    title: "Cosmetic Dentistry",
    description: "Porcelain veneers, professional whitening and personalised smile design to transform your look with harmony and precision.",
    href: "/en/cosmetic-dentistry/",
    anchor: "Cosmetic dentistry in Benidorm",
  },
  {
    icon: "cube",
    title: "Oral Rehabilitation",
    description: "Crowns, bridges and dentures to restore damaged or missing teeth, recovering function and appearance with a personalised plan.",
    href: "/en/oral-rehabilitation/",
    anchor: "Oral rehabilitation in Benidorm",
  },
  {
    icon: "heart",
    title: "Gum Disease Treatment",
    description: "We look after the health of your gums, treating bleeding, inflammation and other gum disease with a preventive approach.",
    href: "/en/gum-treatment/",
    anchor: "Gum disease treatment in Benidorm",
  },
  {
    icon: "adjustments",
    title: "Orthodontics",
    description: "We align your teeth and correct bite problems with traditional braces or clear aligners, depending on your case.",
    href: "/en/orthodontics/",
    anchor: "Orthodontics in Benidorm",
  },
  {
    icon: "magnifier",
    title: "Root Canal Treatment",
    description: "We treat infections and internal damage to the tooth with root canal treatment, to keep your original tooth.",
    href: "/en/root-canal-treatment/",
    anchor: "Root canal treatment in Benidorm",
  },
];

const stats = [
  { number: '8', label: 'Years of Experience' },
  // Real rating verified on Google Maps (place_id ChIJrZfws2MFYg0RHzre1V7ThzY)
  // on 2026-09-06. Google does not expose the number of reviews without a
  // signed-in session or the Places API, so no count is shown — see CLAUDE.md.
  { number: '4.9 ★', label: 'Google Rating' },
];

---

<Layout title="English-Speaking Dentist in Benidorm" description="Arango Dental Clinic, your English-speaking dentist in Benidorm. Dental implants, cosmetic dentistry, orthodontics and digital dentistry with modern technology." preloadHero={true}>
  <!-- Hero Section -->
  <HeroScroll />

  <!-- Services Section -->
  <section class="px-5 lg:px-20 py-16 md:py-24 lg:py-28 transition-colors" style="background-color: var(--bg-secondary);">
    <div class="container mx-auto">
      <!-- Section Header -->
      <div class="text-center mb-10 md:mb-16">
        <div class="flex items-center justify-center gap-3 mb-4">
          <div class="w-8 h-px" style="background-color: var(--gold-500);"></div>
          <span class="text-[0.65rem] tracking-[0.2em] uppercase font-medium" style="color: var(--gold-600);">
            Our Services
          </span>
          <div class="w-8 h-px" style="background-color: var(--gold-500);"></div>
        </div>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-normal" style="font-family: 'Cormorant Garamond', serif; color: var(--text-primary); text-wrap: balance;">
          Personalised Dental Care
        </h2>
      </div>

      <!-- Services Carousel -->
      <div class="services-carousel">
        <div class="services-track" id="services-track" tabindex="0" role="region" aria-label="Services carousel">
          {services.map((service) => {
            const waText = encodeURIComponent(`Hello, I'd like more information about ${service.title}.`);
            const waHref = `https://api.whatsapp.com/send?phone=34665886439&text=${waText}`;
            return (
              <div class="services-slide p-6 md:p-10 transition-all duration-300 hover:translate-y-[-4px]" style="background-color: var(--bg-primary); border: 1px solid transparent;">
                <div class="w-12 h-12 md:w-14 md:h-14 flex items-center justify-center mb-5" style="background-color: var(--teal-100);">
                  <svg class="w-6 h-6 md:w-7 md:h-7" style="color: var(--teal-600);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    {service.icon === 'sparkles' && (
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                    )}
                    {service.icon === 'shield-check' && (
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    )}
                    {service.icon === 'smile' && (
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    )}
                    {service.icon === 'cube' && (
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9" />
                    )}
                    {service.icon === 'heart' && (
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
                    )}
