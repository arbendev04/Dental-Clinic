<script>
  /* ── Reveal on scroll ── */
  (function () {
    const els = document.querySelectorAll('.reveal-up');
    if (!els.length) return;
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible');
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.12 }
    );
    els.forEach((el) => io.observe(el));
  })();

  /* ── Counter animation ── */
  (function () {
    const els = document.querySelectorAll('.nos-stat-valor');
    if (!els.length) return;

    function animateCounter(el) {
      const target = el.getAttribute('data-target') || '';
      // Numeric core (allows a decimal point, e.g. "4.9 ★"); anything outside is a literal prefix/suffix.
      const match = target.match(/-?\d[\d,]*\.?\d*/);
      if (!match) return;
      const core = match[0];
      const prefix = target.slice(0, match.index);
      const suffix = target.slice((match.index || 0) + core.length);
      const numStr = core.replace(/,/g, '');
      const end = parseFloat(numStr);
      if (isNaN(end)) return;
      const decimals = (numStr.split('.')[1] || '').length;

      const duration = 1600;
      const start = performance.now();
      const format = (n) =>
        n.toLocaleString('en-GB', { minimumFractionDigits: decimals, maximumFractionDigits: decimals });
      el.textContent = prefix + format(0) + suffix;

      function tick(now) {
        const elapsed = now - start;
        const progress = Math.min(elapsed / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = prefix + format(end * eased) + suffix;
        if (progress < 1) requestAnimationFrame(tick);
      }

      requestAnimationFrame(tick);
    }

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            animateCounter(e.target);
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.3 }
    );

    els.forEach((el) => io.observe(el));
  })();
</script>
