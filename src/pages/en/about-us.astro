---
import Layout from '../../layouts/Layout.astro';
import { CLINIC_ID } from '../../data/i18n';

const team = [
  {
    name: 'Barbara Abella',
    specialty: 'Orthodontics',
    description: 'Specialist in orthodontics with braces and clear aligners. She designs aligned, functional smiles with close follow-up at every stage of treatment.',
  },
  {
    name: 'Magdalena Ruslanova',
    specialty: 'Root canal treatment',
    description: 'Specialist in endodontics and root canal treatment. She combines technical precision with pain control for comfortable, highly effective procedures.',
  },
  {
    name: 'Sandra Romero',
    specialty: 'Dental hygienist',
    description: 'Specialist in oral hygiene and prophylaxis. She looks after the health of your gums and teeth with professional cleanings and daily maintenance guidance.',
  },
  {
    name: 'Sara Montoro',
    specialty: 'Dental hygienist',
    description: 'Specialist in oral hygiene and prevention. She supports each patient in caring for their smile between visits to the clinic.',
  },
  {
    name: 'Ana Deltell',
    specialty: 'Reception',
    description: 'The first point of contact at Arango Dental Clinic. She organises your appointment and answers your questions warmly, so your experience starts in the best possible way.',
  },
  {
    name: 'Natalia Svetlozarova',
    specialty: 'Treatment advisor',
    description: 'She guides you through planning your treatment and your quote. She answers your questions with transparency and a friendly approach at every consultation.',
  },
];

const stats = [
  { value: '8', label: 'years of experience' },
  // Real rating verified on Google Maps (place_id ChIJrZfws2MFYg0RHzre1V7ThzY)
  // on 2026-09-06 — the same one shown on the home page.
  { value: '4.9 ★', label: 'Google rating' },
  { value: '7', label: 'specialities' },
  { value: '3D', label: 'intraoral scanner' },
];

const values = [
  {
    num: '01',
    title: 'Trust',
    text: 'We build relationships based on transparency and honesty. Every diagnosis and every treatment plan is explained clearly before we begin.',
  },
  {
    num: '02',
    title: 'Excellence',
    text: 'We aim for perfection in every procedure: ongoing training, state-of-the-art technology and clinical protocols of the highest precision.',
  },
  {
    num: '03',
    title: 'Empathy',
    text: 'We understand your fears and your expectations. We support you at every step of the treatment with warmth, patience and genuine care.',
  },
];

// Person schema for the director and the team — same texts as shown on the
// page, no new data.
const teamSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "name": "Dr. Sebastián Arango",
      "jobTitle": "Director · Implantology · Oral Rehabilitation",
      "worksFor": { "@id": CLINIC_ID },
      "description": "Founder and director of Arango Dental Clinic. Specialist in implantology and oral rehabilitation, trained in the most advanced digital dentistry techniques.",
    },
    ...team.map((person) => ({
      "@type": "Person",
      "name": person.name,
      "jobTitle": person.specialty,
      "worksFor": { "@id": CLINIC_ID },
      "description": person.description,
    })),
  ],
};
---

<Layout title="About Us | Our Dental Team in Benidorm" description="Meet Dr Sebastián Arango and the team of specialists in implants, oral rehabilitation, orthodontics and root canal treatment at Arango Dental Clinic in Benidorm." image="/img/banner/banner-arango.webp">
  <script type="application/ld+json" set:html={JSON.stringify(teamSchema)} />

  <!-- ── HERO ── -->
  <section class="nos-hero" data-scroll-hero>
    <picture>
      <source media="(max-width: 768px)" srcset="/img/banner/nosotros-mobile.webp" width="864" height="1821" />
      <img
        src="/img/banner/banner-arango.webp"
        alt="Front of Arango Dental Clinic, Benidorm"
        class="nos-hero-img"
        width="1350"
        height="1080"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <div class="nos-hero-overlay" aria-hidden="true"></div>
    <div class="nos-container nos-hero-inner">
      <div class="nos-hero-content reveal-up">
        <p class="nos-label">The team</p>
        <h1 class="nos-hero-title">
          Behind every<br>
          <em>treatment,</em><br>
          there is a great team
        </h1>
        <div class="nos-hero-line"></div>
        <p class="nos-hero-sub">
          Professionals passionate about oral health, committed to your wellbeing and to excellence in every treatment.
        </p>
      </div>
    </div>
    <div class="nos-hero-scroll-hint" aria-hidden="true">
      <span></span>
    </div>
  </section>

  <!-- ── MANIFESTO ── -->
  <section class="nos-manifiesto">
    <div class="nos-container">
      <div class="nos-quote reveal-up">
        <span class="nos-quote-mark" aria-hidden="true">"</span>
        <blockquote class="nos-quote-text">
          Every treatment is a promise.<br>Every patient, a story that deserves the best care.
        </blockquote>
        <cite class="nos-quote-cite">— Dr. Sebastián Arango, Director</cite>
      </div>
    </div>
  </section>

  <!-- ── HISTORY + STATS ── -->
  <section class="nos-historia-section">
    <div class="nos-container nos-historia-grid">

      <!-- Text -->
      <div class="nos-historia-text reveal-up">
        <p class="nos-label" style="margin-bottom: 1rem;">Our story</p>
        <h2 class="nos-section-title">A clinic built<br>on trust</h2>
        <p class="nos-body">
          Arango Dental Clinic was born from the conviction that every patient deserves personalised, honest, top-quality care. Since opening in Benidorm, we have worked to make every patient feel in the best hands, and the 4.9 out of 5 rating we receive on Google reflects that trust.
        </p>
        <p class="nos-body">
          We have state-of-the-art technology — 3D intraoral scanning, low-dose digital X-rays and digital smile design — and a team of professionals who keep up to date with the latest techniques in the field.
        </p>
      </div>

      <!-- Stats -->
      <div class="nos-stats reveal-up" style="--reveal-delay: 100ms;">
        {stats.map((s) => (
          <div class="nos-stat-item">
            <span class="nos-stat-valor" data-target={s.value}>{s.value}</span>
            <span class="nos-stat-label">{s.label}</span>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ── VALUES ── -->
  <section class="nos-valores-section">
    <div class="nos-container">
      <div class="nos-valores-header reveal-up">
        <p class="nos-label">What drives us</p>
        <h2 class="nos-section-title">Our values</h2>
      </div>
      <div class="nos-valores-list">
        {values.map((v, i) => (
          <div class="nos-valor-item reveal-up" style={`--reveal-delay: ${i * 80}ms`}>
            <span class="nos-valor-num">{v.num}</span>
            <div class="nos-valor-body">
              <h3 class="nos-valor-title">{v.title}</h3>
              <p class="nos-valor-texto">{v.text}</p>
            </div>
            <div class="nos-valor-line"></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── TEAM ── -->

  <!-- Director — editorial section of its own -->
  <section class="nos-director-section">
    <div class="nos-director-split reveal-up">

      <!-- Image -->
      <div class="nos-director-img-wrap">
        <img
          src="/img/nosotros/sebas.webp"
          alt="Dr. Sebastián Arango, director of Arango Dental Clinic"
          class="nos-director-img"
          width="1179"
          height="1415"
          loading="lazy"
          decoding="async"
        />
        <div class="nos-director-img-overlay" aria-hidden="true"></div>
      </div>

      <!-- Text -->
      <div class="nos-director-text">
        <p class="nos-label">Clinic director</p>
        <h2 class="nos-director-heading">Dr. Sebastián<br>Arango</h2>
        <p class="nos-director-role-tag">Implantology · Oral Rehabilitation</p>
        <p class="nos-director-bio">
          Founder and director of Arango Dental Clinic. Specialist in implantology and oral rehabilitation, trained in the most advanced digital dentistry techniques.
        </p>
        <p class="nos-director-bio">
          His vision of a close, honest and highly excellent clinic is the foundation of everything we do every day in Benidorm.
        </p>
        <div class="nos-director-divider" aria-hidden="true"></div>
        <p class="nos-director-quote">"Every patient deserves to feel they are in the best hands."</p>
      </div>

    </div>
  </section>

  <!-- Team -->
  <section class="nos-equipo-section">
    <div class="nos-container">
      <div class="nos-equipo-header reveal-up">
        <p class="nos-label">Our team</p>
        <h2 class="nos-section-title">The people behind<br>every smile</h2>
      </div>

      <div class="nos-team-grid">
        {team.map((person, i) => (
          <div class="nos-member-card reveal-up" style={`--reveal-delay: ${i * 80}ms`}>
            <div class="nos-member-info">
              <p class="nos-member-role">{person.specialty}</p>
              <h3 class="nos-member-name">{person.name}</h3>
              <p class="nos-member-bio">{person.description}</p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ── CTA ── -->
  <section class="nos-cta-section">
    <div class="nos-container nos-cta-inner reveal-up">
      <p class="nos-label nos-cta-label">First step</p>
      <h2 class="nos-cta-title">Start with a free<br><em>assessment</em></h2>
      <p class="nos-cta-sub">Book your first visit and find out how we can transform your smile.</p>
      <div class="nos-cta-actions">
        <a href="/en/contact/" class="nos-btn nos-btn-outline">Contact us</a>
        <a href="https://wa.me/34665886439?text=Hello%2C%20I%27d%20like%20to%20book%20a%20free%20assessment" target="_blank" rel="noopener" class="nos-btn nos-btn-solid">Message us</a>
      </div>
    </div>
  </section>

</Layout>

<style>
/* ─────────────────────────────────────────
   BASE
───────────────────────────────────────── */
.nos-container {
  max-width: 1200px;
  margin: 0 auto;
  padding-left: 2rem;
  padding-right: 2rem;
}

.nos-label {
  font-family: "Inter", sans-serif;
  font-size: 0.65rem;
  font-weight: 500;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: #C49B38;
  display: block;
}

:global(html.dark) .nos-label { color: #D4AF55; }

.nos-section-title {
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 300;
  line-height: 1.15;
  color: var(--text-primary);
  margin: 0.5rem 0 0;
}

.nos-body {
  font-family: "Inter", sans-serif;
  font-size: 0.95rem;
  line-height: 1.8;
  color: var(--text-secondary);
  margin: 0 0 1rem;
}

/* ─────────────────────────────────────────
   REVEAL ANIMATIONS
───────────────────────────────────────── */
.reveal-up {
  opacity: 0;
  transform: translateY(28px);
  transition: opacity 0.65s ease, transform 0.65s ease;
  transition-delay: var(--reveal-delay, 0ms);
}

.reveal-up.is-visible {
  opacity: 1;
  transform: translateY(0);
}

/* ─────────────────────────────────────────
   HERO
───────────────────────────────────────── */
.nos-hero {
  position: relative;
  min-height: 92vh;
  display: flex;
  align-items: center;
  overflow: hidden;
  background-color: #0d2219;
}

/* Imagen de fondo */
.nos-hero picture {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.nos-hero-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 30%;
  display: block;
}

/* Overlay: texto legible a la izquierda, imagen respira a la derecha */
.nos-hero-overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      105deg,
      rgba(6, 18, 10, 0.82) 0%,
      rgba(6, 18, 10, 0.52) 45%,
      rgba(6, 18, 10, 0.18) 100%
    );
}

:global(html.dark) .nos-hero-overlay {
  background:
    linear-gradient(
      105deg,
      rgba(4, 12, 7, 0.88) 0%,
      rgba(4, 12, 7, 0.58) 45%,
      rgba(4, 12, 7, 0.22) 100%
    );
}

.nos-hero-inner {
  position: relative;
  z-index: 1;
  padding-top: 7rem;
  padding-bottom: 6rem;
}

.nos-hero-content {
  max-width: 640px;
}

.nos-hero-title {
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(2.8rem, 6vw, 5.2rem);
  font-weight: 300;
  line-height: 1.1;
  color: rgba(244, 240, 235, 0.95);
  margin: 0.75rem 0 1.5rem;
}

.nos-hero-title em {
  font-style: italic;
  color: #C49B38;
}

.nos-hero-line {
  width: 3rem;
  height: 1px;
  background-color: rgba(196, 155, 56, 0.5);
  margin-bottom: 1.5rem;
}

.nos-hero-sub {
  font-family: "Inter", sans-serif;
  font-size: 0.975rem;
  line-height: 1.75;
  color: rgba(244, 240, 235, 0.55);
  max-width: 48ch;
}

/* scroll hint */
.nos-hero-scroll-hint {
  position: absolute;
  bottom: 2.5rem;
  left: 50%;
  transform: translateX(-50%);
  z-index: 1;
}

.nos-hero-scroll-hint span {
  display: block;
  width: 1px;
  height: 3.5rem;
  background: linear-gradient(to bottom, rgba(196,155,56,0.6), transparent);
  animation: scrollPulse 2s ease-in-out infinite;
}

@keyframes scrollPulse {
  0%, 100% { opacity: 0.3; transform: scaleY(1); }
  50%       { opacity: 0.9; transform: scaleY(0.6); }
}

/* ─────────────────────────────────────────
   MANIFIESTO
───────────────────────────────────────── */
.nos-manifiesto {
  background-color: var(--bg-primary);
  padding: 6rem 0;
  border-bottom: 1px solid var(--border-primary);
}

.nos-quote {
  position: relative;
  max-width: 820px;
  margin: 0 auto;
  text-align: center;
  padding: 0 1rem;
}

.nos-quote-mark {
  display: block;
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(6rem, 14vw, 12rem);
  line-height: 0.7;
  color: #C49B38;
  opacity: 0.18;
  margin-bottom: -1.5rem;
  user-select: none;
}

:global(html.dark) .nos-quote-mark { color: #D4AF55; }

.nos-quote-text {
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(1.6rem, 3.5vw, 2.6rem);
  font-weight: 300;
  font-style: italic;
  line-height: 1.4;
  color: var(--text-primary);
  margin: 0 0 1.5rem;
}

.nos-quote-cite {
  font-family: "Inter", sans-serif;
  font-size: 0.75rem;
  font-style: normal;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--text-tertiary);
}

/* ─────────────────────────────────────────
   HISTORIA + STATS
───────────────────────────────────────── */
.nos-historia-section {
  background-color: var(--bg-secondary);
  padding: 6rem 0;
}

.nos-historia-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 4rem;
}

@media (min-width: 900px) {
  .nos-historia-grid {
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 6rem;
  }
}

.nos-historia-text { display: flex; flex-direction: column; gap: 0; }
.nos-historia-text .nos-section-title { margin-bottom: 1.75rem; }

.nos-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
}

.nos-stat-item {
  padding: 2.5rem 2rem;
  border: 1px solid var(--border-primary);
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  transition: background-color 0.3s ease;
}

.nos-stat-item:hover { background-color: var(--bg-tertiary); }

.nos-stat-valor {
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(2.4rem, 5vw, 3.6rem);
  font-weight: 300;
  font-style: italic;
  color: var(--text-primary);
  line-height: 1;
}

.nos-stat-label {
  font-family: "Inter", sans-serif;
  font-size: 0.75rem;
  font-weight: 400;
  color: var(--text-tertiary);
  letter-spacing: 0.04em;
}

/* ─────────────────────────────────────────
   VALORES
───────────────────────────────────────── */
.nos-valores-section {
  background-color: var(--bg-primary);
  padding: 6rem 0;
}

.nos-valores-header {
  margin-bottom: 3.5rem;
}

.nos-valores-list {
  display: flex;
  flex-direction: column;
}

.nos-valor-item {
  position: relative;
  display: grid;
  grid-template-columns: 4rem 1fr;
  gap: 2rem;
  padding: 2.5rem 0;
  cursor: default;
}

.nos-valor-line {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 1px;
  background-color: var(--border-primary);
  transform-origin: left;
  transition: background-color 0.4s ease;
}

.nos-valor-item::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0;
  height: 1px;
  background-color: #C49B38;
  transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

:global(html.dark) .nos-valor-item::after { background-color: #D4AF55; }

.nos-valor-item:hover::after { width: 100%; }

.nos-valor-num {
  font-family: "Cormorant Garamond", serif;
  font-size: 0.9rem;
  font-style: italic;
  color: #C49B38;
  padding-top: 0.2rem;
  line-height: 1;
}

:global(html.dark) .nos-valor-num { color: #D4AF55; }

.nos-valor-body { display: flex; flex-direction: column; gap: 0.75rem; }

.nos-valor-title {
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(1.5rem, 3vw, 2rem);
  font-weight: 400;
  color: var(--text-primary);
  margin: 0;
  transition: color 0.3s ease;
}

.nos-valor-item:hover .nos-valor-title { color: var(--teal-600); }

.nos-valor-texto {
  font-family: "Inter", sans-serif;
  font-size: 0.9rem;
  line-height: 1.75;
  color: var(--text-secondary);
  max-width: 68ch;
  margin: 0;
}

/* ─────────────────────────────────────────
   DIRECTOR — sección editorial
───────────────────────────────────────── */
.nos-director-section {
  background-color: var(--bg-primary);
  overflow: hidden;
}

.nos-director-split {
  display: grid;
  grid-template-columns: 1fr;
  min-height: 680px;
}

@media (min-width: 900px) {
  .nos-director-split {
    grid-template-columns: 1fr 1fr;
  }
}

/* Imagen */
.nos-director-img-wrap {
  position: relative;
  overflow: hidden;
  min-height: 420px;
}

@media (min-width: 900px) {
  .nos-director-img-wrap { min-height: 680px; }
}

.nos-director-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
  display: block;
  transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
}

.nos-director-img-wrap:hover .nos-director-img {
  transform: scale(1.03);
}

.nos-director-img-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to right,
    transparent 60%,
    var(--bg-primary) 100%
  );
  pointer-events: none;
}

@media (max-width: 899px) {
  .nos-director-img-overlay {
    background: linear-gradient(
      to bottom,
      transparent 60%,
      var(--bg-primary) 100%
    );
  }
}

/* Texto */
.nos-director-text {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 1rem;
  padding: 3.5rem 3rem 3.5rem 2.5rem;
}

@media (min-width: 900px) {
  .nos-director-text { padding: 5rem 4rem; }
}

.nos-director-heading {
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(2.6rem, 5vw, 4rem);
  font-weight: 300;
  line-height: 1.05;
  color: var(--text-primary);
  margin: 0.4rem 0 0.25rem;
}

.nos-director-role-tag {
  font-family: "Inter", sans-serif;
  font-size: 0.72rem;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--teal-600);
  margin: 0 0 0.5rem;
}

.nos-director-bio {
  font-family: "Inter", sans-serif;
  font-size: 0.925rem;
  line-height: 1.8;
  color: var(--text-secondary);
  margin: 0;
  max-width: 52ch;
}

.nos-director-divider {
  width: 2.5rem;
  height: 1px;
  background-color: #C49B38;
  opacity: 0.55;
  margin: 0.5rem 0;
}

:global(html.dark) .nos-director-divider { background-color: #D4AF55; }

.nos-director-quote {
  font-family: "Cormorant Garamond", serif;
  font-size: 1.2rem;
  font-style: italic;
  font-weight: 400;
  color: var(--text-tertiary);
  margin: 0;
  max-width: 46ch;
}

/* ─────────────────────────────────────────
   EQUIPO — grid 3 miembros
───────────────────────────────────────── */
.nos-equipo-section {
  background-color: var(--bg-secondary);
  padding: 6rem 0;
}

.nos-equipo-header {
  margin-bottom: 3.5rem;
}

.nos-team-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.5rem;
}

@media (min-width: 640px) {
  .nos-team-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (min-width: 1024px) {
  .nos-team-grid { grid-template-columns: repeat(3, 1fr); }
}

.nos-member-card {
  display: flex;
  flex-direction: column;
  background-color: var(--bg-primary);
  border: 1px solid var(--border-primary);
  overflow: hidden;
  transition: border-color 0.3s ease, transform 0.3s ease;
}

.nos-member-card:hover {
  border-color: var(--border-secondary);
  transform: translateY(-4px);
}

.nos-member-info {
  padding: 2rem 1.75rem;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.nos-member-role {
  font-family: "Inter", sans-serif;
  font-size: 0.65rem;
  font-weight: 500;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #C49B38;
  margin: 0;
}

:global(html.dark) .nos-member-role { color: #D4AF55; }

.nos-member-name {
  font-family: "Cormorant Garamond", serif;
  font-size: 1.55rem;
  font-weight: 400;
  color: var(--text-primary);
  margin: 0 0 0.25rem;
  line-height: 1.1;
}

.nos-member-bio {
  font-family: "Inter", sans-serif;
  font-size: 0.85rem;
