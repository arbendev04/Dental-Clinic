---
import Layout from '../layouts/Layout.astro';

const WHATSAPP_PHONE = '34665886439';
const whatsappHref = (texto: string) =>
  `https://api.whatsapp.com/send?phone=${WHATSAPP_PHONE}&text=${encodeURIComponent(texto)}`;

const pasos = [
  {
    titulo: 'Valoración inicial y escáner 3D',
    descripcion: 'Evaluamos tu caso sin coste con un escáner intraoral 3D y te explicamos si eres candidato a un implante dental.',
  },
  {
    titulo: 'Planificación digital',
    descripcion: 'Diseñamos la posición exacta del implante antes de la intervención, con la información real de tu hueso maxilar o mandibular.',
  },
  {
    titulo: 'Colocación del implante',
    descripcion: 'Se coloca con anestesia local en la propia clínica. La mayoría de los pacientes vuelve a su rutina el mismo día.',
  },
  {
    titulo: 'Oseointegración',
    descripcion: 'Durante las semanas siguientes, el hueso se une al implante de titanio hasta quedar completamente integrado.',
  },
  {
    titulo: 'Colocación de la corona',
    descripcion: 'Completamos el tratamiento con la corona definitiva, ajustada a la forma y función de tu dentadura natural.',
  },
];

const faqs = [
  {
    pregunta: '¿Duele ponerse un implante dental?',
    respuesta: 'La colocación se realiza con anestesia local, por lo que no deberías sentir dolor durante la intervención. Es normal notar molestias leves los días posteriores, similares a las de una extracción dental, que se controlan con la pauta que te indiquemos.',
  },
  {
    pregunta: '¿Cuánto dura un implante dental?',
    respuesta: 'Un implante dental bien cuidado, con revisiones periódicas y buena higiene bucal, puede durar muchos años. La duración exacta depende de la salud bucal de cada paciente y del mantenimiento posterior.',
  },
  {
    pregunta: '¿Cuánto cuesta un implante dental?',
    respuesta: 'El precio de un implante dental se evalúa según las necesidades de cada paciente, tras una valoración inicial gratuita en la que definimos el plan de tratamiento más adecuado.',
  },
  {
    pregunta: '¿Necesito un injerto de hueso para colocarme un implante?',
    respuesta: 'No siempre. Si no hay suficiente hueso en la zona donde se va a colocar el implante, puede ser necesario un injerto óseo previo. Lo valoramos con tu escáner 3D durante la primera consulta.',
  },
  {
    pregunta: '¿Cuántas visitas necesito para completar el tratamiento?',
    respuesta: 'El número de visitas varía según cada caso: la valoración inicial, la colocación del implante, el periodo de oseointegración y la colocación de la corona final. Te explicamos el plan completo antes de empezar.',
  },
  {
    pregunta: '¿Qué pasa si he perdido varios dientes o toda una arcada?',
    respuesta: "Existen protocolos que permiten apoyar una prótesis fija sobre un número reducido de implantes, a veces conocidos como carga inmediata o \"All-on-4\". Coméntanoslo en la valoración inicial para revisar si es tu caso.",
  },
  {
    pregunta: '¿Ofrecen financiación para implantes dentales?',
    respuesta: 'Sí. Ofrecemos opciones de financiación para que puedas empezar tu tratamiento sin que el coste sea un obstáculo. Te damos los detalles en tu valoración inicial gratuita.',
  },
  {
    pregunta: '¿Qué cuidados necesita un implante dental?',
    respuesta: 'Un implante se cuida igual que un diente natural: cepillado dos veces al día, uso de cepillo interdental o irrigador, y revisiones periódicas en la clínica para comprobar que la encía y el hueso que lo sostienen están sanos.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.pregunta,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.respuesta,
    },
  })),
};

// Sin `@id` al Dentist todavía (pendiente Tarea 9 del Plan SEO) — se declara
// la clínica en línea, igual que ya hace el schema ItemList de /servicios/.
const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Implantes dentales",
  "url": "https://arangodentalclinic.es/implantes/",
  "procedureType": "https://schema.org/SurgicalProcedure",
  "bodyLocation": "Maxilar y mandíbula",
  "howPerformed": "Planificación digital con escáner intraoral 3D, colocación del implante de titanio con anestesia local y, tras el periodo de oseointegración, colocación de la corona definitiva.",
  "provider": {
    "@type": "Dentist",
    "name": "Arango Dental Clinic",
    "url": "https://arangodentalclinic.es",
  },
};
---

<Layout title="Implantes Dentales en Benidorm | Precio y Financiación" description="Implantes dentales en Benidorm con planificación 3D y implantes de titanio. Valoración inicial sin coste y financiación a medida. Pide cita hoy." image="/img/servicios/servicios.webp">
  <script type="application/ld+json" set:html={JSON.stringify(procedureSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- ── Hero ── -->
  <section class="trt-hero" data-scroll-hero>
    <img
      src="/img/servicios/servicios.webp"
      alt="Instrumental odontológico profesional en Arango Dental Clinic"
      class="trt-hero-img"
      width="1536"
      height="1024"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="trt-hero-overlay" aria-hidden="true"></div>
    <div class="trt-hero-inner">
      <div class="trt-hero-text">
        <p class="trt-label">Arango Dental Clinic</p>
        <h1 class="trt-hero-title">Implantes dentales en Benidorm</h1>
        <p class="trt-hero-sub">
          Si has perdido una o varias piezas dentales, un implante dental te permite recuperar la función y la estética de tu sonrisa sin afectar a los dientes vecinos. En Arango Dental Clinic evaluamos tu caso con planificación digital 3D y te ofrecemos una valoración inicial sin coste en Benidorm.
        </p>
        <div class="trt-hero-actions">
          <a href={whatsappHref('Hola, quiero pedir una valoración gratuita para un implante dental')} target="_blank" rel="noopener noreferrer" class="trt-btn trt-btn-solid-hero">Pide tu valoración sin coste</a>
        </div>
      </div>

      <!-- Mismo formulario y mismo endpoint que el hero del home
      (HeroScroll.astro → /api/lead) — clases propias con prefijo trt- para
      no depender de los estilos de ese componente. -->
      <div class="trt-hero-form-panel" id="trt-hero-form-panel">
        <p class="trt-hero-form-eyebrow">Valoración sin coste</p>
        <h2 class="trt-hero-form-title">Da el primer paso</h2>
        <form id="trt-lead-form" class="trt-hero-form" novalidate>
          <input type="text" id="trt-gotcha" name="_gotcha" class="trt-hero-form-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <input type="text" id="trt-nombre" name="nombre" class="trt-hero-form-input" placeholder="Nombre completo" required />
          <input type="tel" id="trt-telefono" name="telefono" class="trt-hero-form-input" placeholder="Teléfono" required />
          <input type="email" id="trt-email" name="email" class="trt-hero-form-input" placeholder="Email (opcional)" />
          <label class="trt-hero-form-consent">
            <input type="checkbox" id="trt-consentimiento" name="consentimiento" required />
            <span>Acepto la <a href="/politica-privacidad" target="_blank" rel="noopener">Política de Privacidad</a>.</span>
          </label>
          <button type="submit" id="trt-form-submit" class="trt-hero-form-submit">Enviar</button>
        </form>
        <p id="trt-form-status" class="trt-hero-form-status" role="status" aria-live="polite" hidden></p>
      </div>
    </div>
  </section>

  <!-- ── Contenido ── -->
  <section class="trt-content-section">
    <div class="trt-container trt-prose">

      <h2>¿Qué es un implante dental y cuándo se necesita?</h2>
      <p>
        Un implante dental es una pieza de titanio que sustituye la raíz de un diente perdido y se integra en el hueso maxilar o mandibular. Sobre ella se coloca una corona que recupera la forma y la función del diente natural, sin necesidad de tallar ni apoyarse en los dientes vecinos, a diferencia de un puente tradicional.
      </p>
      <p>
        En términos sencillos, un implante tiene tres partes: el tornillo de titanio que hace de raíz artificial, un pilar intermedio que conecta esa raíz con la parte visible, y la corona final, fabricada a medida para que combine con el resto de tu dentadura en color y forma.
      </p>
      <p>
        Se recomienda cuando falta una o varias piezas dentales, ya sea por una extracción, un traumatismo o una enfermedad periodontal avanzada. Sustituir la pieza cuanto antes evita dos problemas frecuentes: que los dientes vecinos se desplacen hacia el hueco vacío y que el hueso de la zona se reabsorba con el tiempo por falta de estímulo.
      </p>
      <p>
        A diferencia de una prótesis removible, el implante no se quita ni se apoya sobre las encías: queda fijo, como una pieza más de tu dentadura. Y a diferencia de un puente dental, no requiere desgastar los dientes sanos de al lado para sujetarlo, porque tiene su propio soporte en el hueso.
      </p>
      <p>
        No todos los pacientes son candidatos inmediatos: algunas enfermedades sistémicas no controladas, el tabaquismo intenso o una higiene bucal muy descuidada pueden condicionar el tratamiento. Lo revisamos en tu historial clínico durante la primera visita, junto con el estado del hueso en el escáner 3D.
      </p>

      <figure class="trt-diagram">
        <img
          id="trt-diagram-img"
          class="trt-diagram-img"
          src="/img/implantes/partes-implante-claro.webp"
          alt="Partes de un implante dental: corona, pilar, encía, hueso alveolar y el implante de titanio"
          width="1407"
          height="768"
          loading="lazy"
          decoding="async"
        />
        <figcaption class="trt-diagram-caption">Estructura completa de un implante dental: corona, pilar y raíz de titanio integrada en el hueso.</figcaption>
      </figure>
      <script is:inline>
        (function () {
          var img = document.getElementById("trt-diagram-img");
          if (!img) return;

          var sources = {
            light: { desktop: "/img/implantes/partes-implante-claro.webp", mobile: "/img/implantes/partes-implante-claro-mobile.webp" },
            dark: { desktop: "/img/implantes/partes-implante-oscuro.webp", mobile: "/img/implantes/partes-implante-oscuro-mobile.webp" },
          };
          var dims = {
            desktop: { w: 1407, h: 768 },
            mobile: { w: 768, h: 1376 },
          };

          function applyDiagram() {
            var isMobile = window.matchMedia("(max-width: 640px)").matches;
            var isDark = document.documentElement.classList.contains("dark");
            var theme = isDark ? sources.dark : sources.light;
            var size = isMobile ? dims.mobile : dims.desktop;
            img.src = isMobile ? theme.mobile : theme.desktop;
            img.width = size.w;
            img.height = size.h;
          }

          applyDiagram();
          new MutationObserver(applyDiagram).observe(document.documentElement, {
            attributes: true,
            attributeFilter: ["class"],
          });
        })();
      </script>

      <div class="trt-inline-actions">
        <a href="#trt-hero-form-panel" class="trt-btn trt-btn-outline">Ir al formulario</a>
        <a href={whatsappHref('Hola, quiero pedir una valoración gratuita para un implante dental')} target="_blank" rel="noopener noreferrer" class="trt-btn trt-btn-solid">Escríbenos por WhatsApp</a>
      </div>

      <h2>Cómo lo hacemos en Arango Dental Clinic</h2>
      <p>
        Empezamos con un escáner intraoral 3D que nos permite ver con precisión el estado de tu hueso en Benidorm, antes de proponerte ningún tratamiento. Esa información se traduce en una planificación digital: sabemos de antemano dónde y con qué angulación se va a colocar cada implante, en lugar de decidirlo durante la intervención.
      </p>
      <p>
        Utilizamos implantes de titanio de alta calidad, colocados con anestesia local en la propia clínica.
        <!-- PENDIENTE CLÍNICA: marca y origen exactos del sistema de implantes que utiliza la clínica -->
        Si no hay suficiente hueso para alojar el implante con garantías, te lo explicamos en la valoración inicial y evaluamos si hace falta un injerto óseo previo.
      </p>
      <p>
        Durante los días posteriores a la colocación es normal cierta inflamación leve, que suele controlarse con la pauta que te indicamos. La mayoría de los pacientes retoma su rutina habitual al día siguiente, evitando alimentos duros en la zona tratada hasta la revisión.
      </p>

      <h2>El proceso, paso a paso</h2>
      <div class="trt-steps" id="trt-steps">
        {pasos.map((paso, i) => (
          <details class="trt-step-card" data-step={i} open={i === 0}>
            <summary class="trt-step-card-summary">
              <span class="trt-step-card-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="trt-step-card-title">{paso.titulo}</span>
            </summary>
            <p class="trt-step-card-desc">{paso.descripcion}</p>
            <span class="trt-step-card-progress" aria-hidden="true">
              <span class="trt-step-card-progress-bar"></span>
            </span>
          </details>
        ))}
      </div>

      <h2>Precio y financiación</h2>
      <p>
        El precio de un implante dental depende de varios factores: el número de piezas a reemplazar, si hace falta un injerto óseo previo y el tipo de corona elegida. Por eso no damos una cifra cerrada sin antes valorar tu caso en persona.
      </p>
      <!-- PENDIENTE CLÍNICA: tarifas orientativas de implantes dentales; enlazar a /precios/ cuando esa página exista -->
      <p>
        Ofrecemos financiación para que puedas empezar tu tratamiento sin que el coste sea un obstáculo. Te damos los detalles concretos en tu valoración inicial, que es gratuita y sin compromiso.
      </p>
      <p>
        Preferimos ser claros sobre esto: cualquier cifra que veas antes de una valoración presencial es solo orientativa. El presupuesto real se cierra después de ver tu escáner 3D y de decidir juntos el plan de tratamiento, para que sepas exactamente qué vas a pagar y por qué.
      </p>

      <h2>Preguntas frecuentes</h2>
      <div class="trt-faq-list">
        {faqs.map((faq) => (
          <details class="trt-faq-item">
            <summary class="trt-faq-question">{faq.pregunta}</summary>
            <p class="trt-faq-answer">{faq.respuesta}</p>
          </details>
        ))}
      </div>

      <h2>Pide tu valoración sin coste</h2>
      <p>
        La primera consulta es gratuita y sin compromiso. Evaluamos tu caso con nuestro escáner 3D y te explicamos las opciones de tratamiento antes de que decidas nada. Atendemos en Benidorm y su comarca — La Nucía, Alfaz del Pi, Finestrat, Villajoyosa, Altea y Polop — y también recibimos pacientes de otros puntos de la provincia de Alicante que buscan una clínica de implantes dentales de confianza.
      </p>
      <p>
        Puedes escribirnos por WhatsApp, llamarnos por teléfono o acercarte directamente a la clínica en Avinguda Alfonso Puchades. Te atendemos en español, inglés y francés, y respondemos por WhatsApp en menos de 24 horas.
      </p>
      <p>
        Consulta también nuestros <a href="/servicios/">demás servicios dentales</a> si además del implante quieres resolver otras necesidades de tu sonrisa.
      </p>

    </div>
  </section>

  <!-- ── CTA final ── -->
  <section class="trt-cta-section">
    <div class="trt-container trt-cta-inner">
      <h2 class="trt-cta-title">Arango Dental Clinic, tu clínica de implantes en Benidorm</h2>
      <p class="trt-cta-sub">Avinguda Alfonso Puchades, 22, bajo, Benidorm, Alicante 03501</p>
      <div class="trt-cta-actions">
        <a href="tel:+34965088282" class="trt-btn trt-btn-outline">Llamar: 965 08 82 82</a>
        <a href={whatsappHref('Hola, quiero pedir una valoración gratuita para un implante dental')} target="_blank" rel="noopener noreferrer" class="trt-btn trt-btn-solid">Escríbenos por WhatsApp</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── Layout ── */
  .trt-container {
    max-width: 1200px;
    margin: 0 auto;
    padding-left: 2rem;
    padding-right: 2rem;
  }

  /* ── Hero ── */
  .trt-hero {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: #0d2219;
    text-align: center;
  }

  :global(html.dark) .trt-hero {
    background-color: #0d2219;
  }

  .trt-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    display: block;
  }

  .trt-hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(6, 18, 10, 0.72) 0%,
        rgba(6, 18, 10, 0.48) 50%,
        rgba(6, 18, 10, 0.72) 100%
      );
  }

  :global(html.dark) .trt-hero-overlay {
    background:
      linear-gradient(
        180deg,
        rgba(4, 12, 7, 0.82) 0%,
        rgba(4, 12, 7, 0.55) 50%,
        rgba(4, 12, 7, 0.82) 100%
      );
  }

  /* Ya no usa .trt-container: el hero es full-bleed (como el del home),
     con su propio padding lateral — así el 35% del formulario se calcula
     sobre el ancho real de la pantalla, igual que en HeroScroll.astro,
     en vez de sobre el max-width:1200px que sí aplica al resto del
     contenido de la página. */
  .trt-hero-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
    padding: 7rem 2rem 4rem;
    box-sizing: border-box;
  }

  .trt-hero-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  /* Desktop: texto a la izquierda, formulario a la derecha — ya no
     centrado en una sola columna. */
  @media (min-width: 900px) {
    .trt-hero-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 3rem;
      text-align: left;
      padding-left: 6%;
      padding-right: 4%;
    }

    .trt-hero-text {
      align-items: flex-start;
      text-align: left;
      flex: 1 1 auto;
      max-width: 560px;
    }
  }

  .trt-label {
    font-family: "Inter", sans-serif;
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #C49B38;
  }

  :global(html.dark) .trt-label {
    color: #D4AF55;
  }

  .trt-hero-title {
    font-family: "Cormorant Garamond", serif;
    font-size: clamp(2.4rem, 5.5vw, 4rem);
    font-weight: 300;
    font-style: italic;
    line-height: 1.15;
    color: rgba(244, 240, 235, 0.95);
    margin: 0;
  }

  .trt-hero-sub {
    font-family: "Inter", sans-serif;
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(244, 240, 235, 0.65);
    max-width: 62ch;
    margin: 0;
  }

  .trt-hero-actions {
    margin-top: 0.5rem;
  }

  /* ── Formulario del hero — mismos campos y mismo endpoint que el hero
     del home (HeroScroll.astro), con el mismo tratamiento visual (panel
     semitransparente + blur ligero, campos con fondo propio opaco). Tonos
     ajustados al verde de esta página (#0d2219) en vez del de la home. */
  .trt-hero-form-panel {
    width: 100%;
    max-width: 380px;
    padding: 1.5rem 1.5rem 1.75rem;
    background-color: rgba(13, 34, 25, 0.45);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid rgba(244, 240, 235, 0.14);
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.3);
    text-align: left;
  }

  /* Mismo ancho relativo que el panel del hero del home: 35% del hero,
     no un ancho fijo — por eso también le sacamos el max-width. */
  @media (min-width: 900px) {
    .trt-hero-form-panel {
      /* 39% acá da el mismo ancho en px que el 35% del hero del home
         (~500px a 1440px de viewport) — la diferencia es porque este
         panel resta su propio padding/gap del cálculo (border-box) y el
         del home no, al ser position:absolute. Ajustado a ojo para que
         coincida en píxeles reales, no solo en el número del porcentaje. */
      flex: 0 0 39%;
      max-width: none;
      padding: 2.75rem 2.5rem;
    }
  }

  .trt-hero-form-eyebrow {
    font-family: "Inter", sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #C49B38;
    margin: 0 0 0.5rem;
  }

  :global(html.dark) .trt-hero-form-eyebrow {
    color: #D4AF55;
  }

  .trt-hero-form-title {
    font-family: "Cormorant Garamond", serif;
    font-size: 1.5rem;
    font-weight: 400;
    color: rgba(244, 240, 235, 0.95);
    margin: 0 0 1rem;
  }

  .trt-hero-form {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .trt-hero-form-honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .trt-hero-form-input {
    width: 100%;
    padding: 0.75rem 0.9rem;
    font-family: "Inter", sans-serif;
    font-size: 0.88rem;
    color: rgba(244, 240, 235, 0.95);
    background-color: #142720;
    border: 1px solid rgba(244, 240, 235, 0.2);
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .trt-hero-form-input::placeholder {
    color: rgba(244, 240, 235, 0.45);
  }

  .trt-hero-form-input:focus {
    outline: none;
    border-color: #D4AF55;
    background-color: #1b3229;
  }

  .trt-hero-form-consent {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    font-family: "Inter", sans-serif;
    font-size: 0.7rem;
    line-height: 1.4;
    color: rgba(244, 240, 235, 0.6);
    cursor: pointer;
  }

  .trt-hero-form-consent input {
    margin-top: 0.15rem;
    flex-shrink: 0;
  }

  .trt-hero-form-consent a {
    color: rgba(244, 240, 235, 0.85);
    text-decoration: underline;
  }

  .trt-hero-form-submit {
    margin-top: 0.2rem;
    padding: 0.8rem 1rem;
    font-family: "Inter", sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
