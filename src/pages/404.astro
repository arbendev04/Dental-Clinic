---
import Layout from '../layouts/Layout.astro';

const links = [
  { href: '/',          label: 'Inicio'    },
  { href: '/servicios', label: 'Servicios' },
  { href: '/nosotros',  label: 'Nosotros'  },
  { href: '/contacto',  label: 'Contacto'  },
];
---

<Layout
  title="Página no encontrada"
  description="La página que buscas no existe o se movió. Vuelve al inicio o contacta con Arango Dental Clinic en Benidorm."
  noindex
>
  <section class="err-hero">
    <p class="err-code" aria-hidden="true">
      <span class="err-code-char">4</span><span class="err-code-char">0</span><span class="err-code-char">4</span>
    </p>
    <div class="err-container">
      <p class="err-label">Arango Dental Clinic</p>
      <h1 class="err-title">Esta página no existe</h1>
      <p class="err-sub">
        Puede que el enlace esté roto o que la página se haya movido. Probá con el inicio o con alguno de estos accesos.
      </p>
      <div class="err-actions">
        <a href="/" class="err-btn err-btn-solid">Volver al inicio</a>
        <a href="/contacto" class="err-btn err-btn-outline">Contactar</a>
      </div>
      <nav class="err-links" aria-label="Páginas principales">
        {links.map((l) => (
          <a href={l.href} class="err-link">{l.label}</a>
        ))}
      </nav>
    </div>
  </section>
</Layout>

<style>
  .err-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    background-color: #0d2219;
    padding: 8rem 0 5rem;
    text-align: center;
    overflow: hidden;
  }

  :global(html.dark) .err-hero {
    background-color: #0d2219;
  }

  .err-container {
    position: relative;
    z-index: 1;
    max-width: 720px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .err-label {
    font-family: "Inter", sans-serif;
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #C49B38;
    margin: 0;
  }

  :global(html.dark) .err-label {
    color: #D4AF55;
  }

  /* Tipografía cinética de fondo: pieza gigante, no contenido —
     decorativa, detrás del contenido real (aria-hidden). */
  .err-code {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: "Cormorant Garamond", serif;
    font-size: clamp(14rem, 42vw, 34rem);
    font-weight: 300;
    font-style: italic;
    line-height: 1;
    color: #C49B38;
    margin: 0;
    pointer-events: none;
    user-select: none;
  }

  @media (min-width: 1024px) {
    .err-code {
      font-size: clamp(30rem, 46vw, 50rem);
    }
  }

  :global(html.dark) .err-code {
    color: #D4AF55;
  }

  /* Cada dígito entra por separado desde la derecha, de a uno,
     cada 0.3s — sin loop, queda estático al terminar. */
  .err-code-char {
    display: inline-block;
    opacity: 0;
    transform: translateX(120px);
    animation: err-code-char-reveal 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .err-code-char:nth-child(1) { animation-delay: 0s; }
  .err-code-char:nth-child(2) { animation-delay: 0.3s; }
  .err-code-char:nth-child(3) { animation-delay: 0.6s; }

  @keyframes err-code-char-reveal {
    to {
      opacity: 0.04;
      transform: translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .err-code-char {
      animation: none;
      opacity: 0.04;
      transform: none;
    }
  }

  .err-title {
    font-family: "Cormorant Garamond", serif;
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    font-weight: 300;
    font-style: italic;
    line-height: 1.15;
    color: rgba(244, 240, 235, 0.95);
    margin: 0;
  }

  .err-sub {
    font-family: "Inter", sans-serif;
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(244, 240, 235, 0.50);
    max-width: 46ch;
    margin: 0;
  }

  .err-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  @media (min-width: 480px) {
    .err-actions {
      flex-direction: row;
    }
  }

  .err-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: "Inter", sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.875rem 2rem;
    transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
    white-space: nowrap;
  }

  .err-btn-solid {
    background-color: #C49B38;
    color: #0d2219;
    border: 1px solid #C49B38;
  }

  .err-btn-solid:hover {
    background-color: transparent;
    color: rgba(244, 240, 235, 0.85);
    border-color: rgba(244, 240, 235, 0.35);
  }

  :global(html.dark) .err-btn-solid {
    background-color: #D4AF55;
    color: #141210;
    border-color: #D4AF55;
  }

  :global(html.dark) .err-btn-solid:hover {
    background-color: transparent;
    color: rgba(244, 240, 235, 0.85);
    border-color: rgba(244, 240, 235, 0.35);
  }

  .err-btn-outline {
    background-color: transparent;
    color: rgba(244, 240, 235, 0.85);
    border: 1px solid rgba(244, 240, 235, 0.35);
  }

  .err-btn-outline:hover {
    background-color: rgba(244, 240, 235, 0.1);
    border-color: rgba(244, 240, 235, 0.6);
  }

  .err-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(244, 240, 235, 0.15);
    width: 100%;
  }

  .err-link {
    font-family: "Inter", sans-serif;
    font-size: 0.8rem;
    color: rgba(244, 240, 235, 0.55);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .err-link:hover {
    color: rgba(244, 240, 235, 0.9);
  }
</style>
