---
import Layout from '../layouts/Layout.astro';

const links = [
  { href: '/',          label: 'Inicio'    },
  { href: '/servicios', label: 'Servicios' },
  { href: '/nosotros',  label: 'Nosotros'  },
  { href: '/contacto',  label: 'Contacto'  },
  { href: '/reservar',  label: 'Reservar Cita' },
];
---

<Layout
  title="Página no encontrada"
  description="La página que buscás no existe o se movió. Volvé al inicio o contactá con Arango Dental Clinic en Benidorm."
  noindex
>
  <section class="err-hero">
    <p class="err-code" aria-hidden="true">404</p>
    <div class="err-container">
      <p class="err-label">Arango Dental Clinic</p>
      <h1 class="err-title">Esta página no existe</h1>
      <p class="err-sub">
        Puede que el enlace esté roto o que la página se haya movido. Probá con el inicio o con alguno de estos accesos.
      </p>
      <div class="err-actions">
        <a href="/" class="err-btn err-btn-solid">Volver al inicio</a>
        <a href="/contacto" class="err-btn err-btn-outline">Contactar</a>
      </div>
      <nav class="err-links" aria-label="Páginas principales">
        {links.map((l) => (
          <a href={l.href} class="err-link">{l.label}</a>
        ))}
      </nav>
    </div>
  </section>
</Layout>

<style>
  .err-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    background-color: var(--bg-primary);
    padding: 8rem 0 5rem;
    text-align: center;
    overflow: hidden;
    transition: background-color 0.3s ease;
  }

  .err-container {
    position: relative;
    z-index: 1;
    max-width: 720px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .err-label {
    font-family: "Inter", sans-serif;
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #C49B38;
    margin: 0;
  }

  :global(html.dark) .err-label {
    color: #D4AF55;
  }

  /* Tipografía cinética de fondo: pieza gigante, no contenido —
     decorativa, detrás del contenido real (aria-hidden). */
  .err-code {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: "Cormorant Garamond", serif;
    font-size: clamp(14rem, 42vw, 34rem);
    font-weight: 300;
    font-style: italic;
    line-height: 1;
    color: #C49B38;
    margin: 0;
    pointer-events: none;
    user-select: none;

    /* Entrada única, sin loop: opacity 0 / scale 0.85 / y+40px
       → opacity 0.04 / scale 1 / y 0, en 1.2s con easing premium. */
    opacity: 0;
    transform: translateY(40px) scale(0.85);
    animation: err-code-reveal 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  :global(html.dark) .err-code {
    color: #D4AF55;
  }

  @keyframes err-code-reveal {
    to {
      opacity: 0.04;
      transform: translateY(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .err-code {
      animation: none;
      opacity: 0.04;
      transform: none;
    }
  }

  .err-title {
    font-family: "Cormorant Garamond", serif;
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    font-weight: 300;
    font-style: italic;
    line-height: 1.15;
    color: var(--text-primary);
    margin: 0;
  }

  .err-sub {
    font-family: "Inter", sans-serif;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 46ch;
    margin: 0;
  }

  .err-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  @media (min-width: 480px) {
    .err-actions {
      flex-direction: row;
    }
  }

  .err-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: "Inter", sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.875rem 2rem;
    transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
    white-space: nowrap;
  }

  .err-btn-solid {
    background-color: #153328;
    color: #ffffff;
    border: 1px solid #153328;
  }

  .err-btn-solid:hover {
    background-color: transparent;
    color: #153328;
    border-color: rgba(21, 51, 40, 0.65);
  }

  :global(html.dark) .err-btn-solid {
    background-color: #D4AF55;
    color: #141210;
    border-color: #D4AF55;
  }

  :global(html.dark) .err-btn-solid:hover {
    background-color: transparent;
    color: rgba(244, 240, 235, 0.85);
    border-color: rgba(244, 240, 235, 0.30);
  }

  .err-btn-outline {
    background-color: transparent;
    color: #153328;
    border: 1px solid rgba(21, 51, 40, 0.65);
  }

  .err-btn-outline:hover {
    background-color: #153328;
    color: #ffffff;
    border-color: #153328;
  }

  :global(html.dark) .err-btn-outline {
    color: rgba(244, 240, 235, 0.85);
    border-color: rgba(244, 240, 235, 0.30);
  }

  :global(html.dark) .err-btn-outline:hover {
    background-color: #D4AF55;
    color: #141210;
    border-color: #D4AF55;
  }

  .err-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-primary);
    width: 100%;
  }

  .err-link {
    font-family: "Inter", sans-serif;
    font-size: 0.8rem;
    color: var(--text-tertiary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .err-link:hover {
    color: var(--text-primary);
  }
</style>
