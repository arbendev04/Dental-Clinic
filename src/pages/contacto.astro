---
import Layout from '../layouts/Layout.astro';

const faqs = [
  {
    pregunta: '¿Cuál es el horario de atención?',
    respuesta: 'Atendemos de lunes a jueves de 10:00 a 14:00 y de 15:00 a 19:00, y los viernes de 10:00 a 14:00. Permanecemos cerrados los fines de semana.',
  },
  {
    pregunta: '¿Dónde está ubicada la clínica?',
    respuesta: 'Arango Dental Clinic está en Avinguda Alfonso Puchades, 22, bajo, Benidorm, Alicante 03501.',
  },
  {
    pregunta: '¿La primera consulta es gratuita?',
    respuesta: 'Sí. La primera valoración es gratuita y sin compromiso: evaluamos tu caso y te explicamos las opciones de tratamiento antes de que decidas nada.',
  },
  {
    pregunta: '¿Cómo puedo reservar una cita?',
    respuesta: 'Puedes llamarnos al 965 08 82 82, escribirnos por WhatsApp al 665 886 439, o completar el formulario de esta página. Respondemos en menos de 24 horas.',
  },
  {
    pregunta: '¿Qué servicios ofrece Arango Dental Clinic?',
    respuesta: 'Ofrecemos Odontología Digital, Implantología, Estética Dental, Rehabilitación Oral, Periodoncia y Ortodoncia, con tecnología de escáner intraoral 3D y radiografía digital.',
  },
  {
    pregunta: '¿Cuánto cuesta un implante dental?',
    respuesta: 'El precio de un implante dental se evalúa según las necesidades de cada paciente, tras una valoración inicial gratuita en la que definimos el plan de tratamiento más adecuado.',
  },
  {
    pregunta: '¿Cuánto cuesta la ortodoncia?',
    respuesta: 'El precio de la ortodoncia (brackets o alineadores invisibles) se evalúa según las necesidades de cada paciente, tras una valoración inicial gratuita.',
  },
  {
    pregunta: '¿Atienden a turistas o pacientes extranjeros?',
    respuesta: 'Sí, recibimos habitualmente a turistas y residentes extranjeros en la zona. Nuestro equipo atiende en español, inglés y francés.',
  },
  {
    pregunta: '¿Trabajan con seguros dentales?',
    respuesta: 'No trabajamos con seguros dentales; la atención es particular. Sí ofrecemos financiación para que puedas empezar tu tratamiento sin que el pago sea un obstáculo.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.pregunta,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.respuesta,
    },
  })),
};
---

<Layout title="Contacto en Benidorm" description="Contacta con Arango Dental Clinic en Benidorm: llámanos al 965 08 82 82, escríbenos por WhatsApp o visítanos en Avinguda Alfonso Puchades, 22, bajo, Benidorm." image="/img/contacto/contacto.webp">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <!-- Header -->
  <section class="ctt-hero" data-scroll-hero>
    <img
      src="/img/contacto/contacto.webp"
      alt="Interior de Arango Dental Clinic en Benidorm"
      class="ctt-hero-img"
      width="1717"
      height="916"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="ctt-hero-overlay" aria-hidden="true"></div>
    <div class="ctt-container ctt-hero-inner">
      <p class="ctt-label">Arango Dental Clinic</p>
      <h1 class="ctt-hero-title">Da el primer paso hacia<br>tu mejor sonrisa</h1>
      <p class="ctt-hero-sub">
        Agenda tu cita hoy y descubre cómo podemos transformar tu sonrisa.
      </p>
      <div class="ctt-hero-actions">
        <a href="tel:+34965088282" class="ctt-btn ctt-btn-outline">Llamar ahora</a>
        <a href="https://wa.me/34665886439" target="_blank" rel="noopener" class="ctt-btn ctt-btn-solid">WhatsApp</a>
      </div>
    </div>
  </section>

  <!-- Info + Form -->
  <section class="py-16 md:py-24 px-4 lg:px-20 transition-colors" style="background-color: var(--bg-primary);">
    <div class="container mx-auto">
      <div class="grid md:grid-cols-2 gap-16 max-w-6xl mx-auto">

        <!-- Contact Info -->
        <div>
          <p class="ctt-label" style="margin-bottom: 0.75rem;">Tu mejor aliado dental</p>
          <h2 class="text-3xl font-normal mb-10" style="font-family: 'Cormorant Garamond', serif; color: var(--text-primary);">Información de Contacto</h2>

          <div class="space-y-7">
            <!-- Dirección -->
            <div class="flex items-start gap-4">
              <div class="ctt-icon-box">
                <svg class="w-5 h-5" style="color: var(--teal-600);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <h3 class="ctt-info-label">Dirección</h3>
                <p class="ctt-info-text">Avinguda Alfonso Puchades, 22, bajo<br>Benidorm, Alicante 03501</p>
              </div>
            </div>

            <!-- Teléfono -->
            <div class="flex items-start gap-4">
              <div class="ctt-icon-box">
                <svg class="w-5 h-5" style="color: var(--teal-600);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <h3 class="ctt-info-label">Teléfono</h3>
                <a href="tel:+34965088282" class="ctt-info-text ctt-link">+34 965 08 82 82</a>
              </div>
            </div>

            <!-- Email -->
            <div class="flex items-start gap-4">
              <div class="ctt-icon-box">
                <svg class="w-5 h-5" style="color: var(--teal-600);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <h3 class="ctt-info-label">Email</h3>
                <a href="mailto:Arangodentalclinic@gmail.com" class="ctt-info-text ctt-link">Arangodentalclinic@gmail.com</a>
              </div>
            </div>

            <!-- Horario -->
            <div class="flex items-start gap-4">
              <div class="ctt-icon-box">
                <svg class="w-5 h-5" style="color: var(--teal-600);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <h3 class="ctt-info-label">Horario</h3>
                <p class="ctt-info-text">Lun – Jue: 10:00 – 14:00 y 15:00 – 19:00<br>Viernes: 10:00 – 14:00</p>
              </div>
            </div>

            <!-- Redes -->
            <div class="flex items-start gap-4">
              <div class="ctt-icon-box">
                <svg class="w-5 h-5" style="color: var(--teal-600);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                </svg>
              </div>
              <div>
                <h3 class="ctt-info-label">Síguenos</h3>
                <div class="flex flex-col gap-1 mt-1">
                  <a href="https://www.instagram.com/arangodentalclinic" target="_blank" rel="noopener" class="ctt-social-link">
                    Instagram · @arangodentalclinic
                  </a>
                  <a href="https://www.facebook.com/p/Arango-Dental-Clinic-61574405870200/" target="_blank" rel="noopener" class="ctt-social-link">
                    Facebook · Arango Dental Clinic
                  </a>
                  <a href="https://wa.me/34665886439" target="_blank" rel="noopener" class="ctt-social-link">
                    WhatsApp · +34 665 886 439
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Contact Form -->
        <div>
          <p class="ctt-label" style="margin-bottom: 0.75rem;">Valoración sin costo</p>
          <h2 class="text-3xl font-normal mb-10" style="font-family: 'Cormorant Garamond', serif; color: var(--text-primary);">Empieza tu tratamiento</h2>
          <form
            id="contact-form"
            class="space-y-5"
            action="https://formspree.io/f/xqpzklag"
            method="POST"
          >
            <input type="hidden" name="_subject" value="Nueva solicitud de contacto — Arango Dental Clinic" />
            <input type="text" id="gotcha" name="_gotcha" class="ctt-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <div>
              <label for="nombre" class="ctt-field-label">Nombre completo</label>
              <input
                type="text"
                id="nombre"
                name="nombre"
                class="ctt-input"
                placeholder="Tu nombre y apellidos"
                required
              />
            </div>
            <div>
              <label for="telefono" class="ctt-field-label">Teléfono</label>
              <input
                type="tel"
                id="telefono"
                name="telefono"
                class="ctt-input"
                placeholder="+34 600 000 000"
                required
              />
            </div>
            <div>
              <label for="email" class="ctt-field-label">Email <span class="ctt-optional">(opcional)</span></label>
              <input
                type="email"
                id="email"
                name="email"
                class="ctt-input"
                placeholder="tu@email.com"
              />
            </div>
            <div>
              <p class="ctt-field-label" id="ctt-tratamiento-label">¿Qué tratamiento te interesa? <span class="ctt-optional">(opcional)</span></p>
              <div class="ctt-dropdown" id="ctt-dropdown">
                <button
                  type="button"
                  class="ctt-dropdown-toggle"
                  id="ctt-dropdown-toggle"
                  aria-haspopup="listbox"
                  aria-expanded="false"
                  aria-labelledby="ctt-tratamiento-label ctt-dropdown-summary"
                >
                  <span id="ctt-dropdown-summary">Selecciona uno o varios</span>
                  <svg class="ctt-dropdown-chevron" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6" />
                  </svg>
                </button>
                <div class="ctt-dropdown-panel" id="ctt-dropdown-panel" role="listbox" aria-multiselectable="true" hidden>
                  {['Odontología Digital', 'Implantología', 'Estética Dental', 'Rehabilitación Oral', 'Periodoncia', 'Ortodoncia', 'Endodoncia', 'Otro'].map((servicio) => (
                    <label class="ctt-dropdown-option">
                      <input type="checkbox" name="servicios[]" value={servicio} />
                      <span class="ctt-dropdown-check" aria-hidden="true"></span>
                      <span>{servicio}</span>
                    </label>
                  ))}
                </div>
              </div>
              <div id="ctt-otro-wrapper" class="ctt-otro-wrapper" hidden>
                <input
                  type="text"
                  id="servicio_otro"
                  name="servicio_otro"
                  class="ctt-input"
                  placeholder="Cuéntanos brevemente qué necesitas"
                />
              </div>
            </div>
            <div class="ctt-consent">
              <label class="ctt-consent-label">
                <input type="checkbox" id="consentimiento" name="consentimiento" required />
                <span>He leído y acepto la <a href="/politica-privacidad" target="_blank" rel="noopener">Política de Privacidad</a>.</span>
              </label>
            </div>
            <div>
              <button type="submit" id="contact-submit" class="ctt-submit">
                Solicitar Valoración Gratuita
              </button>
              <p class="ctt-trust-line">Sin compromiso · Te contactamos en menos de 24h</p>
            </div>
          </form>
          <p id="contact-form-status" class="ctt-form-status" role="status" aria-live="polite" hidden></p>
        </div>

      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="ctt-faq-section">
    <div class="ctt-container">
      <div class="ctt-faq-header">
        <p class="ctt-label">Resolvemos tus dudas</p>
        <h2 class="ctt-faq-title">Preguntas frecuentes</h2>
      </div>
      <div class="ctt-faq-list">
        {faqs.map((faq) => (
          <details class="ctt-faq-item">
            <summary class="ctt-faq-question">{faq.pregunta}</summary>
            <p class="ctt-faq-answer">{faq.respuesta}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Mapa -->
  <section class="ctt-map-section">
    <iframe
      class="ctt-map"
      src="https://www.google.com/maps?q=Arango+Dental+Clinic,+Avinguda+Alfonso+Puchades,+22,+bajo,+Benidorm&output=embed"
      width="100%"
      height="400"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      title="Ubicación de Arango Dental Clinic en Google Maps"
    ></iframe>
  </section>

</Layout>

<style>
  /* ── Hero ── */
  .ctt-hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: #0d2219;
    text-align: center;
  }

  :global(html.dark) .ctt-hero {
    background-color: #0d2219;
  }

  .ctt-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    display: block;
  }

  .ctt-hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(6, 18, 10, 0.72) 0%,
        rgba(6, 18, 10, 0.48) 50%,
        rgba(6, 18, 10, 0.72) 100%
      );
  }

  :global(html.dark) .ctt-hero-overlay {
    background:
      linear-gradient(
        180deg,
        rgba(4, 12, 7, 0.82) 0%,
        rgba(4, 12, 7, 0.55) 50%,
        rgba(4, 12, 7, 0.82) 100%
      );
  }

  .ctt-container {
    max-width: 1200px;
    margin: 0 auto;
    padding-left: 2rem;
    padding-right: 2rem;
  }

  .ctt-hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    padding-top: 7rem;
    padding-bottom: 6rem;
  }

  .ctt-label {
    font-family: "Inter", sans-serif;
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #C49B38;
  }

  :global(html.dark) .ctt-label {
    color: #D4AF55;
  }

  .ctt-hero-title {
    font-family: "Cormorant Garamond", serif;
    font-size: clamp(2.4rem, 5vw, 4.2rem);
    font-weight: 300;
    font-style: italic;
    line-height: 1.15;
    color: rgba(244, 240, 235, 0.95);
    margin: 0;
  }

  .ctt-hero-sub {
    font-family: "Inter", sans-serif;
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(244, 240, 235, 0.50);
    max-width: 48ch;
    margin: 0;
  }

  .ctt-hero-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  @media (min-width: 480px) {
    .ctt-hero-actions { flex-direction: row; }
  }

  /* ── Botones hero ── */
  .ctt-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: "Inter", sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.875rem 2rem;
    transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
    white-space: nowrap;
  }

  .ctt-btn-outline {
    background-color: transparent;
    color: rgba(244, 240, 235, 0.85);
    border: 1px solid rgba(244, 240, 235, 0.35);
  }

  .ctt-btn-outline:hover {
    background-color: rgba(244, 240, 235, 0.1);
    border-color: rgba(244, 240, 235, 0.6);
  }

  .ctt-btn-solid {
    background-color: #C49B38;
    color: #0d2219;
    border: 1px solid #C49B38;
  }

  .ctt-btn-solid:hover {
    background-color: rgba(196, 155, 56, 0.12);
    color: rgba(244, 240, 235, 0.9);
    border-color: #C49B38;
  }

  :global(html.dark) .ctt-btn-solid {
    background-color: #D4AF55;
    color: #141210;
    border-color: #D4AF55;
  }

  :global(html.dark) .ctt-btn-solid:hover {
    background-color: rgba(212, 175, 85, 0.12);
    color: rgba(244, 240, 235, 0.9);
    border-color: #D4AF55;
  }

  /* ── Info bloque ── */
  .ctt-icon-box {
    width: 3rem;
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background-color: var(--teal-100);
  }

  .ctt-info-label {
    font-family: "Cormorant Garamond", serif;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .ctt-info-text {
    font-family: "Inter", sans-serif;
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--text-secondary);
    text-decoration: none;
    display: block;
  }

  .ctt-link:hover {
    color: var(--teal-600);
  }

  .ctt-social-link {
    font-family: "Inter", sans-serif;
    font-size: 0.85rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s;
  }

  .ctt-social-link:hover {
    color: var(--teal-600);
  }

  /* ── Formulario ── */
  .ctt-honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .ctt-field-label {
    display: block;
    font-family: "Inter", sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: 0.4rem;
    letter-spacing: 0.02em;
  }

  .ctt-optional {
    font-weight: 400;
    letter-spacing: normal;
    text-transform: none;
    color: var(--text-tertiary);
  }

  /* ── Dropdown multi-select de tratamientos ── */
  .ctt-dropdown {
    position: relative;
  }

  .ctt-dropdown-toggle {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    font-family: "Inter", sans-serif;
    font-size: 0.9rem;
    text-align: left;
    color: var(--text-primary);
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-primary);
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .ctt-dropdown-toggle:focus-visible {
    border-color: var(--teal-500);
    outline: none;
  }

  .ctt-dropdown-chevron {
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .ctt-dropdown-toggle[aria-expanded="true"] .ctt-dropdown-chevron {
    transform: rotate(180deg);
  }

  .ctt-dropdown-panel {
    position: absolute;
    top: calc(100% + 0.4rem);
    left: 0;
    right: 0;
    z-index: 20;
    max-height: 16rem;
    overflow-y: auto;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-primary);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.25);
  }

  .ctt-dropdown-option {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.65rem 1rem;
    font-family: "Inter", sans-serif;
    font-size: 0.85rem;
    color: var(--text-secondary);
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .ctt-dropdown-option:hover {
    background-color: var(--bg-tertiary);
  }

  .ctt-dropdown-option input[type="checkbox"] {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .ctt-dropdown-check {
    flex-shrink: 0;
    width: 1.1rem;
    height: 1.1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-secondary);
    background-color: transparent;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .ctt-dropdown-option input:checked + .ctt-dropdown-check {
    background-color: #C49B38;
    border-color: #C49B38;
  }

  .ctt-dropdown-option input:checked + .ctt-dropdown-check::after {
    content: '✓';
    font-size: 0.7rem;
    line-height: 1;
    color: #0d2219;
  }

  :global(html.dark) .ctt-dropdown-option input:checked + .ctt-dropdown-check {
    background-color: #D4AF55;
    border-color: #D4AF55;
  }

  :global(html.dark) .ctt-dropdown-option input:checked + .ctt-dropdown-check::after {
    color: #141210;
  }

  .ctt-dropdown-option input:focus-visible + .ctt-dropdown-check {
    outline: 2px solid var(--teal-500);
    outline-offset: 2px;
  }

  .ctt-otro-wrapper {
    margin-top: 0.75rem;
  }

  .ctt-consent-label {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-family: "Inter", sans-serif;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--text-secondary);
    cursor: pointer;
  }

  .ctt-consent-label input[type="checkbox"] {
    flex-shrink: 0;
    margin-top: 0.15rem;
    accent-color: var(--teal-500);
    cursor: pointer;
  }

  .ctt-consent-label a {
    color: var(--teal-600);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .ctt-trust-line {
    margin-top: 0.85rem;
    text-align: center;
    font-family: "Inter", sans-serif;
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #C49B38;
  }

  :global(html.dark) .ctt-trust-line {
    color: #D4AF55;
  }

  .ctt-input {
    width: 100%;
    padding: 0.75rem 1rem;
    outline: none;
    font-family: "Inter", sans-serif;
    font-size: 0.9rem;
    transition: border-color 0.2s;
    border: 1px solid var(--border-primary);
    background-color: var(--bg-secondary);
    color: var(--text-primary);
  }

  .ctt-input:focus {
    border-color: var(--teal-500);
  }

  .ctt-textarea {
    resize: none;
  }

  .ctt-submit {
    width: 100%;
    padding: 1rem;
    font-family: "Inter", sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #ffffff;
    background-color: #153328;
    border: 1px solid #153328;
    cursor: pointer;
    transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }

  .ctt-submit:hover {
    background-color: transparent;
    color: #153328;
    border-color: rgba(21, 51, 40, 0.65);
  }

  .ctt-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  :global(html.dark) .ctt-submit {
    background-color: #D4AF55;
    color: #141210;
    border-color: #D4AF55;
  }

  :global(html.dark) .ctt-submit:hover {
    background-color: transparent;
    color: rgba(244, 240, 235, 0.85);
    border-color: rgba(244, 240, 235, 0.30);
  }

  .ctt-form-status {
    margin-top: 1.25rem;
    padding: 0.875rem 1rem;
    font-family: "Inter", sans-serif;
    font-size: 0.85rem;
    line-height: 1.6;
    border: 1px solid var(--border-primary);
    color: var(--text-secondary);
  }

  .ctt-form-status-success {
    border-color: var(--teal-500);
    color: var(--teal-600);
  }

  .ctt-form-status-error {
    border-color: #b3423a;
    color: #b3423a;
  }

  /* ── FAQ ── */
  .ctt-faq-section {
    background-color: var(--bg-primary);
    padding: 5rem 0;
  }

  .ctt-faq-header {
    text-align: center;
    margin-bottom: 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .ctt-faq-title {
    font-family: "Cormorant Garamond", serif;
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 300;
    color: var(--text-primary);
    margin: 0;
  }

  .ctt-faq-list {
    max-width: 760px;
    margin: 0 auto;
  }

  .ctt-faq-item {
    border-bottom: 1px solid var(--border-primary);
    padding: 1.25rem 0;
  }

  .ctt-faq-question {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-family: "Inter", sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .ctt-faq-question::-webkit-details-marker {
    display: none;
  }

  .ctt-faq-question::after {
    content: '+';
    flex-shrink: 0;
    font-family: "Cormorant Garamond", serif;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--teal-600);
    transition: transform 0.25s ease;
  }

  .ctt-faq-item[open] .ctt-faq-question::after {
    transform: rotate(45deg);
  }

  .ctt-faq-answer {
    font-family: "Inter", sans-serif;
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin: 0.75rem 0 0;
  }

  /* ── Mapa ── */
  .ctt-map-section {
    background-color: var(--bg-secondary);
  }

  .ctt-map {
    display: block;
    width: 100%;
    height: 400px;
    filter: grayscale(0.3) contrast(1.05);
    transition: filter 0.3s ease;
  }

  .ctt-map:hover {
    filter: grayscale(0) contrast(1);
  }

  :global(html.dark) .ctt-map {
    filter: grayscale(0.4) contrast(1.1) invert(0.92) hue-rotate(180deg);
  }

  :global(html.dark) .ctt-map:hover {
    filter: grayscale(0.2) contrast(1.05) invert(0.92) hue-rotate(180deg);
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;
  const status = document.getElementById('contact-form-status') as HTMLElement | null;

  const dropdown = document.getElementById('ctt-dropdown');
  const dropdownToggle = document.getElementById('ctt-dropdown-toggle') as HTMLButtonElement | null;
  const dropdownPanel = document.getElementById('ctt-dropdown-panel') as HTMLElement | null;
  const dropdownSummary = document.getElementById('ctt-dropdown-summary') as HTMLElement | null;
  const dropdownCheckboxes = dropdownPanel?.querySelectorAll<HTMLInputElement>('input[type="checkbox"]');
  const otroCheckbox = dropdownPanel?.querySelector<HTMLInputElement>('input[value="Otro"]');
  const otroWrapper = document.getElementById('ctt-otro-wrapper') as HTMLElement | null;

  function closeDropdown() {
    if (!dropdownPanel || !dropdownToggle) return;
    dropdownPanel.hidden = true;
    dropdownToggle.setAttribute('aria-expanded', 'false');
  }

  function updateDropdownSummary() {
    if (!dropdownCheckboxes || !dropdownSummary) return;
    const selected = Array.from(dropdownCheckboxes).filter((cb) => cb.checked).map((cb) => cb.value);
    if (selected.length === 0) {
      dropdownSummary.textContent = 'Selecciona uno o varios';
    } else if (selected.length <= 2) {
      dropdownSummary.textContent = selected.join(', ');
    } else {
      dropdownSummary.textContent = `${selected.length} tratamientos seleccionados`;
    }
  }

  dropdownToggle?.addEventListener('click', () => {
    if (!dropdownPanel) return;
    const isOpen = !dropdownPanel.hidden;
    dropdownPanel.hidden = isOpen;
    dropdownToggle.setAttribute('aria-expanded', String(!isOpen));
  });

  document.addEventListener('click', (event) => {
    if (dropdown && !dropdown.contains(event.target as Node)) {
      closeDropdown();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeDropdown();
      dropdownToggle?.focus();
    }
  });

  dropdownCheckboxes?.forEach((checkbox) => {
    checkbox.addEventListener('change', () => {
      updateDropdownSummary();
      if (checkbox === otroCheckbox && otroWrapper) {
        otroWrapper.hidden = !checkbox.checked;
      }
    });
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!submitBtn || !status) return;

    submitBtn.disabled = true;
    submitBtn.textContent = 'Enviando…';
    status.hidden = true;
    status.className = 'ctt-form-status';

    const nombre = (document.getElementById('nombre') as HTMLInputElement | null)?.value ?? '';
    const telefono = (document.getElementById('telefono') as HTMLInputElement | null)?.value ?? '';
    const email = (document.getElementById('email') as HTMLInputElement | null)?.value ?? '';

    // Junta los tratamientos seleccionados en el desplegable en un solo texto
    // legible para el campo Description del Lead (si eligió "Otro", reemplaza
    // ese chip por el detalle que haya escrito).
    const tratamientos = dropdownCheckboxes
      ? Array.from(dropdownCheckboxes).filter((cb) => cb.checked).map((cb) => cb.value)
      : [];
    const otroTexto = (document.getElementById('servicio_otro') as HTMLInputElement | null)?.value.trim();
    if (otroTexto) {
      const otroIndex = tratamientos.indexOf('Otro');
      if (otroIndex !== -1) tratamientos[otroIndex] = `Otro: ${otroTexto}`;
    }
    const tratamiento = tratamientos.join(', ');
    const consentimiento = (document.getElementById('consentimiento') as HTMLInputElement | null)?.checked ?? false;
    const _gotcha = (document.getElementById('gotcha') as HTMLInputElement | null)?.value ?? '';

    try {
      const response = await fetch('/api/lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ nombre, telefono, email, tratamiento, consentimiento, _gotcha }),
      });

      const data = await response.json().catch(() => null);

      if (response.ok && data?.success) {
        form.hidden = true;
        status.textContent = '¡Gracias! Te contactaremos pronto.';
        status.classList.add('ctt-form-status-success');
        status.hidden = false;

        // Evento de conversión para GTM. El envío es AJAX (preventDefault + fetch),
        // así que el trigger nativo "Form Submission" de GTM nunca dispara solo:
        // hay que empujar el evento explícitamente al dataLayer.
        (window as any).dataLayer = (window as any).dataLayer || [];
        (window as any).dataLayer.push({
          event: 'form_submit_success',
          form_name: 'contacto',
        });
        return;
      }

      status.textContent = data?.error || 'No hemos podido enviar tu solicitud. Intenta de nuevo o escríbenos por WhatsApp.';
      status.classList.add('ctt-form-status-error');
      status.hidden = false;
    } catch {
      status.textContent = 'No hemos podido enviar tu solicitud. Revisa tu conexión o escríbenos por WhatsApp.';
      status.classList.add('ctt-form-status-error');
      status.hidden = false;
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Solicitar Valoración Gratuita';
    }
  });
</script>

