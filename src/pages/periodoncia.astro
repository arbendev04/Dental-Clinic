---
import Layout from '../layouts/Layout.astro';
import RelatedArticles from '../components/blog/RelatedArticles.astro';

const WHATSAPP_PHONE = '34665886439';
const whatsappHref = (texto: string) =>
  `https://api.whatsapp.com/send?phone=${WHATSAPP_PHONE}&text=${encodeURIComponent(texto)}`;

const pasos = [
  {
    titulo: 'Valoración periodontal y sondaje de encías',
    descripcion: 'Medimos la profundidad de las encías alrededor de cada diente y revisamos si hay sangrado, inflamación o pérdida de hueso.',
  },
  {
    titulo: 'Limpieza profunda (raspado y alisado radicular)',
    descripcion: 'Eliminamos la placa y el sarro acumulados por debajo de la línea de la encía, alisando la raíz para que la encía pueda volver a adherirse al diente.',
  },
  {
    titulo: 'Control de la inflamación y la infección',
    descripcion: 'Revisamos la evolución de la encía tras la limpieza profunda y valoramos si hace falta algún tratamiento adicional para controlar la infección.',
  },
  {
    titulo: 'Revisiones de mantenimiento periodontal',
    descripcion: 'Programamos revisiones periódicas para comprobar que la encía se mantiene sana y detectar cualquier recaída a tiempo.',
  },
  {
    titulo: 'Cirugía periodontal, si es necesaria',
    descripcion: 'En casos más avanzados, valoramos si hace falta un tratamiento quirúrgico para acceder a zonas más profundas o regenerar el tejido perdido.',
  },
];

const faqs = [
  {
    pregunta: '¿Por qué me sangran las encías al cepillarme?',
    respuesta: 'El sangrado al cepillarte suele ser el primer signo de gingivitis, una inflamación de la encía causada por la acumulación de placa bacteriana. Si se trata a tiempo, es reversible con una buena limpieza e higiene diaria.',
  },
  {
    pregunta: '¿Qué es la periodontitis?',
    respuesta: 'La periodontitis es una fase más avanzada de la enfermedad de las encías, en la que la infección afecta también al hueso que sostiene el diente. Si no se trata, puede provocar que los dientes se muevan o incluso se pierdan.',
  },
  {
    pregunta: '¿Se puede curar la enfermedad de las encías?',
    respuesta: 'La gingivitis, en su fase inicial, suele revertirse con limpieza profesional y buena higiene diaria. La periodontitis no se "cura" del todo una vez que hay pérdida de hueso, pero sí se puede controlar y detener su avance con tratamiento y mantenimiento periódico.',
  },
  {
    pregunta: '¿Duele el tratamiento periodontal?',
    respuesta: 'La limpieza profunda se realiza con anestesia local cuando es necesario, por lo que no debería doler durante el procedimiento. Es normal notar cierta sensibilidad en la encía los días posteriores.',
  },
  {
    pregunta: '¿Con qué frecuencia debo hacer mantenimiento periodontal?',
    respuesta: 'Depende de cómo evolucione tu caso, pero en general se recomienda una revisión cada tres a seis meses cuando ya has tenido enfermedad periodontal, frente a la revisión anual habitual de un paciente sin antecedentes.',
  },
  {
    pregunta: '¿La periodontitis afecta a los implantes dentales?',
    respuesta: 'Sí. Si las encías no están sanas antes de colocar un implante, aumenta el riesgo de que también se infecte el tejido alrededor del implante. Por eso, si tienes antecedentes de periodontitis, tratamos primero la encía antes de valorar cualquier implante.',
  },
  {
    pregunta: '¿Cuánto cuesta un tratamiento de periodoncia?',
    respuesta: 'El precio depende de la fase de la enfermedad y del número de sesiones de limpieza profunda que necesites. Te damos una cifra concreta después de la valoración inicial, que es gratuita.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.pregunta,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.respuesta,
    },
  })),
};

// Sin `@id` al Dentist todavía (pendiente Tarea 9 del Plan SEO) — se declara
// la clínica en línea, igual que ya hace el schema ItemList de /servicios/.
const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Periodoncia",
  "url": "https://arangodentalclinic.es/periodoncia/",
  "procedureType": "https://schema.org/NoninvasiveProcedure",
  "bodyLocation": "Encías y tejido periodontal",
  "howPerformed": "Valoración con sondaje periodontal, limpieza profunda mediante raspado y alisado radicular, y revisiones de mantenimiento periódico para controlar la enfermedad de las encías.",
  "provider": {
    "@type": "Dentist",
    "name": "Arango Dental Clinic",
    "url": "https://arangodentalclinic.es",
  },
};
---

<Layout title="Periodoncia en Benidorm | Salud de tus Encías" description="Periodoncia en Benidorm para tratar el sangrado y la inflamación de encías. Valoración inicial sin coste y presupuesto personalizado. Pide cita hoy." image="/img/servicios/servicios.webp">
  <script type="application/ld+json" set:html={JSON.stringify(procedureSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- ── Hero ── -->
  <section class="trt-hero" data-scroll-hero>
    <img
      src="/img/servicios/servicios.webp"
      alt="Instrumental odontológico profesional en Arango Dental Clinic"
      class="trt-hero-img"
      width="1536"
      height="1024"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="trt-hero-overlay" aria-hidden="true"></div>
    <div class="trt-hero-inner">
      <div class="trt-hero-text">
        <p class="trt-label">Arango Dental Clinic</p>
        <h1 class="trt-hero-title">Periodoncia en Benidorm</h1>
        <p class="trt-hero-sub">
          Si tus encías sangran, están inflamadas o notas que se retraen con el tiempo, un tratamiento de periodoncia puede frenar el problema antes de que afecte a tus dientes. En Arango Dental Clinic evaluamos tus encías con una valoración inicial sin coste en Benidorm.
        </p>
        <div class="trt-hero-actions">
          <a href={whatsappHref('Hola, quiero pedir una valoración gratuita de periodoncia')} target="_blank" rel="noopener noreferrer" class="trt-btn trt-btn-solid-hero">Pide tu valoración sin coste</a>
        </div>
      </div>

      <!-- Mismo formulario y mismo endpoint que el hero del home
      (HeroScroll.astro → /api/lead) — clases propias con prefijo trt- para
      no depender de los estilos de ese componente. -->
      <div class="trt-hero-form-panel" id="trt-hero-form-panel">
        <p class="trt-hero-form-eyebrow">Valoración sin coste</p>
        <h2 class="trt-hero-form-title">Da el primer paso</h2>
        <form id="trt-lead-form" class="trt-hero-form" novalidate>
          <input type="text" id="trt-gotcha" name="_gotcha" class="trt-hero-form-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <input type="text" id="trt-nombre" name="nombre" class="trt-hero-form-input" placeholder="Nombre completo" required />
          <input type="tel" id="trt-telefono" name="telefono" class="trt-hero-form-input" placeholder="Teléfono" required />
          <input type="email" id="trt-email" name="email" class="trt-hero-form-input" placeholder="Email (opcional)" />
          <label class="trt-hero-form-consent">
            <input type="checkbox" id="trt-consentimiento" name="consentimiento" required />
            <span>Acepto la <a href="/politica-privacidad" target="_blank" rel="noopener">Política de Privacidad</a>.</span>
          </label>
          <button type="submit" id="trt-form-submit" class="trt-hero-form-submit">Enviar</button>
        </form>
        <p id="trt-form-status" class="trt-hero-form-status" role="status" aria-live="polite" hidden></p>
      </div>
    </div>
  </section>

  <!-- ── Contenido ── -->
  <section class="trt-content-section">
    <div class="trt-container trt-prose">

      <h2>¿Qué es la periodoncia y cuándo se necesita?</h2>
      <p>
        La periodoncia es la parte de la odontología que se ocupa de la salud de las encías y del tejido que sostiene los dientes: el hueso y las fibras que los mantienen fijos en su sitio. Cuando ese tejido se inflama o se infecta, hablamos de enfermedad periodontal.
      </p>
      <p>
        Tiene dos fases principales. La gingivitis es la más leve: la encía se inflama y puede sangrar, pero el hueso todavía no se ha visto afectado. Si no se trata, puede evolucionar a periodontitis, donde la infección llega también al hueso que sujeta el diente y puede hacer que este se mueva con el tiempo.
      </p>
      <p>
        Se recomienda valorar tus encías cuando notas sangrado al cepillarte o al usar hilo dental, inflamación o enrojecimiento, mal aliento persistente, encías que se retraen dejando el diente más largo, o movilidad en alguna pieza. Cuanto antes se detecte, más fácil es controlarlo.
      </p>
      <p>
        La periodoncia no sustituye a la higiene diaria: la limpieza en casa y las revisiones profesionales trabajan juntas. Una buena rutina de cepillado e hilo dental reduce mucho el riesgo de que la enfermedad periodontal aparezca o vuelva a aparecer.
      </p>

      <div class="trt-inline-actions">
        <a href="#trt-hero-form-panel" class="trt-btn trt-btn-outline">Ir al formulario</a>
        <a href={whatsappHref('Hola, quiero pedir una valoración gratuita de periodoncia')} target="_blank" rel="noopener noreferrer" class="trt-btn trt-btn-solid">Escríbenos por WhatsApp</a>
      </div>

      <h2>Cómo lo hacemos en Arango Dental Clinic</h2>
      <p>
        Empezamos con un sondaje periodontal que mide la profundidad de la encía alrededor de cada diente, en Benidorm, para saber exactamente en qué fase está la enfermedad antes de proponerte un tratamiento.
      </p>
      <p>
        El tratamiento base es una limpieza profunda por debajo de la línea de la encía, conocida como raspado y alisado radicular, que elimina la placa y el sarro que la higiene diaria no alcanza a limpiar.
        <!-- PENDIENTE CLÍNICA: protocolo o técnica concreta de mantenimiento periodontal que utiliza la clínica -->
        Después evaluamos cómo responde la encía y decidimos junto contigo si hacen falta sesiones adicionales o revisiones de mantenimiento más frecuentes.
      </p>
      <p>
        En los casos más avanzados, donde ya hay pérdida de hueso importante, valoramos si es necesaria una intervención periodontal más específica para poder acceder a zonas más profundas.
      </p>

      <h2>El proceso, paso a paso</h2>
      <div class="trt-steps" id="trt-steps">
        {pasos.map((paso, i) => (
          <details class="trt-step-card" data-step={i} open={i === 0}>
            <summary class="trt-step-card-summary">
              <span class="trt-step-card-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="trt-step-card-title">{paso.titulo}</span>
            </summary>
            <p class="trt-step-card-desc">{paso.descripcion}</p>
            <span class="trt-step-card-progress" aria-hidden="true">
              <span class="trt-step-card-progress-bar"></span>
            </span>
          </details>
        ))}
      </div>

      <h2>Precio</h2>
      <p>
        El precio de un tratamiento periodontal depende de la fase de la enfermedad y del número de sesiones de limpieza profunda o revisiones que necesites. Por eso no damos una cifra cerrada sin antes valorar tu caso en persona.
      </p>
      <!-- PENDIENTE CLÍNICA: tarifas orientativas de periodoncia; enlazar a /precios/ cuando esa página exista -->
      <p>
        Preferimos ser claros sobre esto: cualquier cifra que veas antes de una valoración presencial es solo orientativa. En tu valoración inicial, que es gratuita y sin compromiso, hacemos el sondaje periodontal y te damos el presupuesto real, para que sepas exactamente qué necesitas, qué vas a pagar y por qué.
      </p>

      <h2>Preguntas frecuentes</h2>
      <div class="trt-faq-list">
        {faqs.map((faq) => (
          <details class="trt-faq-item">
            <summary class="trt-faq-question">{faq.pregunta}</summary>
            <p class="trt-faq-answer">{faq.respuesta}</p>
          </details>
        ))}
      </div>

      <h2>Pide tu valoración sin coste</h2>
      <p>
        La primera consulta es gratuita y sin compromiso. Evaluamos el estado de tus encías con un sondaje periodontal y te explicamos el plan de tratamiento más adecuado antes de que decidas nada. Atendemos en Benidorm y su comarca — La Nucía, Alfaz del Pi, Finestrat, Villajoyosa, Altea y Polop — y también recibimos pacientes de otros puntos de la provincia de Alicante.
      </p>
      <p>
        Puedes escribirnos por WhatsApp, llamarnos por teléfono o acercarte directamente a la clínica en Avinguda Alfonso Puchades. Te atendemos en español, inglés y francés, y respondemos por WhatsApp en menos de 24 horas.
      </p>
      <p>
        Consulta también nuestros <a href="/servicios/">demás servicios dentales</a> si además de la periodoncia quieres resolver otras necesidades de tu sonrisa.
      </p>

    </div>
  </section>

  <RelatedArticles lang="es" service="periodoncia" />

  <!-- ── CTA final ── -->
  <section class="trt-cta-section">
    <div class="trt-container trt-cta-inner">
      <h2 class="trt-cta-title">Arango Dental Clinic, tu clínica de periodoncia en Benidorm</h2>
      <p class="trt-cta-sub">Avinguda Alfonso Puchades, 22, bajo, Benidorm, Alicante 03501</p>
      <div class="trt-cta-actions">
        <a href="tel:+34965088282" class="trt-btn trt-btn-outline">Llamar: 965 08 82 82</a>
        <a href={whatsappHref('Hola, quiero pedir una valoración gratuita de periodoncia')} target="_blank" rel="noopener noreferrer" class="trt-btn trt-btn-solid">Escríbenos por WhatsApp</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── Layout ── */
  .trt-container {
    max-width: 1200px;
    margin: 0 auto;
    padding-left: 2rem;
    padding-right: 2rem;
  }

  /* ── Hero ── */
  .trt-hero {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: #0d2219;
    text-align: center;
  }

  :global(html.dark) .trt-hero {
    background-color: #0d2219;
  }

  .trt-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    display: block;
  }

  .trt-hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(6, 18, 10, 0.72) 0%,
        rgba(6, 18, 10, 0.48) 50%,
        rgba(6, 18, 10, 0.72) 100%
      );
  }

  :global(html.dark) .trt-hero-overlay {
    background:
      linear-gradient(
        180deg,
        rgba(4, 12, 7, 0.82) 0%,
        rgba(4, 12, 7, 0.55) 50%,
        rgba(4, 12, 7, 0.82) 100%
      );
  }

  /* Ya no usa .trt-container: el hero es full-bleed (como el del home),
     con su propio padding lateral — así el 35% del formulario se calcula
     sobre el ancho real de la pantalla, igual que en HeroScroll.astro,
     en vez de sobre el max-width:1200px que sí aplica al resto del
     contenido de la página. */
  .trt-hero-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
    padding: 7rem 2rem 4rem;
    box-sizing: border-box;
  }

  .trt-hero-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  /* Desktop: texto a la izquierda, formulario a la derecha — ya no
     centrado en una sola columna. */
  @media (min-width: 900px) {
    .trt-hero-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 3rem;
      text-align: left;
      padding-left: 6%;
      padding-right: 4%;
    }

    .trt-hero-text {
      align-items: flex-start;
      text-align: left;
      flex: 1 1 auto;
      max-width: 560px;
    }
  }

  .trt-label {
    font-family: "Inter", sans-serif;
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #C49B38;
  }

  :global(html.dark) .trt-label {
    color: #D4AF55;
  }

  .trt-hero-title {
    font-family: "Cormorant Garamond", serif;
    font-size: clamp(2.4rem, 5.5vw, 4rem);
    font-weight: 300;
    font-style: italic;
    line-height: 1.15;
    color: rgba(244, 240, 235, 0.95);
    margin: 0;
  }

  .trt-hero-sub {
    font-family: "Inter", sans-serif;
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(244, 240, 235, 0.65);
    max-width: 62ch;
    margin: 0;
  }

  .trt-hero-actions {
    margin-top: 0.5rem;
  }

  /* ── Formulario del hero — mismos campos y mismo endpoint que el hero
     del home (HeroScroll.astro), con el mismo tratamiento visual (panel
     semitransparente + blur ligero, campos con fondo propio opaco). Tonos
     ajustados al verde de esta página (#0d2219) en vez del de la home. */
  .trt-hero-form-panel {
    width: 100%;
    max-width: 380px;
    padding: 1.5rem 1.5rem 1.75rem;
    background-color: rgba(13, 34, 25, 0.45);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid rgba(244, 240, 235, 0.14);
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.3);
    text-align: left;
  }

  /* Mismo ancho relativo que el panel del hero del home: 35% del hero,
     no un ancho fijo — por eso también le sacamos el max-width. */
  @media (min-width: 900px) {
    .trt-hero-form-panel {
      /* 39% acá da el mismo ancho en px que el 35% del hero del home
         (~500px a 1440px de viewport) — la diferencia es porque este
         panel resta su propio padding/gap del cálculo (border-box) y el
         del home no, al ser position:absolute. Ajustado a ojo para que
         coincida en píxeles reales, no solo en el número del porcentaje. */
      flex: 0 0 39%;
      max-width: none;
      padding: 2.75rem 2.5rem;
    }
  }

  .trt-hero-form-eyebrow {
    font-family: "Inter", sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #C49B38;
    margin: 0 0 0.5rem;
  }

  :global(html.dark) .trt-hero-form-eyebrow {
    color: #D4AF55;
  }

  .trt-hero-form-title {
    font-family: "Cormorant Garamond", serif;
    font-size: 1.5rem;
    font-weight: 400;
    color: rgba(244, 240, 235, 0.95);
    margin: 0 0 1rem;
  }

  .trt-hero-form {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .trt-hero-form-honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .trt-hero-form-input {
    width: 100%;
    padding: 0.75rem 0.9rem;
    font-family: "Inter", sans-serif;
    font-size: 0.88rem;
    color: rgba(244, 240, 235, 0.95);
    background-color: #142720;
    border: 1px solid rgba(244, 240, 235, 0.2);
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .trt-hero-form-input::placeholder {
    color: rgba(244, 240, 235, 0.45);
  }

  .trt-hero-form-input:focus {
    outline: none;
    border-color: #D4AF55;
    background-color: #1b3229;
  }

  .trt-hero-form-consent {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    font-family: "Inter", sans-serif;
    font-size: 0.7rem;
    line-height: 1.4;
    color: rgba(244, 240, 235, 0.6);
    cursor: pointer;
  }

  .trt-hero-form-consent input {
    margin-top: 0.15rem;
    flex-shrink: 0;
  }

  .trt-hero-form-consent a {
    color: rgba(244, 240, 235, 0.85);
    text-decoration: underline;
  }

  .trt-hero-form-submit {
    margin-top: 0.2rem;
    padding: 0.8rem 1rem;
    font-family: "Inter", sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #0d2219;
    background-color: #C49B38;
    border: none;
    cursor: pointer;
    transition: background-color 0.25s ease;
  }

  .trt-hero-form-submit:hover:not(:disabled) {
    background-color: #D4AF55;
  }

  .trt-hero-form-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .trt-hero-form-status {
    font-family: "Inter", sans-serif;
    font-size: 0.8rem;
    margin-top: 0.8rem;
    color: rgba(244, 240, 235, 0.85);
  }

  .trt-hero-form-status-error {
    color: #e5a3a3;
  }

  /* ── Prose ── */
  .trt-content-section {
    background-color: var(--bg-primary);
    padding: 4.5rem 0 5rem;
  }

  .trt-prose {
    max-width: 760px;
  }

  .trt-prose h2 {
    font-family: "Cormorant Garamond", serif;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 500;
    color: var(--text-primary);
    margin: 3rem 0 1.1rem;
  }

  .trt-prose h2:first-of-type {
    margin-top: 0;
  }

  .trt-prose p {
    font-family: "Inter", sans-serif;
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--text-secondary);
    margin: 0 0 1.1rem;
  }

  .trt-prose a {
    color: var(--teal-600);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ── Pasos — cards interactivas con auto-avance (ver script al final del
     archivo). Cada paso es un <details> nativo (mismo elemento que el FAQ,
     más abajo) para tener foco/teclado/semántica gratis; el script decide
     cuál queda abierto y no depende de que el navegador maneje el acordeón
     por sí solo, porque necesitamos que se abra una sola card a la vez. ── */
  .trt-steps {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .trt-step-card {
    position: relative;
    overflow: hidden;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-primary);
