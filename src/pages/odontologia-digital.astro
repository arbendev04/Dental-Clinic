---
import Layout from '../layouts/Layout.astro';

const WHATSAPP_PHONE = '34665886439';
const whatsappHref = (texto: string) =>
  `https://api.whatsapp.com/send?phone=${WHATSAPP_PHONE}&text=${encodeURIComponent(texto)}`;

const pasos = [
  {
    titulo: 'Escaneo intraoral 3D',
    descripcion: 'Un escáner digital recorre tu boca y genera un modelo 3D exacto de tus dientes y encías, sin necesidad de moldes de silicona.',
  },
  {
    titulo: 'Diagnóstico digital',
    descripcion: 'Con el modelo 3D y, si hace falta, una radiografía digital, analizamos con detalle el estado de tus dientes, tus encías y tu mordida.',
  },
  {
    titulo: 'Plan de tratamiento digital',
    descripcion: 'A partir del diagnóstico, diseñamos el plan de tratamiento sobre el modelo digital, antes de tocar un solo diente.',
  },
  {
    titulo: 'Presentación del plan',
    descripcion: 'Te mostramos el plan y, cuando es posible, una simulación de cómo quedaría el resultado, para que decidas con toda la información.',
  },
  {
    titulo: 'Aplicación en el tratamiento elegido',
    descripcion: 'Esa misma información digital guía el tratamiento real, ya sea un implante, una ortodoncia, una carilla o cualquier otro servicio de la clínica.',
  },
];

const faqs = [
  {
    pregunta: '¿Qué es un escáner intraoral 3D?',
    respuesta: 'Es un dispositivo que recorre tu boca con una pequeña cámara y genera un modelo digital exacto de tus dientes y encías en pocos minutos, sin necesidad de los moldes de silicona tradicionales, que muchos pacientes encuentran incómodos.',
  },
  {
    pregunta: '¿El escáner 3D sustituye a la radiografía dental?',
    respuesta: 'No, son herramientas complementarias. El escáner 3D capta la forma exterior de tus dientes y encías; la radiografía digital muestra lo que hay por debajo: raíces, hueso y posibles infecciones internas. Usamos una u otra, o ambas, según lo que necesite tu diagnóstico.',
  },
  {
    pregunta: '¿Es incómodo el escaneo digital?',
    respuesta: 'No debería serlo. El escáner es una pieza de mano pequeña que se desliza suavemente por la boca, sin el sabor ni la sensación de los moldes de silicona tradicionales. La mayoría de los pacientes lo encuentra más cómodo y más rápido.',
  },
  {
    pregunta: '¿Para qué tratamientos se usa la odontología digital?',
    respuesta: 'Se usa como base de prácticamente todos nuestros tratamientos: implantes, ortodoncia, estética dental, rehabilitación oral y también en el diagnóstico general. Es la herramienta que nos permite planificar con precisión antes de intervenir.',
  },
  {
    pregunta: '¿La odontología digital reduce el número de visitas?',
    respuesta: 'En muchos casos sí, porque el diagnóstico y la planificación son más rápidos y precisos desde el principio, lo que reduce imprevistos durante el tratamiento. El número exacto de visitas sigue dependiendo del tratamiento y de cada caso.',
  },
  {
    pregunta: '¿La tecnología digital tiene un coste aparte?',
    respuesta: 'No cobramos el escáner 3D ni el diagnóstico digital como un servicio aparte: forman parte de la valoración inicial de cualquier tratamiento. El coste que ves reflejado es el del tratamiento en sí, no el de la herramienta que usamos para planificarlo.',
  },
  {
    pregunta: '¿Es segura la radiografía digital?',
    respuesta: 'Sí. La radiografía digital utiliza una dosis de radiación considerablemente menor que la radiografía tradicional, y solo se realiza cuando aporta información necesaria para tu diagnóstico.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.pregunta,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.respuesta,
    },
  })),
};

// Sin `@id` al Dentist todavía (pendiente Tarea 9 del Plan SEO) — se declara
// la clínica en línea, igual que ya hace el schema ItemList de /servicios/.
const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Odontología digital",
  "url": "https://arangodentalclinic.es/odontologia-digital/",
  "procedureType": "https://schema.org/NoninvasiveProcedure",
  "bodyLocation": "Boca (maxilar y mandíbula)",
  "howPerformed": "Escaneo intraoral 3D y radiografía digital para generar un modelo exacto de la boca del paciente, usado como base del diagnóstico y de la planificación de cualquier tratamiento posterior.",
  "provider": {
    "@type": "Dentist",
    "name": "Arango Dental Clinic",
    "url": "https://arangodentalclinic.es",
  },
};
---

<Layout title="Odontología Digital en Benidorm | Escáner 3D" description="Odontología digital en Benidorm: escáner intraoral 3D y diagnóstico digital de precisión. Valoración inicial sin coste. Pide cita hoy." image="/img/servicios/servicios.webp">
  <script type="application/ld+json" set:html={JSON.stringify(procedureSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- ── Hero ── -->
  <section class="trt-hero" data-scroll-hero>
    <img
      src="/img/servicios/servicios.webp"
      alt="Instrumental odontológico profesional en Arango Dental Clinic"
      class="trt-hero-img"
      width="1536"
      height="1024"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="trt-hero-overlay" aria-hidden="true"></div>
    <div class="trt-hero-inner">
      <div class="trt-hero-text">
        <p class="trt-label">Arango Dental Clinic</p>
        <h1 class="trt-hero-title">Odontología digital en Benidorm</h1>
        <p class="trt-hero-sub">
          El escáner intraoral 3D y el diagnóstico digital son la base de todos nuestros tratamientos: nos permiten ver con precisión el estado de tu boca antes de proponerte nada. En Arango Dental Clinic aplicamos esta tecnología en Benidorm, con una valoración inicial sin coste.
        </p>
        <div class="trt-hero-actions">
          <a href={whatsappHref('Hola, quiero pedir más información sobre odontología digital')} target="_blank" rel="noopener noreferrer" class="trt-btn trt-btn-solid-hero">Pide tu valoración sin coste</a>
        </div>
      </div>

      <!-- Mismo formulario y mismo endpoint que el hero del home
      (HeroScroll.astro → /api/lead) — clases propias con prefijo trt- para
      no depender de los estilos de ese componente. -->
      <div class="trt-hero-form-panel" id="trt-hero-form-panel">
        <p class="trt-hero-form-eyebrow">Valoración sin coste</p>
        <h2 class="trt-hero-form-title">Da el primer paso</h2>
        <form id="trt-lead-form" class="trt-hero-form" novalidate>
          <input type="text" id="trt-gotcha" name="_gotcha" class="trt-hero-form-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <input type="text" id="trt-nombre" name="nombre" class="trt-hero-form-input" placeholder="Nombre completo" required />
          <input type="tel" id="trt-telefono" name="telefono" class="trt-hero-form-input" placeholder="Teléfono" required />
          <input type="email" id="trt-email" name="email" class="trt-hero-form-input" placeholder="Email (opcional)" />
          <label class="trt-hero-form-consent">
            <input type="checkbox" id="trt-consentimiento" name="consentimiento" required />
            <span>Acepto la <a href="/politica-privacidad" target="_blank" rel="noopener">Política de Privacidad</a>.</span>
          </label>
          <button type="submit" id="trt-form-submit" class="trt-hero-form-submit">Enviar</button>
        </form>
        <p id="trt-form-status" class="trt-hero-form-status" role="status" aria-live="polite" hidden></p>
      </div>
    </div>
  </section>

  <!-- ── Contenido ── -->
  <section class="trt-content-section">
    <div class="trt-container trt-prose">

      <h2>¿Qué es la odontología digital y cuándo se necesita?</h2>
      <p>
        La odontología digital es el conjunto de herramientas que nos permiten ver, medir y planificar tu boca con precisión antes de empezar cualquier tratamiento: principalmente el escáner intraoral 3D y la radiografía digital.
      </p>
      <p>
        El escáner intraoral genera un modelo tridimensional exacto de tus dientes y encías en pocos minutos, sin necesidad de los moldes de silicona tradicionales. La radiografía digital, por su parte, muestra lo que no se ve a simple vista: raíces, hueso y posibles infecciones internas, con una dosis de radiación menor que la radiografía convencional.
      </p>
      <p>
        No es un tratamiento en sí mismo, sino la base de todos los demás: se usa en la primera valoración de un implante, en la planificación de una ortodoncia, en el diseño de una sonrisa antes de colocar carillas, o en cualquier diagnóstico que requiera precisión.
      </p>
      <p>
        Se recomienda siempre que quieras empezar cualquier tratamiento dental con información real y objetiva de tu boca, en lugar de una estimación visual. Cuanto más preciso es el diagnóstico inicial, más predecible es el resultado final.
      </p>

      <div class="trt-inline-actions">
        <a href="#trt-hero-form-panel" class="trt-btn trt-btn-outline">Ir al formulario</a>
        <a href={whatsappHref('Hola, quiero pedir más información sobre odontología digital')} target="_blank" rel="noopener noreferrer" class="trt-btn trt-btn-solid">Escríbenos por WhatsApp</a>
      </div>

      <h2>Cómo lo hacemos en Arango Dental Clinic</h2>
      <p>
        En Benidorm, cada valoración inicial en Arango Dental Clinic empieza con un escáner intraoral 3D, sea cual sea el tratamiento que estés considerando. Ese modelo digital nos permite explicarte con claridad qué vemos en tu boca, en lugar de describirlo solo de palabra.
      </p>
      <p>
        Cuando el caso lo requiere, complementamos el escáner con una radiografía digital para ver el estado de las raíces y el hueso.
        <!-- PENDIENTE CLÍNICA: marca y modelo concretos del escáner intraoral y del sistema de radiografía digital que utiliza la clínica -->
        Con toda esa información diseñamos el plan de tratamiento antes de tocar un solo diente, y te lo explicamos con calma para que entiendas cada paso.
      </p>
      <p>
        Esta misma tecnología es la que ya usamos como base de nuestra página de <a href="/implantes/">implantes dentales</a> y del resto de tratamientos de la clínica: no es una herramienta aislada, sino el punto de partida de todo lo que hacemos.
      </p>

      <h2>El proceso, paso a paso</h2>
      <div class="trt-steps" id="trt-steps">
        {pasos.map((paso, i) => (
          <details class="trt-step-card" data-step={i} open={i === 0}>
            <summary class="trt-step-card-summary">
              <span class="trt-step-card-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="trt-step-card-title">{paso.titulo}</span>
            </summary>
            <p class="trt-step-card-desc">{paso.descripcion}</p>
            <span class="trt-step-card-progress" aria-hidden="true">
              <span class="trt-step-card-progress-bar"></span>
            </span>
          </details>
        ))}
      </div>

      <h2>Precio</h2>
      <p>
        No cobramos el escáner 3D ni el diagnóstico digital como un servicio aparte: forman parte de la valoración inicial de cualquier tratamiento, que es gratuita. El coste que verás reflejado corresponde al tratamiento que decidas hacer después de esa valoración, no a la tecnología en sí.
      </p>
      <!-- PENDIENTE CLÍNICA: enlazar a /precios/ cuando esa página exista, con las tarifas orientativas de cada tratamiento -->
      <p>
        Preferimos ser claros sobre esto: el presupuesto de cualquier tratamiento se cierra después de ver tu escáner 3D o tu radiografía digital, y de decidir juntos el plan a seguir, en tu valoración inicial gratuita y sin compromiso, para que sepas exactamente qué necesitas, qué vas a pagar y por qué.
      </p>

      <h2>Preguntas frecuentes</h2>
      <div class="trt-faq-list">
        {faqs.map((faq) => (
          <details class="trt-faq-item">
            <summary class="trt-faq-question">{faq.pregunta}</summary>
            <p class="trt-faq-answer">{faq.respuesta}</p>
          </details>
        ))}
      </div>

      <h2>Pide tu valoración sin coste</h2>
      <p>
        La primera consulta es gratuita y sin compromiso. Empezamos con un escáner intraoral 3D y, si hace falta, una radiografía digital, para darte un diagnóstico preciso antes de que decidas nada. Atendemos en Benidorm y su comarca — La Nucía, Alfaz del Pi, Finestrat, Villajoyosa, Altea y Polop — y también recibimos pacientes de otros puntos de la provincia de Alicante.
      </p>
      <p>
        Puedes escribirnos por WhatsApp, llamarnos por teléfono o acercarte directamente a la clínica en Avinguda Alfonso Puchades. Te atendemos en español, inglés y francés, y respondemos por WhatsApp en menos de 24 horas.
      </p>
      <p>
        Consulta también nuestros <a href="/servicios/">demás servicios dentales</a> para ver en qué tratamientos concretos aplicamos esta tecnología.
      </p>

    </div>
  </section>

  <!-- ── CTA final ── -->
  <section class="trt-cta-section">
    <div class="trt-container trt-cta-inner">
      <h2 class="trt-cta-title">Arango Dental Clinic, odontología digital en Benidorm</h2>
      <p class="trt-cta-sub">Avinguda Alfonso Puchades, 22, bajo, Benidorm, Alicante 03501</p>
      <div class="trt-cta-actions">
        <a href="tel:+34965088282" class="trt-btn trt-btn-outline">Llamar: 965 08 82 82</a>
        <a href={whatsappHref('Hola, quiero pedir más información sobre odontología digital')} target="_blank" rel="noopener noreferrer" class="trt-btn trt-btn-solid">Escríbenos por WhatsApp</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── Layout ── */
  .trt-container {
    max-width: 1200px;
    margin: 0 auto;
    padding-left: 2rem;
    padding-right: 2rem;
  }

  /* ── Hero ── */
  .trt-hero {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: #0d2219;
    text-align: center;
  }

  :global(html.dark) .trt-hero {
    background-color: #0d2219;
  }

  .trt-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    display: block;
  }

  .trt-hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(6, 18, 10, 0.72) 0%,
        rgba(6, 18, 10, 0.48) 50%,
        rgba(6, 18, 10, 0.72) 100%
      );
  }

  :global(html.dark) .trt-hero-overlay {
    background:
      linear-gradient(
        180deg,
        rgba(4, 12, 7, 0.82) 0%,
        rgba(4, 12, 7, 0.55) 50%,
        rgba(4, 12, 7, 0.82) 100%
      );
  }

  /* Ya no usa .trt-container: el hero es full-bleed (como el del home),
     con su propio padding lateral — así el 35% del formulario se calcula
     sobre el ancho real de la pantalla, igual que en HeroScroll.astro,
     en vez de sobre el max-width:1200px que sí aplica al resto del
     contenido de la página. */
  .trt-hero-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
    padding: 7rem 2rem 4rem;
    box-sizing: border-box;
  }

  .trt-hero-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  /* Desktop: texto a la izquierda, formulario a la derecha — ya no
     centrado en una sola columna. */
  @media (min-width: 900px) {
    .trt-hero-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 3rem;
      text-align: left;
      padding-left: 6%;
      padding-right: 4%;
    }

    .trt-hero-text {
      align-items: flex-start;
      text-align: left;
      flex: 1 1 auto;
      max-width: 560px;
    }
  }

  .trt-label {
    font-family: "Inter", sans-serif;
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #C49B38;
  }

  :global(html.dark) .trt-label {
    color: #D4AF55;
  }

  .trt-hero-title {
    font-family: "Cormorant Garamond", serif;
    font-size: clamp(2.4rem, 5.5vw, 4rem);
    font-weight: 300;
    font-style: italic;
    line-height: 1.15;
    color: rgba(244, 240, 235, 0.95);
    margin: 0;
  }

  .trt-hero-sub {
    font-family: "Inter", sans-serif;
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(244, 240, 235, 0.65);
    max-width: 62ch;
    margin: 0;
  }

  .trt-hero-actions {
    margin-top: 0.5rem;
  }

  /* ── Formulario del hero — mismos campos y mismo endpoint que el hero
     del home (HeroScroll.astro), con el mismo tratamiento visual (panel
     semitransparente + blur ligero, campos con fondo propio opaco). Tonos
     ajustados al verde de esta página (#0d2219) en vez del de la home. */
  .trt-hero-form-panel {
    width: 100%;
    max-width: 380px;
    padding: 1.5rem 1.5rem 1.75rem;
    background-color: rgba(13, 34, 25, 0.45);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid rgba(244, 240, 235, 0.14);
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.3);
    text-align: left;
  }

  /* Mismo ancho relativo que el panel del hero del home: 35% del hero,
     no un ancho fijo — por eso también le sacamos el max-width. */
  @media (min-width: 900px) {
    .trt-hero-form-panel {
      /* 39% acá da el mismo ancho en px que el 35% del hero del home
         (~500px a 1440px de viewport) — la diferencia es porque este
         panel resta su propio padding/gap del cálculo (border-box) y el
         del home no, al ser position:absolute. Ajustado a ojo para que
         coincida en píxeles reales, no solo en el número del porcentaje. */
      flex: 0 0 39%;
      max-width: none;
      padding: 2.75rem 2.5rem;
    }
  }

  .trt-hero-form-eyebrow {
    font-family: "Inter", sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #C49B38;
    margin: 0 0 0.5rem;
  }

  :global(html.dark) .trt-hero-form-eyebrow {
    color: #D4AF55;
  }

  .trt-hero-form-title {
    font-family: "Cormorant Garamond", serif;
    font-size: 1.5rem;
    font-weight: 400;
    color: rgba(244, 240, 235, 0.95);
    margin: 0 0 1rem;
  }

  .trt-hero-form {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .trt-hero-form-honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .trt-hero-form-input {
    width: 100%;
    padding: 0.75rem 0.9rem;
    font-family: "Inter", sans-serif;
    font-size: 0.88rem;
    color: rgba(244, 240, 235, 0.95);
    background-color: #142720;
    border: 1px solid rgba(244, 240, 235, 0.2);
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .trt-hero-form-input::placeholder {
    color: rgba(244, 240, 235, 0.45);
  }

  .trt-hero-form-input:focus {
    outline: none;
    border-color: #D4AF55;
    background-color: #1b3229;
  }

  .trt-hero-form-consent {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    font-family: "Inter", sans-serif;
    font-size: 0.7rem;
    line-height: 1.4;
    color: rgba(244, 240, 235, 0.6);
    cursor: pointer;
  }

  .trt-hero-form-consent input {
    margin-top: 0.15rem;
    flex-shrink: 0;
  }

  .trt-hero-form-consent a {
    color: rgba(244, 240, 235, 0.85);
    text-decoration: underline;
  }

  .trt-hero-form-submit {
    margin-top: 0.2rem;
    padding: 0.8rem 1rem;
    font-family: "Inter", sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #0d2219;
    background-color: #C49B38;
    border: none;
    cursor: pointer;
    transition: background-color 0.25s ease;
  }

  .trt-hero-form-submit:hover:not(:disabled) {
    background-color: #D4AF55;
  }

  .trt-hero-form-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .trt-hero-form-status {
    font-family: "Inter", sans-serif;
    font-size: 0.8rem;
    margin-top: 0.8rem;
    color: rgba(244, 240, 235, 0.85);
  }

  .trt-hero-form-status-error {
    color: #e5a3a3;
  }

  /* ── Prose ── */
  .trt-content-section {
    background-color: var(--bg-primary);
    padding: 4.5rem 0 5rem;
  }

  .trt-prose {
    max-width: 760px;
  }

  .trt-prose h2 {
    font-family: "Cormorant Garamond", serif;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 500;
    color: var(--text-primary);
    margin: 3rem 0 1.1rem;
  }

  .trt-prose h2:first-of-type {
    margin-top: 0;
  }

  .trt-prose p {
    font-family: "Inter", sans-serif;
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--text-secondary);
    margin: 0 0 1.1rem;
  }

  .trt-prose a {
    color: var(--teal-600);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ── Pasos — cards interactivas con auto-avance (ver script al final del
     archivo). Cada paso es un <details> nativo (mismo elemento que el FAQ,
     más abajo) para tener foco/teclado/semántica gratis; el script decide
     cuál queda abierto y no depende de que el navegador maneje el acordeón
     por sí solo, porque necesitamos que se abra una sola card a la vez. ── */
  .trt-steps {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .trt-step-card {
    position: relative;
    overflow: hidden;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-primary);
    border-left: 3px solid var(--border-primary);
    padding: 1.1rem 1.35rem;
