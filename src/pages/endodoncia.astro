---
import Layout from '../layouts/Layout.astro';

const WHATSAPP_PHONE = '34665886439';
const whatsappHref = (texto: string) =>
  `https://api.whatsapp.com/send?phone=${WHATSAPP_PHONE}&text=${encodeURIComponent(texto)}`;

const pasos = [
  {
    titulo: 'Valoración y radiografía digital',
    descripcion: 'Evaluamos el diente afectado con una radiografía digital para confirmar el alcance de la infección o el daño interno antes de proponer el tratamiento.',
  },
  {
    titulo: 'Anestesia local y apertura de la pieza',
    descripcion: 'Con anestesia local, se abre una pequeña vía de acceso hasta la cámara pulpar del diente para poder trabajar sobre el interior de la pieza.',
  },
  {
    titulo: 'Limpieza y desinfección de los conductos',
    descripcion: 'Se elimina el tejido dañado o infectado del interior del diente y se desinfectan los conductos radiculares con instrumental específico.',
  },
  {
    titulo: 'Sellado del conducto',
    descripcion: 'Una vez limpio y desinfectado, el conducto se rellena y se sella para evitar que vuelva a infectarse.',
  },
  {
    titulo: 'Restauración final del diente',
    descripcion: 'Se restaura la pieza con un empaste o, si ha perdido mucha estructura, con una corona que la protege y le devuelve su función.',
  },
];

const faqs = [
  {
    pregunta: '¿Duele una endodoncia?',
    respuesta: 'El tratamiento se realiza con anestesia local, por lo que no deberías sentir dolor durante la intervención. De hecho, la endodoncia suele aliviar el dolor que ya tenías por la infección, más que causarlo. Es normal notar cierta molestia leve los días posteriores.',
  },
  {
    pregunta: '¿Cuánto dura el tratamiento de conducto?',
    respuesta: 'Depende de la complejidad del diente y del número de conductos que tenga. En muchos casos se completa en una sola cita, aunque algunos casos requieren una segunda visita para asegurar una desinfección completa.',
  },
  {
    pregunta: '¿Se puede salvar un diente con una caries muy profunda?',
    respuesta: 'En muchos casos sí. Si la caries ha llegado hasta el nervio pero la raíz sigue en buen estado, la endodoncia permite eliminar el tejido dañado y conservar el diente en su sitio, en lugar de extraerlo.',
  },
  {
    pregunta: '¿Qué pasa si no me hago la endodoncia?',
    respuesta: 'Si el nervio del diente está dañado o infectado y no se trata, la infección puede extenderse al hueso de alrededor, provocar más dolor y, en muchos casos, terminar en la pérdida de la pieza. Cuanto antes se valore, más opciones hay de conservar el diente.',
  },
  {
    pregunta: '¿Necesito una corona después de la endodoncia?',
    respuesta: 'No siempre, pero es habitual, sobre todo en dientes posteriores que reciben más fuerza al masticar. Un diente tratado con endodoncia queda más frágil que uno sano, y una corona ayuda a protegerlo de fracturas a largo plazo. Lo valoramos según cada caso.',
  },
  {
    pregunta: '¿Cuánto cuesta una endodoncia?',
    respuesta: 'El precio depende del diente afectado y del número de conductos que tenga, entre otros factores. Te damos una cifra concreta después de la valoración inicial con radiografía digital, que es gratuita.',
  },
  {
    pregunta: '¿Cuánto dura un diente después de una endodoncia?',
    respuesta: 'Con una buena restauración final y revisiones periódicas, un diente tratado con endodoncia puede durar muchos años, en muchos casos toda la vida. La clave está en protegerlo bien después del tratamiento y mantener una buena higiene.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.pregunta,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.respuesta,
    },
  })),
};

// Sin `@id` al Dentist todavía (pendiente Tarea 9 del Plan SEO) — se declara
// la clínica en línea, igual que ya hace el schema ItemList de /servicios/.
const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Endodoncia",
  "url": "https://arangodentalclinic.es/endodoncia/",
  "procedureType": "https://schema.org/NoninvasiveProcedure",
  "bodyLocation": "Diente afectado (conducto radicular)",
  "howPerformed": "Diagnóstico con radiografía digital, limpieza y desinfección de los conductos radiculares con anestesia local, sellado del conducto y restauración final de la pieza con empaste o corona.",
  "provider": {
    "@type": "Dentist",
    "name": "Arango Dental Clinic",
    "url": "https://arangodentalclinic.es",
  },
};
---

<Layout title="Endodoncia en Benidorm | Tratamiento de Conducto" description="Endodoncia en Benidorm para salvar tu diente con tratamiento de conducto. Diagnóstico digital y valoración inicial sin coste. Pide cita hoy." image="/img/servicios/servicios.webp">
  <script type="application/ld+json" set:html={JSON.stringify(procedureSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- ── Hero ── -->
  <section class="trt-hero" data-scroll-hero>
    <img
      src="/img/servicios/servicios.webp"
      alt="Instrumental odontológico profesional en Arango Dental Clinic"
      class="trt-hero-img"
      width="1536"
      height="1024"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="trt-hero-overlay" aria-hidden="true"></div>
    <div class="trt-hero-inner">
      <div class="trt-hero-text">
        <p class="trt-label">Arango Dental Clinic</p>
        <h1 class="trt-hero-title">Endodoncia en Benidorm</h1>
        <p class="trt-hero-sub">
          Si tienes dolor persistente en un diente o una infección interna, una endodoncia puede salvar la pieza sin necesidad de extraerla. En Arango Dental Clinic diagnosticamos con radiografía digital y te ofrecemos una valoración inicial sin coste en Benidorm.
        </p>
        <div class="trt-hero-actions">
          <a href={whatsappHref('Hola, quiero pedir una valoración gratuita de endodoncia')} target="_blank" rel="noopener noreferrer" class="trt-btn trt-btn-solid-hero">Pide tu valoración sin coste</a>
        </div>
      </div>

      <!-- Mismo formulario y mismo endpoint que el hero del home
      (HeroScroll.astro → /api/lead) — clases propias con prefijo trt- para
      no depender de los estilos de ese componente. -->
      <div class="trt-hero-form-panel" id="trt-hero-form-panel">
        <p class="trt-hero-form-eyebrow">Valoración sin coste</p>
        <h2 class="trt-hero-form-title">Da el primer paso</h2>
        <form id="trt-lead-form" class="trt-hero-form" novalidate>
          <input type="text" id="trt-gotcha" name="_gotcha" class="trt-hero-form-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <input type="text" id="trt-nombre" name="nombre" class="trt-hero-form-input" placeholder="Nombre completo" required />
          <input type="tel" id="trt-telefono" name="telefono" class="trt-hero-form-input" placeholder="Teléfono" required />
          <input type="email" id="trt-email" name="email" class="trt-hero-form-input" placeholder="Email (opcional)" />
          <label class="trt-hero-form-consent">
            <input type="checkbox" id="trt-consentimiento" name="consentimiento" required />
            <span>Acepto la <a href="/politica-privacidad" target="_blank" rel="noopener">Política de Privacidad</a>.</span>
          </label>
          <button type="submit" id="trt-form-submit" class="trt-hero-form-submit">Enviar</button>
        </form>
        <p id="trt-form-status" class="trt-hero-form-status" role="status" aria-live="polite" hidden></p>
      </div>
    </div>
  </section>

  <!-- ── Contenido ── -->
  <section class="trt-content-section">
    <div class="trt-container trt-prose">

      <h2>¿Qué es la endodoncia y cuándo se necesita?</h2>
      <p>
        La endodoncia, conocida popularmente como "tratamiento de conducto", elimina el nervio y el tejido dañado o infectado del interior de un diente para poder conservar la pieza en su sitio, en lugar de extraerla.
      </p>
      <p>
        Cada diente tiene en su interior una cámara con nervio y vasos sanguíneos, llamada pulpa dental. Cuando una caries profunda, una fractura o un golpe llegan hasta esa pulpa, puede inflamarse o infectarse, y eso provoca dolor, sensibilidad al frío o al calor, o incluso hinchazón en la encía.
      </p>
      <p>
        Se recomienda cuando ese daño ya ha alcanzado el nervio y no se puede resolver con un simple empaste. La alternativa a la endodoncia suele ser la extracción del diente, así que siempre que la raíz esté en condiciones, intentamos conservar la pieza natural antes de recurrir a extraerla.
      </p>
      <p>
        Algunos síntomas habituales que llevan a valorar una endodoncia son el dolor espontáneo o al masticar, la sensibilidad prolongada al frío o al calor, el oscurecimiento de un diente concreto, o un flemón repetido en la misma zona. Ante cualquiera de ellos, conviene revisarlo cuanto antes.
      </p>

      <div class="trt-inline-actions">
        <a href="#trt-hero-form-panel" class="trt-btn trt-btn-outline">Ir al formulario</a>
        <a href={whatsappHref('Hola, quiero pedir una valoración gratuita de endodoncia')} target="_blank" rel="noopener noreferrer" class="trt-btn trt-btn-solid">Escríbenos por WhatsApp</a>
      </div>

      <h2>Cómo lo hacemos en Arango Dental Clinic</h2>
      <p>
        Empezamos con una radiografía digital que nos permite ver con claridad el estado de la raíz y del hueso alrededor del diente en Benidorm, antes de decidir si la endodoncia es la mejor opción para tu caso.
      </p>
      <p>
        El tratamiento se realiza con anestesia local y con instrumental específico para limpiar y desinfectar cada conducto del diente.
        <!-- PENDIENTE CLÍNICA: sistema o técnica concreta de endodoncia que utiliza la clínica -->
        Una vez desinfectado y sellado el conducto, valoramos junto contigo si el diente necesita una restauración simple o una corona para protegerlo a largo plazo.
      </p>
      <p>
        Durante los días posteriores es normal notar cierta sensibilidad al morder, que suele ir desapareciendo a medida que la zona se recupera. Te damos indicaciones concretas para esos primeros días.
      </p>

      <h2>El proceso, paso a paso</h2>
      <div class="trt-steps" id="trt-steps">
        {pasos.map((paso, i) => (
          <details class="trt-step-card" data-step={i} open={i === 0}>
            <summary class="trt-step-card-summary">
              <span class="trt-step-card-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="trt-step-card-title">{paso.titulo}</span>
            </summary>
            <p class="trt-step-card-desc">{paso.descripcion}</p>
            <span class="trt-step-card-progress" aria-hidden="true">
              <span class="trt-step-card-progress-bar"></span>
            </span>
          </details>
        ))}
      </div>

      <h2>Precio</h2>
      <p>
        El precio de una endodoncia depende del diente afectado, del número de conductos que tenga y de si es necesaria una restauración adicional después del tratamiento. Por eso no damos una cifra cerrada sin antes valorar tu caso en persona.
      </p>
      <!-- PENDIENTE CLÍNICA: tarifas orientativas de endodoncia; enlazar a /precios/ cuando esa página exista -->
      <p>
        Preferimos ser claros sobre esto: cualquier cifra que veas antes de una valoración presencial es solo orientativa. En tu valoración inicial, que es gratuita y sin compromiso, vemos tu radiografía y te damos el presupuesto real, para que sepas exactamente qué necesitas, qué vas a pagar y por qué.
      </p>

      <h2>Preguntas frecuentes</h2>
      <div class="trt-faq-list">
        {faqs.map((faq) => (
          <details class="trt-faq-item">
            <summary class="trt-faq-question">{faq.pregunta}</summary>
            <p class="trt-faq-answer">{faq.respuesta}</p>
          </details>
        ))}
      </div>

      <h2>Pide tu valoración sin coste</h2>
      <p>
        La primera consulta es gratuita y sin compromiso. Evaluamos tu diente con radiografía digital y te explicamos si la endodoncia es la mejor opción para tu caso antes de que decidas nada. Atendemos en Benidorm y su comarca — La Nucía, Alfaz del Pi, Finestrat, Villajoyosa, Altea y Polop — y también recibimos pacientes de otros puntos de la provincia de Alicante.
      </p>
      <p>
        Puedes escribirnos por WhatsApp, llamarnos por teléfono o acercarte directamente a la clínica en Avinguda Alfonso Puchades. Te atendemos en español, inglés y francés, y respondemos por WhatsApp en menos de 24 horas.
      </p>
      <p>
        Consulta también nuestros <a href="/servicios/">demás servicios dentales</a> si además de la endodoncia quieres resolver otras necesidades de tu sonrisa.
      </p>

    </div>
  </section>

  <!-- ── CTA final ── -->
  <section class="trt-cta-section">
    <div class="trt-container trt-cta-inner">
      <h2 class="trt-cta-title">Arango Dental Clinic, tu clínica de endodoncia en Benidorm</h2>
      <p class="trt-cta-sub">Avinguda Alfonso Puchades, 22, bajo, Benidorm, Alicante 03501</p>
      <div class="trt-cta-actions">
        <a href="tel:+34965088282" class="trt-btn trt-btn-outline">Llamar: 965 08 82 82</a>
        <a href={whatsappHref('Hola, quiero pedir una valoración gratuita de endodoncia')} target="_blank" rel="noopener noreferrer" class="trt-btn trt-btn-solid">Escríbenos por WhatsApp</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── Layout ── */
  .trt-container {
    max-width: 1200px;
    margin: 0 auto;
    padding-left: 2rem;
    padding-right: 2rem;
  }

  /* ── Hero ── */
  .trt-hero {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: #0d2219;
    text-align: center;
  }

  :global(html.dark) .trt-hero {
    background-color: #0d2219;
  }

  .trt-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    display: block;
  }

  .trt-hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(6, 18, 10, 0.72) 0%,
        rgba(6, 18, 10, 0.48) 50%,
        rgba(6, 18, 10, 0.72) 100%
      );
  }

  :global(html.dark) .trt-hero-overlay {
    background:
      linear-gradient(
        180deg,
        rgba(4, 12, 7, 0.82) 0%,
        rgba(4, 12, 7, 0.55) 50%,
        rgba(4, 12, 7, 0.82) 100%
      );
  }

  /* Ya no usa .trt-container: el hero es full-bleed (como el del home),
     con su propio padding lateral — así el 35% del formulario se calcula
     sobre el ancho real de la pantalla, igual que en HeroScroll.astro,
     en vez de sobre el max-width:1200px que sí aplica al resto del
     contenido de la página. */
  .trt-hero-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
    padding: 7rem 2rem 4rem;
    box-sizing: border-box;
  }

  .trt-hero-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  /* Desktop: texto a la izquierda, formulario a la derecha — ya no
     centrado en una sola columna. */
  @media (min-width: 900px) {
    .trt-hero-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 3rem;
      text-align: left;
      padding-left: 6%;
      padding-right: 4%;
    }

    .trt-hero-text {
      align-items: flex-start;
      text-align: left;
      flex: 1 1 auto;
      max-width: 560px;
    }
  }

  .trt-label {
    font-family: "Inter", sans-serif;
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #C49B38;
  }

  :global(html.dark) .trt-label {
    color: #D4AF55;
  }

  .trt-hero-title {
    font-family: "Cormorant Garamond", serif;
    font-size: clamp(2.4rem, 5.5vw, 4rem);
    font-weight: 300;
    font-style: italic;
    line-height: 1.15;
    color: rgba(244, 240, 235, 0.95);
    margin: 0;
  }

  .trt-hero-sub {
    font-family: "Inter", sans-serif;
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(244, 240, 235, 0.65);
    max-width: 62ch;
    margin: 0;
  }

  .trt-hero-actions {
    margin-top: 0.5rem;
  }

  /* ── Formulario del hero — mismos campos y mismo endpoint que el hero
     del home (HeroScroll.astro), con el mismo tratamiento visual (panel
     semitransparente + blur ligero, campos con fondo propio opaco). Tonos
     ajustados al verde de esta página (#0d2219) en vez del de la home. */
  .trt-hero-form-panel {
    width: 100%;
    max-width: 380px;
    padding: 1.5rem 1.5rem 1.75rem;
    background-color: rgba(13, 34, 25, 0.45);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid rgba(244, 240, 235, 0.14);
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.3);
    text-align: left;
  }

  /* Mismo ancho relativo que el panel del hero del home: 35% del hero,
     no un ancho fijo — por eso también le sacamos el max-width. */
  @media (min-width: 900px) {
    .trt-hero-form-panel {
      /* 39% acá da el mismo ancho en px que el 35% del hero del home
         (~500px a 1440px de viewport) — la diferencia es porque este
         panel resta su propio padding/gap del cálculo (border-box) y el
         del home no, al ser position:absolute. Ajustado a ojo para que
         coincida en píxeles reales, no solo en el número del porcentaje. */
      flex: 0 0 39%;
      max-width: none;
      padding: 2.75rem 2.5rem;
    }
  }

  .trt-hero-form-eyebrow {
    font-family: "Inter", sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #C49B38;
    margin: 0 0 0.5rem;
  }

  :global(html.dark) .trt-hero-form-eyebrow {
    color: #D4AF55;
  }

  .trt-hero-form-title {
    font-family: "Cormorant Garamond", serif;
    font-size: 1.5rem;
    font-weight: 400;
    color: rgba(244, 240, 235, 0.95);
    margin: 0 0 1rem;
  }

  .trt-hero-form {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .trt-hero-form-honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .trt-hero-form-input {
    width: 100%;
    padding: 0.75rem 0.9rem;
    font-family: "Inter", sans-serif;
    font-size: 0.88rem;
    color: rgba(244, 240, 235, 0.95);
    background-color: #142720;
    border: 1px solid rgba(244, 240, 235, 0.2);
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .trt-hero-form-input::placeholder {
    color: rgba(244, 240, 235, 0.45);
  }

  .trt-hero-form-input:focus {
    outline: none;
    border-color: #D4AF55;
    background-color: #1b3229;
  }

  .trt-hero-form-consent {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    font-family: "Inter", sans-serif;
    font-size: 0.7rem;
    line-height: 1.4;
    color: rgba(244, 240, 235, 0.6);
    cursor: pointer;
  }

  .trt-hero-form-consent input {
    margin-top: 0.15rem;
    flex-shrink: 0;
  }

  .trt-hero-form-consent a {
    color: rgba(244, 240, 235, 0.85);
    text-decoration: underline;
  }

  .trt-hero-form-submit {
    margin-top: 0.2rem;
    padding: 0.8rem 1rem;
    font-family: "Inter", sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #0d2219;
    background-color: #C49B38;
    border: none;
    cursor: pointer;
    transition: background-color 0.25s ease;
  }

  .trt-hero-form-submit:hover:not(:disabled) {
    background-color: #D4AF55;
  }

  .trt-hero-form-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .trt-hero-form-status {
    font-family: "Inter", sans-serif;
    font-size: 0.8rem;
    margin-top: 0.8rem;
    color: rgba(244, 240, 235, 0.85);
  }

  .trt-hero-form-status-error {
    color: #e5a3a3;
  }

  /* ── Prose ── */
  .trt-content-section {
    background-color: var(--bg-primary);
    padding: 4.5rem 0 5rem;
  }

  .trt-prose {
    max-width: 760px;
  }

  .trt-prose h2 {
    font-family: "Cormorant Garamond", serif;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 500;
    color: var(--text-primary);
    margin: 3rem 0 1.1rem;
  }

  .trt-prose h2:first-of-type {
    margin-top: 0;
  }

  .trt-prose p {
    font-family: "Inter", sans-serif;
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--text-secondary);
    margin: 0 0 1.1rem;
  }

  .trt-prose a {
    color: var(--teal-600);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ── Pasos — cards interactivas con auto-avance (ver script al final del
     archivo). Cada paso es un <details> nativo (mismo elemento que el FAQ,
     más abajo) para tener foco/teclado/semántica gratis; el script decide
     cuál queda abierto y no depende de que el navegador maneje el acordeón
     por sí solo, porque necesitamos que se abra una sola card a la vez. ── */
  .trt-steps {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .trt-step-card {
    position: relative;
    overflow: hidden;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-primary);
    border-left: 3px solid var(--border-primary);
    padding: 1.1rem 1.35rem;
    transition: border-color 0.3s ease, background-color 0.3s ease;
  }

  /* Activa (abierta) o en hover: mismo tratamiento — un tinte del color del
