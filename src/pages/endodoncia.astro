<!-- Cards de "El proceso, paso a paso" — se abren solas en secuencia cada
6s y se pueden abrir a mano en cualquier momento (clic reinicia el ciclo).
Solo corre mientras la sección está en pantalla (IntersectionObserver) y
se pausa con el mouse/foco encima; respeta prefers-reduced-motion
desactivando el auto-avance por completo (el usuario sigue pudiendo abrir
cada card a mano). -->
<script>
  const trtSteps = document.getElementById("trt-steps");
  const trtStepCards = Array.from(
    document.querySelectorAll<HTMLDetailsElement>(".trt-step-card")
  );

  if (trtSteps && trtStepCards.length > 1) {
    const STEP_DURATION_MS = 6000;
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let currentIndex = trtStepCards.findIndex((card) => card.open);
    if (currentIndex < 0) currentIndex = 0;
    let timerId: number | undefined;
    let isProgrammaticToggle = false;

    function playProgressBar(card: HTMLDetailsElement) {
      const bar = card.querySelector<HTMLElement>(".trt-step-card-progress-bar");
      if (!bar) return;
      bar.classList.remove("is-animating");
      // Fuerza reflow para poder reiniciar la animación desde 0% cada vez.
      void bar.offsetWidth;
      bar.style.setProperty("--trt-step-duration", `${STEP_DURATION_MS}ms`);
      bar.classList.add("is-animating");
    }

    function goToStep(index: number) {
      isProgrammaticToggle = true;
      trtStepCards.forEach((card, i) => {
        card.open = i === index;
      });
      isProgrammaticToggle = false;
      currentIndex = index;
      if (!prefersReducedMotion) playProgressBar(trtStepCards[index]);
    }

    function startAutoAdvance() {
      if (prefersReducedMotion) return;
      stopAutoAdvance();
      timerId = window.setInterval(() => {
        goToStep((currentIndex + 1) % trtStepCards.length);
      }, STEP_DURATION_MS);
    }

    function stopAutoAdvance() {
      if (timerId !== undefined) {
        window.clearInterval(timerId);
        timerId = undefined;
      }
    }

    trtStepCards.forEach((card, i) => {
      card.addEventListener("toggle", () => {
        if (isProgrammaticToggle || !card.open) return;
        // El usuario abrió esta card a mano: reinicia el ciclo desde acá.
        goToStep(i);
        startAutoAdvance();
      });
    });

    trtSteps.addEventListener("mouseenter", stopAutoAdvance);
    trtSteps.addEventListener("mouseleave", startAutoAdvance);
    trtSteps.addEventListener("focusin", stopAutoAdvance);
    trtSteps.addEventListener("focusout", startAutoAdvance);

    if (!prefersReducedMotion) playProgressBar(trtStepCards[currentIndex]);

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            startAutoAdvance();
          } else {
            stopAutoAdvance();
          }
        });
      },
      { threshold: 0.3 }
    );
    observer.observe(trtSteps);
  }
</script>

<!-- Envío del formulario del hero de esta landing — misma lógica y mismo
endpoint que el hero del home (HeroScroll.astro) y /contacto (api/lead.ts). -->
<script>
  const trtForm      = document.getElementById("trt-lead-form")   as HTMLFormElement | null;
  const trtSubmitBtn = document.getElementById("trt-form-submit") as HTMLButtonElement | null;
  const trtStatus    = document.getElementById("trt-form-status") as HTMLElement | null;

  trtForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!trtSubmitBtn || !trtStatus) return;

    trtSubmitBtn.disabled = true;
    trtSubmitBtn.textContent = "Enviando…";
    trtStatus.hidden = true;
    trtStatus.className = "trt-hero-form-status";

    const nombre = (document.getElementById("trt-nombre") as HTMLInputElement | null)?.value ?? "";
    const telefono = (document.getElementById("trt-telefono") as HTMLInputElement | null)?.value ?? "";
    const email = (document.getElementById("trt-email") as HTMLInputElement | null)?.value ?? "";
    const consentimiento = (document.getElementById("trt-consentimiento") as HTMLInputElement | null)?.checked ?? false;
    const _gotcha = (document.getElementById("trt-gotcha") as HTMLInputElement | null)?.value ?? "";

    try {
      const response = await fetch("/api/lead", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ nombre, telefono, email, consentimiento, _gotcha }),
      });

      const data = await response.json().catch(() => null);

      if (response.ok && data?.success) {
        trtForm.hidden = true;
        trtStatus.textContent = "¡Gracias! Te contactaremos pronto.";
        trtStatus.classList.add("trt-hero-form-status-success");
        trtStatus.hidden = false;

        // Mismo evento que el resto de los formularios del sitio — el
        // trigger de GTM "Formulario de contacto" escucha form_submit_success
        // sin importar form_name, así que este envío también cuenta como
        // conversión. form_name distinto solo para poder segmentar después.
        (window as any).dataLayer = (window as any).dataLayer || [];
        (window as any).dataLayer.push({ event: "form_submit_success", form_name: "endodoncia-landing" });
        return;
      }

      trtStatus.textContent = data?.error || "No hemos podido enviar tu solicitud. Escríbenos por WhatsApp.";
      trtStatus.classList.add("trt-hero-form-status-error");
      trtStatus.hidden = false;
    } catch {
      trtStatus.textContent = "No hemos podido enviar tu solicitud. Revisa tu conexión o escríbenos por WhatsApp.";
      trtStatus.classList.add("trt-hero-form-status-error");
      trtStatus.hidden = false;
    } finally {
      trtSubmitBtn.disabled = false;
      trtSubmitBtn.textContent = "Enviar";
    }
  });
</script>
